+
+void
+SweetHIDAccel::sample(IOFixed x, IOFixed y, IOFixed z, bool real)
+{
+	uint64_t now = mach_absolute_time();
+	if (real) {
+		fLastReal = now;
+	}
+	IOHIDEvent *event = IOHIDEvent::accelerometerEvent(now, x, y, z, 0, 0, fSeq++);
+	if (!event) {
+		return;
+	}
+	if (fLogged < 8 || (fSeq % 1000) == 0) {
+		fLogged++;
+		IOLog("SWEET HID: accel #%u %s %d %d %d mg (%u clients)\n", (unsigned)fSeq, real ? "real" : "synthetic",
+		    (int)(((int64_t)x * 1000) >> 16), (int)(((int64_t)y * 1000) >> 16), (int)(((int64_t)z * 1000) >> 16),
+		    _clients ? _clients->getCount() : 0);
+	}
+	dispatchEvent(event);
+	event->release();
+}
+
+void
+SweetHIDAccel::tick(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDAccel *self = (SweetHIDAccel *)owner;
+	uint64_t ns = 0;
+	self->fTicks++;
+	if (self->fTestSecs && (self->fTicks % (self->fTestSecs * 50)) == 0) {
+		self->shake();
+	}
+	if (self->fShake > 0) {
+		/* ~5 Hz side to side, +-2.5 g on x, ~1 s */
+		int n = 50 - self->fShake--;
+		IOFixed x = ((n / 5) & 1) ? -(5 << 15) : (5 << 15);
+		if (n == 0) {
+			IOLog("SWEET HID: synthetic shake\n");
+		}
+		self->sample(x, -(1 << 16), 0, false);
+	} else {
+		absolutetime_to_nanoseconds(mach_absolute_time() - self->fLastReal, &ns);
+		if ((self->fLastReal == 0 || ns > 500000000ull) && (self->fTicks % 5) == 0) {
+			self->sample(0, -(1 << 16), 0, false);
+		}
+	}
+	sender->setTimeoutMS(20);
+}
+
+extern "C" void
+sweet_hid_shake(void)
+{
+	if (gSweetAccel) {
+		gSweetAccel->shake();
+	}
+}
+
+/* One sample in milli-g on the iOS device axes (see SweetHIDAccel). */
+extern "C" void
+sweet_hid_accel(int x_mg, int y_mg, int z_mg)
+{
+	if (gSweetAccel) {
+		gSweetAccel->sample((IOFixed)(((int64_t)x_mg << 16) / 1000), (IOFixed)(((int64_t)y_mg << 16) / 1000),
+		    (IOFixed)(((int64_t)z_mg << 16) / 1000), true);
 	}
 }
