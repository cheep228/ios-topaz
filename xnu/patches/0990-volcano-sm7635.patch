+
+/* With extents: is [lba, lba + count) entirely inside one of them? */
+static bool
+ufs_in_extent(uint64_t lba, uint32_t count)
+{
+	if (!su_next) {
+		return true;
+	}
+	uint64_t pb = lba - su.first_block;
+	for (unsigned i = 0; i < su_next; i++) {
+		if (pb >= su_ext[i].pblk && pb - su_ext[i].pblk < su_ext[i].n) {
+			return count <= su_ext[i].n - (pb - su_ext[i].pblk);
+		}
+	}
+	return false;
+}
