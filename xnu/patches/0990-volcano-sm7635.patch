+
+static bool
+fat_init(void)
+{
+	uint8_t bs[64];
+	if (fat.ok) {
+		return true;
+	}
+	if (sweet_ufs_read_part(fw_part, 0, bs, sizeof(bs)) != 0 || memcmp(bs + 54, "FAT16", 5) != 0) {
+		LOG("%s: no FAT16 boot sector", fw_part);
+		return false;
+	}
+	uint32_t bps = bs[11] | (bs[12] << 8), spc = bs[13], rsv = bs[14] | (bs[15] << 8), nf = bs[16];
+	uint32_t re = bs[17] | (bs[18] << 8), fsz = bs[22] | (bs[23] << 8);
+	if (bps < 512 || spc == 0 || nf == 0 || fsz == 0 || fsz * bps > 0x100000) {
+		LOG("%s: odd FAT16 (bps %u spc %u fats %u fatsz %u)", fw_part, bps, spc, nf, fsz);
+		return false;
+	}
+	fat.csize = bps * spc;
+	fat.nfat = fsz * bps / 2;
+	fat.root_off = (rsv + nf * fsz) * bps;
+	fat.root_len = re * 32;
+	fat.data_off = fat.root_off + ((fat.root_len + bps - 1) / bps) * bps;
+	fat.fat = (uint16_t *)IOMalloc(fsz * bps);
+	if (fat.fat == NULL || sweet_ufs_read_part(fw_part, rsv * bps, fat.fat, fsz * bps) != 0) {
+		LOG("%s: cannot read the FAT", fw_part);
+		return false;
+	}
+	fat.ok = true;
+	LOG("%s: FAT16, cluster %u bytes, data at %#x", fw_part, fat.csize, fat.data_off);
+	return true;
+}
