+void
+volcano_psci_reset(unsigned int delay_s)
+{
+	uint64_t frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t end = __builtin_arm_rsr64("CNTVCT_EL0") + frq * delay_s;
+	while (__builtin_arm_rsr64("CNTVCT_EL0") < end) {
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (;;) {
+		register uint64_t x0 __asm__("x0") = 0xc4000012ULL;   /* SYSTEM_RESET2 */
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		x0 = 0x84000009ULL;                                     /* SYSTEM_RESET */
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	}
+}
