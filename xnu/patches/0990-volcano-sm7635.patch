+#if defined(VOLCANO)
+/*
+ * ramoops console mirror. The write position lives in the header itself, so
+ * the shim's log, the early console (VA=PA) and fbcon (ml_io_map) all append
+ * to the same record. struct persistent_ram_buffer: sig, start, size, data[].
+ */
+#define VOLCANO_RAMOOPS_SIG     0x43474244u
+#define VOLCANO_RAMOOPS_DATA    (0x200000u - 12u)
+static volatile uint8_t *volcano_early_log = (volatile uint8_t *)(uintptr_t)VOLCANO_RAMOOPS_PA;
+
+void
+volcano_log_putc(volatile uint8_t *base, char c)
+{
+	volatile uint32_t *h = (volatile uint32_t *)base;
+	if (base == NULL || c == '\r' || h[0] != VOLCANO_RAMOOPS_SIG) {
+		return;
+	}
+	uint32_t n = h[2];
+	if (n >= VOLCANO_RAMOOPS_DATA) {
+		return;
+	}
+	base[12 + n] = (uint8_t)c;
+	h[1] = n + 1;
+	h[2] = n + 1;
+}
+
+/* PSCI SYSTEM_RESET2 (warm, keeps ramoops), then SYSTEM_RESET. */
+void
+volcano_psci_reset(unsigned int delay_s)
+{
+	uint64_t frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t end = __builtin_arm_rsr64("CNTVCT_EL0") + frq * delay_s;
+	while (__builtin_arm_rsr64("CNTVCT_EL0") < end) {
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (;;) {
+		register uint64_t x0 __asm__("x0") = 0xc4000012ULL;   /* SYSTEM_RESET2 */
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		x0 = 0x84000009ULL;                                     /* SYSTEM_RESET */
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	}
+}
+#endif
+
