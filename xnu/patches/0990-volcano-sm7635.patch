+			mb();
+			volatile uint32_t *e = dp_mon.va + dp_mon.words * dp_mon_reap;
+			uint64_t pa = e[0] | ((uint64_t)(e[1] & 0xFF) << 32);
+			uint32_t cookie = e[1] >> 11;
+			if (!dp_lmac_post(&dp_mon, pa, cookie)) {
+				break;
+			}
+			dp_mon_reap = (dp_mon_reap + 1) % dp_mon.n;
