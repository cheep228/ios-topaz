+/* ---------------------------------------------------------------- AOP QMP (volcano) */
+
+#define QMP_MAGIC           0x4d41494cu
+#define QMP_UP              0x0000ffffu
+#define QMP_UCORE_LINK      0x0c
+#define QMP_UCORE_LINK_ACK  0x10
+#define QMP_UCORE_CH        0x14
+#define QMP_UCORE_CH_ACK    0x18
+#define QMP_MCORE_LINK      0x24
+#define QMP_MCORE_LINK_ACK  0x28
+#define QMP_MCORE_CH        0x2c
+#define QMP_MCORE_CH_ACK    0x30
+#define QMP_MCORE_SIZE      0x34
+#define QMP_MCORE_OFF       0x38
+
+static volatile uint8_t *qmp;
+
+static inline uint32_t qr(uint32_t o) { return *(volatile uint32_t *)(qmp + o); }
+static inline void qw(uint32_t o, uint32_t v) { mb(); *(volatile uint32_t *)(qmp + o) = v; mb(); }
+
+static bool
+qmp_wait(uint32_t o, uint32_t want)
+{
+	for (int i = 0; i < 1000; i++) {
+		if (qr(o) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return false;
+}
+
+static bool
+qmp_open(void)
+{
+	static bool open;
+	if (open) {
+		return true;
+	}
+	if (qmp == NULL) {
+		qmp = (volatile uint8_t *)ml_io_map(QMP_PA, 0x1000);
+	}
+	if (qmp == NULL || qr(0) != QMP_MAGIC || qr(4) != 1) {
+		LOG("qmp: no AOP message RAM (magic %x version %x)", qmp ? qr(0) : 0, qmp ? qr(4) : 0);
+		return false;
+	}
+	LOG("qmp: mcore link %x/%x ch %x/%x, ucore link %x ch %x, mbox %x+%x", qr(QMP_MCORE_LINK), qr(QMP_MCORE_LINK_ACK),
+	    qr(QMP_MCORE_CH), qr(QMP_MCORE_CH_ACK), qr(QMP_UCORE_LINK), qr(QMP_UCORE_CH), qr(QMP_MCORE_OFF), qr(QMP_MCORE_SIZE));
+	qw(QMP_UCORE_LINK_ACK, qr(QMP_UCORE_LINK));
+	qw(QMP_MCORE_LINK, QMP_UP);
+	doorbell(QMP_IRQ_BIT);
+	bool a = qmp_wait(QMP_MCORE_LINK_ACK, QMP_UP);
+	qw(QMP_MCORE_CH, QMP_UP);
+	doorbell(QMP_IRQ_BIT);
+	bool b = qmp_wait(QMP_UCORE_CH, QMP_UP);
+	qw(QMP_UCORE_CH_ACK, QMP_UP);
+	doorbell(QMP_IRQ_BIT);
+	bool c = qmp_wait(QMP_MCORE_CH_ACK, QMP_UP);
+	LOG("qmp: link ack %u, ucore channel %u, channel ack %u", a, b, c);
+	open = a && b && c;
+	return open;
+}
+
+static bool
+qmp_send(const char *msg)
+{
+	if (!qmp_open()) {
