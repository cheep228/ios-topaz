+/*
+ * SWEET: seed the mobile user's Accessibility preferences once (Reduce
+ * Transparency + Reduce Motion). Without a GPU, CoreAnimation renders on the
+ * CPU (CA::OGL::SW) and the backdrop blurs of the dock, folders, Control
+ * Center and the lock screen cost most of each frame. The kernel writes the
+ * plist before launchd starts, because the HFS+ root cannot be mounted
+ * read-write on the build machine. A marker file makes it one-shot, so a
+ * change made later in Settings stays. Boot-arg sweetax=0 skips it,
+ * sweetax=2 rewrites it again.
+ */
+static int
+sweet_write_file(const char *path, const char *data, int len, int uid, int gid, int mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	int err = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, mode, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	if (len > 0) {
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, len, 0, UIO_SYSSPACE,
+		    IO_SYNC | IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err && resid) {
+			err = EIO;
+		}
+	}
+	if (!err) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		VATTR_SET(&va, va_mode, mode);
+		err = vnode_setattr(vp, &va, ctx);
+	}
+	if (!err) {
+		err = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return err;
+}
+
+static void
+sweet_seed_ax_prefs(void)
+{
+	static const char marker[] = "/private/var/mobile/Library/Preferences/.sweet-ax-seeded";
+	static const char plist[] = "/private/var/mobile/Library/Preferences/com.apple.Accessibility.plist";
+	static const char body[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n"
+	    "\t<key>EnhancedBackgroundContrastEnabled</key>\n\t<true/>\n"
+	    "\t<key>ReduceMotionEnabled</key>\n\t<true/>\n"
+	    "\t<key>ReduceMotionReduceSlideTransitionsPreference</key>\n\t<true/>\n"
+	    "</dict>\n</plist>\n";
+	int ax = 1;
+	vnode_t vp = NULLVP;
+	PE_parse_boot_argn("sweetax", &ax, sizeof(ax));
+	if (ax == 0) {
+		return;
+	}
+	if (ax == 1 && vnode_lookup(marker, 0, &vp, vfs_context_kernel()) == 0) {
+		vnode_put(vp);
+		printf("SWEET AX: preferences already seeded\n");
+		return;
+	}
+	int err = sweet_write_file(plist, body, (int)sizeof(body) - 1, 501, 501, 0600);
+	if (!err) {
+		err = sweet_write_file(marker, "", 0, 0, 0, 0644);
+	}
+	printf("SWEET AX: Reduce Transparency + Reduce Motion seeded: error %d\n", err);
+}
