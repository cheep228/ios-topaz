+/* "wpss.b00" -> "WPSS    B00" */
+static void
+fat_83(const char *c, size_t n, char out[11])
+{
+	memset(out, ' ', 11);
+	size_t i = 0, o = 0;
+	for (; i < n && c[i] != '.' && o < 8; i++) {
+		out[o++] = (c[i] >= 'a' && c[i] <= 'z') ? c[i] - 32 : c[i];
+	}
+	while (i < n && c[i] != '.') {
+		i++;
+	}
+	for (i++, o = 8; i < n && o < 11; i++) {
+		out[o++] = (c[i] >= 'a' && c[i] <= 'z') ? c[i] - 32 : c[i];
+	}
+}
+
+static inline char
+fat_lc(char c)
+{
+	return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+}
