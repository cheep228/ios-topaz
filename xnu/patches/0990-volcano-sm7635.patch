+/*
+ * SWEET jailbreak payload: tools/mkjbpayload.py blob that tools/mkpayload.py
+ * --blob loads after the kernel, /chosen/memory-map "SweetPayload" = <phys,
+ * size>. The kernel only writes its files (sweetinit + the archive) into the
+ * root; sweetinit (PID 1 before launchd) unpacks the archive and writes the
+ * marker, after which the blob is ignored. Boot-arg sweetjb=0 skips it.
+ */
+#include <pexpert/device_tree.h>
+extern vm_offset_t ml_static_ptovirt(vm_offset_t);
+
+static void
+sweet_install_payload(void)
+{
+	DTEntry e;
+	void const *prop = NULL;
+	unsigned int psize = 0;
+	int jb = 1;
+	PE_parse_boot_argn("sweetjb", &jb, sizeof(jb));
+	if (!jb || SecureDTLookupEntry(NULL, "/chosen/memory-map", &e) != kSuccess ||
+	    SecureDTGetProperty(e, "SweetPayload", &prop, &psize) != kSuccess || psize < 16) {
+		return;
+	}
+	uint64_t pa = ((const uint64_t *)prop)[0], size = ((const uint64_t *)prop)[1];
+	const uint8_t *b = (const uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
+	if (b == NULL || size < 16 || memcmp(b, "SWPLOAD1", 8) != 0) {
+		printf("SWEET JB: payload at %#llx: bad header\n", pa);
+		return;
+	}
+	uint32_t count = *(const uint32_t *)(b + 8), mlen = *(const uint32_t *)(b + 12);
+	uint64_t off = 16;
+	char path[256];
+	if (mlen == 0 || mlen >= sizeof(path) || off + mlen > size) {
+		return;
+	}
+	memcpy(path, b + off, mlen);
