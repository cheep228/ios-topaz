+/*
+ * look name (n chars) up in the directory at cluster cl (0: root): first cluster, size.
+ * Matches the long name (VFAT LFN entries, ASCII only) or the 8.3 name, ignoring case.
+ */
+static bool
+fat_lookup(uint32_t cl, const char *name, size_t n, uint32_t *first, uint32_t *size)
+{
+	static const uint8_t lfn_off[13] = { 1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30 };
+	uint32_t blen = fat.csize > fat.root_len ? fat.csize : fat.root_len;
+	uint8_t *buf = (uint8_t *)IOMalloc(blen);
+	char lfn[256], n83[11];
+	bool found = false, end = false, lfn_ok = false;
+	if (buf == NULL || n == 0 || n > 255) {
+		if (buf != NULL) {
+			IOFree(buf, blen);
+		}
+		return false;
+	}
+	fat_83(name, n, n83);
+	bzero(lfn, sizeof(lfn));
+	for (unsigned hops = 0; !found && !end && hops < 4096; hops++) {
+		uint32_t len = cl == 0 ? fat.root_len : fat.csize;
+		uint64_t off = cl == 0 ? fat.root_off : fat.data_off + (uint64_t)(cl - 2) * fat.csize;
+		if (sweet_ufs_read_part(fw_part, off, buf, len) != 0) {
+			break;
+		}
+		for (uint32_t e = 0; e + 32 <= len; e += 32) {
+			uint8_t *d = buf + e;
+			if (d[0] == 0) {
+				end = true;
+				break;
+			}
+			if (d[0] == 0xE5) {
+				lfn_ok = false;
+				continue;
+			}
+			if (d[11] == 0x0F) {
+				unsigned seq = d[0] & 0x1F;
+				if (d[0] & 0x40) {
+					bzero(lfn, sizeof(lfn));
+					lfn_ok = true;
+				}
+				if (seq == 0 || seq > 19) {
+					lfn_ok = false;
+					continue;
+				}
+				for (unsigned k = 0; k < 13; k++) {
+					uint16_t c = d[lfn_off[k]] | (d[lfn_off[k] + 1] << 8);
+					unsigned pos = (seq - 1) * 13 + k;
+					if (c == 0 || c == 0xFFFF || pos >= sizeof(lfn) - 1) {
+						break;
+					}
+					lfn[pos] = c < 0x80 ? (char)c : '?';
+				}
+				continue;
+			}
+			if (d[11] & 0x08) {
+				lfn_ok = false;
+				continue;
+			}
+			bool match = memcmp(d, n83, 11) == 0;
+			if (!match && lfn_ok && strlen(lfn) == n) {
+				match = true;
+				for (size_t k = 0; k < n; k++) {
+					if (fat_lc(lfn[k]) != fat_lc(name[k])) {
+						match = false;
+						break;
+					}
+				}
+			}
+			lfn_ok = false;
+			if (match) {
+				*first = d[26] | (d[27] << 8);
+				*size = d[28] | (d[29] << 8) | (d[30] << 16) | ((uint32_t)d[31] << 24);
+				found = true;
+				break;
+			}
+		}
+		if (cl == 0 || found || end) {
+			break;
+		}
+		cl = cl < fat.nfat ? fat.fat[cl] : 0xFFFF;
+		if (cl < 2 || cl >= 0xFFF8) {
+			break;
+		}
+	}
+	IOFree(buf, blen);
+	return found;
+}
