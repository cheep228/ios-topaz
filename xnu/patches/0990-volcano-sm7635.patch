+/* ath11k ahb wcn6750 window: UMAC -> +0x80000, CE -> +0x100000, else direct */
+static uint32_t
+w_v_rd(uint32_t off)
+{
+	uint32_t win = 0;
+	if ((off ^ 0x00a00000u) < 0x7FFFFu) {
+		win = 0x80000;
+	} else if ((off ^ 0x01b80000u) < 0x7FFFFu) {
+		win = 0x100000;
+	}
+	return *(volatile uint32_t *)(w_bar + win + (off & 0x7FFFFu));
+}
