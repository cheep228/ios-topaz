+static void
+vce_status(void)
+{
+	struct vce_state *a = &vce[0], *b = &vce[2], *h = &vce[1];
+	uint32_t r[6] = { w_v_rd(W_V_SHADOW_BASE + 4 * 20), w_v_rd(VCE_SRC(0) + 0x404), w_v_rd(VCE_SRC(0) + 0x400),
+	                  w_v_rd(VCE_DST(2) + 0x400), w_v_rd(VCE_DST(2) + 0x408), w_v_rd(VCE_DST(2) + 0x40c) };
+	for (int k = 0; k < 3; k++) {
+		LOG("vce t=%u: CE0 hp %u tx %u full %u tpmem %x | HP %x TP %x MISC %x | CE2 rx %u ststp %u stshp %x | dHP %x sHP %x sTP %x | CE1 rx %u",
+		    g_ms, a->src_hp, a->tx, a->tx_full, vce_ptr[0], r[0], r[1], r[2], b->rx, b->sts_tp, vce_ptr[5],
+		    r[3], r[4], r[5], h->rx);
+	}
+}
+
+static bool
+vce_poll(void)
+{
+	bool any = false;
+	if (++vce_stat_ms % 3000 == 0 && vce_stat_ms <= 60000) {
+		vce_status();
+	}
+	for (uint32_t c = 0; c < VCE_N; c++) {
+		struct vce_state *s = &vce[c];
+		if (!vce_rx(c)) {
+			continue;
+		}
+		for (int k = 0; k < 16; k++) {
+			uint32_t hp = vce_ptr[2 * c + 1] / 4;   /* status ring HP (words -> entries) */
+			if (s->sts_tp == hp % VCE_RING) {
+				break;
+			}
+			mb();
+			volatile uint32_t *e = s->sts + 4 * s->sts_tp;
+			uint32_t len = e[0] >> 16;
+			e[0] &= 0xFFFF;
+			uint32_t slot = s->dst_sw;
+			s->dst_sw = (slot + 1) % VCE_RING;
+			s->sts_tp = (s->sts_tp + 1) % VCE_RING;
+			s->rx++;
+			if (s->rx <= 3) {
+				const uint8_t *b = s->rx_buf + (uint64_t)slot * VCE_BUF;
+				for (int r = 0; r < 3; r++) {
+					LOG("vce: CE%u rx %u bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", c, len,
+					    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11]);
+				}
+			}
+			htc_rx(c, s->rx_buf + (uint64_t)slot * VCE_BUF, MIN(len, (uint32_t)VCE_BUF));
+			vce_ptr_wr(VCE_DST(c) + 0x40c, s->sts_tp * 4);  /* status TP */
+			vce_post(c);
+			vce_ptr_wr(VCE_DST(c) + 0x400, s->dst_hp * 2);
+			any = true;
+		}
+	}
+	return any;
+}
+
+static bool
+vce_send(uint32_t c, const void *data, uint32_t len, uint32_t transfer_id)
+{
+	if (!ce_up || c >= VCE_N || !vce_tx(c) || len > VCE_BUF) {
+		return false;
+	}
+	struct vce_state *s = &vce[c];
+	uint32_t tp = (vce_ptr[2 * c] / 4) % VCE_RING;
+	if ((s->src_hp + 1) % VCE_RING == tp) {
+		s->tx_full++;
+		return false;
+	}
+	uint32_t slot = s->src_hp;
+	uint64_t pa = s->tx_pa + (uint64_t)slot * VCE_BUF;
+	memcpy(s->tx_buf + (uint64_t)slot * VCE_BUF, data, len);
+	volatile uint32_t *d = s->src + 4 * slot;
+	d[0] = (uint32_t)pa;
+	d[1] = ((uint32_t)(pa >> 32) & 0xFF) | (len << 16);
+	d[2] = transfer_id & 0xFFFF;
+	d[3] = 0;
+	s->src_hp = (slot + 1) % VCE_RING;
+	s->tx++;
+	vce_ptr_wr(VCE_SRC(c) + 0x400, s->src_hp * 4);
+	if (s->tx <= 4) {
+		const uint8_t *q = (const uint8_t *)data;
+		for (int k = 0; k < 3; k++) {
+			LOG("vce: CE%u tx %u bytes id %u: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", c, len, transfer_id,
+			    q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], q[9], q[10], q[11]);
+		}
+	}
+	return true;
+}
