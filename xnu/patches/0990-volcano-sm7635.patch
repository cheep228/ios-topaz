+/* GPU QTB500 (TBU of the GPU SMMU, DT gpu_qtb@3de8000, 2 ports): debug fence, ECATS, outstanding txns */
+#define QTB_PHYS                0x03de8000ull
+static volatile uint8_t *qtb;
+static inline uint64_t rd64(volatile uint8_t *b, uint32_t o) { return *(volatile uint64_t *)(b + o); }
+static inline void wr64(volatile uint8_t *b, uint32_t o, uint64_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint64_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* nonzero 16-byte rows of a register window, same format as the Android gpudump.ko ("GPD <tag> <off>: ...") */
+static void
+vgpd(const char *tag, volatile uint8_t *b, uint32_t from, uint32_t to)
+{
+	for (uint32_t o = from; o < to; o += 16) {
+		uint32_t a = rd(b, o), c = rd(b, o + 4), e = rd(b, o + 8), f = rd(b, o + 12);
+		if (a | c | e | f) {
+			for (int k = 0; k < 3; k++) {   /* ramoops flips bits: majority-vote offline */
+				IOLog("VGPD %s %05x: %08x %08x %08x %08x\n", tag, o, a, c, e, f);
+			}
+		}
+	}
+}
+
+static uint64_t
+qtb_ecats(uint32_t sid, uint64_t iova, bool write)
+{
+	if (qtb == NULL) {
+		return ~0ull;
+	}
+	wr64(qtb, 0x430, sid & 0x3ff);                                  /* INFLD0: SID, QAD 0 */
+	wr64(qtb, 0x438, (4u << 8) | (1u << 3) | (write ? 1u : 0u));    /* INFLD1: shared, NON_SEC, OPC */
+	wr64(qtb, 0x440, iova);                                         /* INFLD2 */
+	wr64(qtb, 0x448, 1);                                            /* TRIGGER START */
+	uint64_t st = 0, out = 0;
+	int i;
+	for (i = 0; i < 2000; i++) {
+		st = rd64(qtb, 0x450);
+		out = rd64(qtb, 0x458);
+		if ((st & 1) || (out & 1)) {
+			break;
+		}
+		IODelay(1);
+	}
+	out = rd64(qtb, 0x458);
+	wr64(qtb, 0x448, 0);
+	IOLog("VGPU: SUMMARY qtb ecats sid %u iova %llx %s: status %llx outfld0 %llx (%s) after %d us\n", sid, iova,
+	    write ? "W" : "R", st, out, (out & 1) ? "FAULT" : ((st & 1) ? "PA ok" : "TIMEOUT"), i);
+	return out;
+}
+
+static void
+qtb_diag(const char *what)
+{
+	if (qtb == NULL) {
+		qtb = (volatile uint8_t *)ml_io_map(QTB_PHYS, 0x1000);
+		if (qtb == NULL) {
+			IOLog("VGPU: qtb map failed\n");
+			return;
+		}
+	}
+	IOLog("VGPU: SUMMARY qtb %s: fencereq %llx fenceack %llx ot port0 %llx port1 %llx c00 %08x c08 %08x\n", what,
+	    rd64(qtb, 0x410), rd64(qtb, 0x418), rd64(qtb, 0xc10), rd64(qtb, 0xc20), rd(qtb, 0xc00), rd(qtb, 0xc08));
+	vgpd("qtb", qtb, 0, 0x1000);
+}
+
+static bool
+smmu_gpu_setup(void)
+{
+	volatile uint8_t *cb = gpu_cb();
+	wr(cb, 0x000, 0);
+	wr(cb, 0x058, 0xffffffff);
+	wr(smmu, 0x1800 + 4 * GPU_CB, 1);
+	wr(smmu, 0x1000 + 4 * GPU_CB, 0x0001f000);
+	wr(cb, 0x020, (uint32_t)l1gpa);                 /* own tables (0x20000000-0x3fffffff mirrored from map_page) */
+	wr(cb, 0x024, (uint32_t)(l1gpa >> 32));
+	wr(cb, 0x028, 0);
+	wr(cb, 0x02c, 0);
+	wr(cb, 0x030, 32 | (1u << 23));
+	wr(cb, 0x010, 1);
+	wr(cb, 0x038, 0x44);
+	wr(cb, 0x03c, 0);
+	wr(cb, 0x618, 0);
+	wr(cb, 0x7f0, 0);
+	poll(cb, 0x7f4, 1, 0, 1000);
+	uint32_t vcb = 1;
+	PE_parse_boot_argn("vgpucb", &vcb, sizeof(vcb));
+	if (vcb & 1) {
+		wr(cb, 0x004, 0x32b);                   /* DT qcom,actlr: all GFX CBs +15 deep prefetch */
+	}
+	wr(cb, 0x000, (vcb & 2) ? 0x00c00067 : 0x67);  /* Android kgsl CB3 SCTLR has SHCFG 3 */
+	wr(smmu, 0xc00 + 4 * GPU_SMR, GPU_CB);
+	wr(smmu, 0x800 + 4 * GPU_SMR, (1u << 31) | GPU_SID);
+	IOLog("VGPU: SMMU CB%u for SID %u: SCTLR %08x SMR %08x S2CR %08x\n", GPU_CB, GPU_SID, rd(cb, 0),
+	    rd(smmu, 0x800 + 4 * GPU_SMR), rd(smmu, 0xc00 + 4 * GPU_SMR));
+	return true;
+}
+
+/* ---------------------------------------------------------------- hwsched (vgpu=8): the GMU owns the ringbuffer */
+
+static inline uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+/* H2F_MSG_ISSUE_CMD_RAW (131): pm4 dwords after the header; then wait GPU_CX_BUSY_STATUS bit23 clear */
+static int
+hws_raw(const uint32_t *cmds, uint32_t n, const char *name)
+{
+	uint32_t m[24] = {};
+	for (uint32_t i = 0; i < n && i < 23; i++) {
+		m[1 + i] = cmds[i];
+	}
+	int r = hfi_send(131, m, n + 1, NULL, 0, name);
+	bool idle = poll(base, 4 * 0x23b0c, 1u << 23, 0, 200000);
+	aperture(PIPE_BR);
+	uint32_t sqs = g_rd(R_CP_SQE_STATUS_PIPE), hwf = g_rd(R_CP_HW_FAULT_PIPE);
+	aperture(0);
+	for (int k = 0; k < 3; k++) {
+		IOLog("VGPU: SUMMARY hws %s ack %d idle %d busy %08x rbbm %08x sqe_cntl %08x rb_base %08x%08x rptr %08x "
+		    "br sqe %08x hwfault %08x\n", name, r, idle, gmu_rd(0x23b0c), g_rd(R_RBBM_STATUS), g_rd(R_CP_SQE_CNTL),
+		    g_rd(R_CP_RB_BASE + 1), g_rd(R_CP_RB_BASE), g_rd(R_CP_RB_RPTR), sqs, hwf);
+	}
+	hfi_drain_debug();
+	return r;
+}
+
+static void
+hws_cp_init(void)
+{
+	rmw(gccb, 0x10, 2, 1);
+	rmw(gccb, 0x18, 2, 1);
+	rmw(gccb, 0x15c, 2, 1);
+	rmw(base, GPUCC + 0x90f4, 2, 1);
+	IODelay(100);
+	uint32_t c[16];
+	uint32_t i = 0;
+	c[i++] = pkt7(23, 1);                   /* CP_THREAD_CONTROL */
+	c[i++] = 1u << 27;
+	c[i++] = pkt7(72, 7);                   /* CP_ME_INIT, as gen8_cp_init_cmds() */
+	c[i++] = (1u << 0) | (1u << 1) | (1u << 3) | (1u << 6) | (1u << 8);
+	c[i++] = 3;
+	c[i++] = 0x20000000;
+	c[i++] = 2;
+	c[i++] = (uint32_t)(memb.iova + 0x1000);
+	c[i++] = (uint32_t)((memb.iova + 0x1000) >> 32);
+	c[i++] = 1u << 31;
+	int r = hws_raw(c, i, "CP_INIT");
+	uint32_t vhws = 3;
+	PE_parse_boot_argn("vhws", &vhws, sizeof(vhws));
+	if (vhws == 3) {
+		return;
+	}
+	if (r == 0 && zap_load()) {
+		c[0] = pkt7(102, 1);            /* CP_SET_SECURE_MODE 0 */
+		c[1] = 0;
+		hws_raw(c, 2, "SET_SECURE_MODE");
+	}
+	IOLog("VGPU: SUMMARY hws trust_cntl %08x\n", g_rd(R_SECVID_TRUST_CNTL));
+	c[0] = pkt7(61, 3);                     /* CP_MEM_WRITE memptr + 0x100 */
+	c[1] = (uint32_t)(memb.iova + 0x100);
+	c[2] = (uint32_t)((memb.iova + 0x100) >> 32);
+	c[3] = 0xcafe0810;
+	hws_raw(c, 4, "MEM_WRITE");
+	IODelay(1000);
+	sweet_dcache_flush((vm_offset_t)memb.va, (unsigned)memb.size);
+	for (int k = 0; k < 3; k++) {
+		IOLog("VGPU: SUMMARY hws mem_write readback %08x (want cafe0810)\n", ((volatile uint32_t *)memb.va)[0x40]);
+	}
+}
+
+static void
+cp_start(void)
+{
+	void *data = NULL;
+	size_t size = 0;
+	if (topaz_fw_read(SQE_FW_PATH, &data, &size) != 0 || data == NULL || size < 16) {
+		IOLog("VGPU: SQE fw %s not readable\n", SQE_FW_PATH);
+		return;
+	}
+	IOLog("VGPU: SQE fw %zu bytes, version word %08x\n", size, ((const uint32_t *)data)[1]);
+	if (!gbuf_alloc(&sqeb, size, 0x20000000, "sqe") || !gbuf_alloc(&rbb, 0x8000, 0x20100000, "rb") ||
+	    !gbuf_alloc(&memb, 0x4000, 0x20200000, "memptr")) {
+		return;
+	}
+	memcpy(sqeb.va, (const uint8_t *)data + 4, size - 4);
+	uint32_t vap2 = 0;
+	PE_parse_boot_argn("vhwsap", &vap2, sizeof(vap2));
+	bool mok = gbuf_map(&sqeb);
+	map_ap = vap2 ? 2 : -1;         /* Android: RB privileged read-only */
+	mok = mok && gbuf_map(&rbb);
+	map_ap = vap2 ? 0 : -1;         /* memptrs: privileged RW */
+	mok = mok && gbuf_map(&memb);
+	map_ap = -1;
+	if (!mok) {
+		return;
+	}
+	sweet_dcache_clean((vm_offset_t)sqeb.va, (unsigned)sqeb.size);
+	sweet_dcache_clean((vm_offset_t)rbb.va, (unsigned)rbb.size);
+	sweet_dcache_clean((vm_offset_t)memb.va, (unsigned)memb.size);
+	sweet_dcache_clean((vm_offset_t)tables.va, (unsigned)tables.size);
+	wr(gmu_cb(), 0x618, 0);                         /* TLBIALL on the GMU bank too: shared tables changed */
+	wr(gmu_cb(), 0x7f0, 0);
+	poll(gmu_cb(), 0x7f4, 1, 0, 1000);
+	smmu_gpu_setup();
+	qtb_diag("pre");
+	if (qtb != NULL) {
+		uint64_t fr = rd64(qtb, 0x410);
+		if (fr & 1) {
+			wr64(qtb, 0x410, fr & ~1ull);   /* left fenced (halted) by someone: release */
+			IOLog("VGPU: SUMMARY qtb fence was set (%llx), cleared -> %llx\n", fr, rd64(qtb, 0x410));
+		}
+	}
+	qtb_ecats(GPU_SID, sqeb.iova, false);
+	qtb_ecats(GPU_SID, rbb.iova, false);
+	qtb_ecats(GPU_SID, memb.iova, true);
+	qtb_ecats(5, 0x20000000ull, false);             /* GMU SID for comparison */
+
+	IOLog("VGPU: [hw_init] rbbm %08x rptr %08x sqe_cntl %08x trust %08x\n", g_rd(R_RBBM_STATUS), g_rd(R_CP_RB_RPTR),
+	    g_rd(R_CP_SQE_CNTL), g_rd(R_SECVID_TRUST_CNTL));
+	aperture(0);
+	uint32_t h0 = g_rd(R_GBIF_HALT), a0 = g_rd(R_GBIF_HALT + 1), rh0 = g_rd(R_RBBM_GBIF_HALT), ra0 = g_rd(R_RBBM_GBIF_HALT + 1);
+	g_wr(R_GBIF_HALT, 0);
+	(void)g_rd(R_GBIF_HALT);
+	g_wr(R_RBBM_GBIF_HALT, 0);
+	(void)g_rd(R_RBBM_GBIF_HALT);
+	IODelay(100);
+	uint32_t a1 = g_rd(R_GBIF_HALT + 1), ra1 = g_rd(R_RBBM_GBIF_HALT + 1);
+	if (a1 != 0 && vgpu_mode != 6) {
+		/* still acked as halted: a full upstream halt cycle (client, arb), then release */
+		g_wr(R_GBIF_HALT, 1);
+		poll(base, 4 * (R_GBIF_HALT + 1), 1, 1, 1000);
+		g_wr(R_GBIF_HALT, 2);
+		poll(base, 4 * (R_GBIF_HALT + 1), 2, 2, 1000);
+		g_wr(R_GBIF_HALT, 0);
+		poll(base, 4 * (R_GBIF_HALT + 1), 3, 0, 10000);
+	}
+	IOLog("VGPU: SUMMARY gbif before halt %08x ack %08x rbbm %08x/%08x; after clear ack %08x rbbm ack %08x; after cycle ack %08x "
+	    "rbbm ack %08x gpr0 %08x\n", h0, a0, rh0, ra0, a1, ra1, g_rd(R_GBIF_HALT + 1), g_rd(R_RBBM_GBIF_HALT + 1), g_rd(0x18));
+	uint32_t vcb3 = 1;
+	PE_parse_boot_argn("vgpucb", &vcb3, sizeof(vcb3));
+	{
+		uint32_t q8 = g_rd(0x3c48), q9 = g_rd(0x3c49), qa = g_rd(0x3c4a), qb = g_rd(0x3c4b);
+		if (vcb3 & 8) {
+			g_wr(0x3c4b, 0);                /* Android 0, iOS 1 (log365 VGPD) */
+			(void)g_rd(0x3c4b);
+		}
+		if (vcb3 & 32) {
+			g_wr(0x3c49, 1);                /* a8xx GBIF_REINIT_ENABLE, wait DONE */
+			poll(base, 4 * 0x3c4a, 3, 3, 10000);
+			g_wr(0x3c49, 0);
+		}
+		for (int k = 0; k < 3; ++k) {
+			IOLog("VGPU: SUMMARY gbif3c48 %08x %08x %08x %08x -> %08x %08x %08x %08x\n", q8, q9, qa, qb,
+			    g_rd(0x3c48), g_rd(0x3c49), g_rd(0x3c4a), g_rd(0x3c4b));
+		}
+	}
+	g_wr(R_SECVID_TSB_CNTL, 0);
+	if (vcb3 & 16) {
+		g_wr64(R_TSB_TRUSTED_BASE, 0xf0000000ull);      /* Android values */
+		g_wr(R_TSB_TRUSTED_SIZE, 0xfffff000u);
+	} else {
+		g_wr64(R_TSB_TRUSTED_BASE, 0);
+		g_wr(R_TSB_TRUSTED_SIZE, 0);
+	}
+	g_wr64(R_UCHE_CCHE_GMEM_MIN, 64ull << 20);
+	g_wr64(R_SP_GMEM_MIN, 64ull << 20);
+	const uint64_t trap = 0x1fffffffff000ull;
+	g_wr64(R_UCHE_TRAP_BASE, trap);
+	g_wr64(R_UCHE_WRITE_THRU, trap);
+	g_wr64(R_UCHE_CCHE_TRAP, trap);
+	g_wr64(R_UCHE_CCHE_WT, trap);
+	g_wr(R_UCHE_CLIENT_PF, (1u << 7) | 1);
+	g_wr(0x002f, (1u << 30) | 0xcfffff);            /* RBBM_INTERFACE_HANG_INT_CNTL (upstream fault detection) */
+	g_wr(0x058f, 1u << 30);                         /* RBBM_SLICE_INTERFACE_HANG_INT_CNTL */
+	for (uint32_t p = 0; p <= PIPE_DDE_BV; p++) {
+		if (p == PIPE_LPAC) {
+			continue;
+		}
+		aperture(p);
+		for (unsigned i = 0; i < sizeof(a810_nonctxt) / sizeof(a810_nonctxt[0]); i++) {
+			if (a810_nonctxt[i].pipes & (1u << p)) {
+				g_wr(a810_nonctxt[i].off, a810_nonctxt[i].val);
+			}
+		}
+	}
+	for (uint32_t p = PIPE_BR; p <= PIPE_DDE_BV; p++) {
+		if (p == PIPE_LPAC) {
+			continue;
+		}
+		aperture(p);
+		g_wr(R_CP_APRIV_CNTL_PIPE, p == PIPE_BR ? 0x6f : 0x0f);
+		g_wr(R_CP_INT_MASK_PIPE, 0x07e83f7f);
+		g_wr(R_CP_HW_FAULT_MASK_PIPE, 0x0000077f);
+	}
+	aperture(0);
+	g_wr(R_CP_INT_MASK_GLOBAL, 0x007f007f);
+
+	/* vgpu=7: SQE base unmapped on purpose, to see whether GX fetches reach CB3 at all (expect a CB3 fault) */
+	g_wr64(R_CP_SQE_INSTR_BASE, vgpu_mode == 7 ? 0x30000000ull : sqeb.iova);
+	if (vgpu_mode == 8) {
+		uint32_t vhws = 3;
+		PE_parse_boot_argn("vhws", &vhws, sizeof(vhws));
+		if (vhws >= 3) {
+			hws_cp_init();
+		} else {
+			IOLog("VGPU: SUMMARY hwsched stop before CP_INIT (vhws=2) rbbm %08x\n", g_rd(R_RBBM_STATUS));
+		}
+		return;
+	}
+	g_wr64(R_CP_RB_BASE, rbb.iova);
+	g_wr(R_CP_RB_CNTL, 12 | (2u << 8));             /* BUFSZ 12, BLKSZ 2 as kgsl GEN8_CP_RB_CNTL_DEFAULT */
+	g_wr64(R_CP_RB_RPTR_ADDR, memb.iova);
+	g_wr64(R_CP_RB_RPTR_ADDR_BV, memb.iova + 4);
+	rb_wptr = 0;
+	g_wr(R_CP_SQE_CNTL, 1);
+	IODelay(1000);
+	aperture(PIPE_BR);
+	IOLog("VGPU: [sqe on] rbbm %08x br sqe %08x hwfault %08x rptr %u\n", g_rd(R_RBBM_STATUS),
+	    g_rd(R_CP_SQE_STATUS_PIPE), g_rd(R_CP_HW_FAULT_PIPE), g_rd(R_CP_RB_RPTR));
+	aperture(0);
+
+	/* GX path to DDR: the GCC branches were HW-controlled and off before GX was up; force them on now */
+	uint32_t c0 = rd(gccb, 0x10), c1 = rd(gccb, 0x18), c2 = rd(gccb, 0x15c), c3 = cc_rd(0x90f4);
+	if (vgpu_mode != 6) {
+		rmw(gccb, 0x10, 2, 1);
+		rmw(gccb, 0x18, 2, 1);
+		rmw(gccb, 0x15c, 2, 1);
+		rmw(base, GPUCC + 0x90f4, 2, 1);
+		IODelay(100);
+	}
+	{
+		/* Android (kgsl active) GCC 0x171000 page: 004=1 150=3 250=3 300=0x10 15c=0x300003 */
+		uint32_t vcb2 = 1;
+		PE_parse_boot_argn("vgpucb", &vcb2, sizeof(vcb2));
+		uint32_t g004 = rd(gccb, 0x4), g150 = rd(gccb, 0x150), g250 = rd(gccb, 0x250), g300 = rd(gccb, 0x300);
+		if (vcb2 & 4) {
+			rmw(gccb, 0x004, 0, 1);
+			rmw(gccb, 0x150, 0, 1);
+			rmw(gccb, 0x250, 0, 1);
+			IODelay(100);
+		}
+		for (int k = 0; k < 3; k++) {
+			IOLog("VGPU: SUMMARY gccx 004 %08x->%08x 008 %08x 014 %08x 150 %08x->%08x 154 %08x 250 %08x->%08x 300 %08x "
+			    "gcca 000 %08x 008 %08x 010 %08x 020 %08x 14c %08x\n",
+			    g004, rd(gccb, 0x4), rd(gccb, 0x8), rd(gccb, 0x14), g150, rd(gccb, 0x150), rd(gccb, 0x154),
+			    g250, rd(gccb, 0x250), g300, rd(gcca, 0), rd(gcca, 8), rd(gcca, 0x10), rd(gcca, 0x20), rd(gcca, 0x14c));
+		}
+	}
+	IOLog("VGPU: SUMMARY axi memnoc %08x->%08x snoc %08x->%08x ddrss %08x->%08x gpucc_memnoc %08x->%08x\n", c0,
+	    rd(gccb, 0x10), c1, rd(gccb, 0x18), c2, rd(gccb, 0x15c), c3, cc_rd(0x90f4));
+
+	/* a8xx_cp_init */
+	out_pkt7(23, 1);                               /* CP_THREAD_CONTROL: no concurrent binning */
+	out_ring(1u << 27);
+	out_pkt7(72, 7);                                /* CP_ME_INIT */
+	out_ring((1u << 0) | (1u << 1) | (1u << 3) | (1u << 6) | (1u << 8));
+	out_ring(3);
+	out_ring(0x20000000);
+	out_ring(2);
+	out_ring((uint32_t)(memb.iova + 0x1000));       /* pwrup reglist: zeroed = empty lists */
+	out_ring((uint32_t)((memb.iova + 0x1000) >> 32));
+	out_ring(1u << 31);
+	if (!rb_flush("ME_INIT")) {
+		return;
+	}
+	if (vgpu_mode >= 5) {
+		/* a8xx hw_init: zap, then the CP leaves secure mode */
+		if (zap_load()) {
+			out_pkt7(102, 1);               /* CP_SET_SECURE_MODE */
+			out_ring(0);
+			rb_flush("SET_SECURE_MODE");
+		}
+		IOLog("VGPU: trust_cntl %08x\n", g_rd(R_SECVID_TRUST_CNTL));
+	}
+	/* a memory write as a liveness test (CP_MEM_WRITE to memptr + 0x100) */
+	out_pkt7(61, 3);
+	out_ring((uint32_t)(memb.iova + 0x100));
+	out_ring((uint32_t)((memb.iova + 0x100) >> 32));
+	out_ring(0xcafe0810);
+	rb_flush("MEM_WRITE");
+	IOLog("VGPU: SUMMARY mem_write readback %08x\n", ((volatile uint32_t *)memb.va)[0x40]);
+}
+
+static bool
+fw_load_file(void)
+{
+	for (int i = 0; i < 120 && !topaz_root_mounted(); i++) {
+		IOSleep(1000);
+	}
+	void *data = NULL;
+	size_t size = 0;
+	for (int i = 0; i < 30; i++) {
+		if (topaz_fw_read(GMU_FW_PATH, &data, &size) == 0 && data != NULL && size > 0) {
+			volcano_fw_gmu = (const uint8_t *)data;
+			volcano_fw_gmu_size = size;
+			IOLog("VGPU: GMU fw %s: %zu bytes\n", GMU_FW_PATH, size);
+			return true;
+		}
+		IOSleep(1000);
+	}
+	IOLog("VGPU: GMU fw %s not readable\n", GMU_FW_PATH);
+	return false;
+}
+
+static void
+probe(void *, wait_result_t)
+{
+	uint32_t mode = 1;
+	PE_parse_boot_argn("vgpu", &mode, sizeof(mode));
+	vgpu_mode = mode;
+	IOSleep(15000);
+	base = (volatile uint8_t *)ml_io_map(GPU_PHYS, GPU_MAP);
+	smmu = (volatile uint8_t *)ml_io_map(SMMU_PHYS, 0x40000);
+	gcca = (volatile uint8_t *)ml_io_map(GCC_A_PHYS, 0x1000);
+	gccb = (volatile uint8_t *)ml_io_map(GCC_B_PHYS, 0x1000);
+	if (base == NULL || smmu == NULL || gcca == NULL || gccb == NULL) {
+		IOLog("VGPU: map failed\n");
+		return;
+	}
+	state("start");
+	if (!power_cx()) {
+		IOLog("VGPU: CX power-up failed, stop\n");
+		state("fail");
+		return;
+	}
+	state("cx on");
+	uint32_t a0 = gmu_rd(GMU_AO_COUNTER_L);
+	IODelay(100);
+	uint32_t a1 = gmu_rd(GMU_AO_COUNTER_L);
+	IOLog("VGPU: GMU fw_version %08x init_result %08x boot_cfg %08x cm3_cfg %08x sysreset %08x hfi_ctrl %08x "
+	    "ao_spare %08x fence0 %08x aocnt %08x -> %08x\n",
+	    gmu_rd(GMU_CORE_FW_VERSION), gmu_rd(GMU_CM3_FW_INIT_RESULT), gmu_rd(GMU_CM3_BOOT_CONFIG),
+	    gmu_rd(GMU_CM3_CFG), gmu_rd(GMU_CM3_SYSRESET), gmu_rd(GMU_HFI_CTRL_STATUS),
+	    gmu_rd(GMU_AO_SPARE_CNTL), gmu_rd(GMU_AHB_FENCE_RANGE_0), a0, a1);
+	IOLog("VGPU: SMMU sCR0 %08x IDR0 %08x IDR1 %08x IDR2 %08x IDR7 %08x sGFSR %08x\n",
+	    rd(smmu, 0x0), rd(smmu, 0x20), rd(smmu, 0x24), rd(smmu, 0x28), rd(smmu, 0x3c), rd(smmu, 0x48));
+	smmu_dump();
+	IOLog("VGPU: RSCC(gpu+0x50000) %08x %08x cx_misc %08x %08x\n",
+	    rd(base, 0x50000), rd(base, 0x50004), rd(base, 0x9e000), rd(base, 0x9e004));
+	if (!fw_load_file()) {
+		IOLog("VGPU: probe done (no fw)\n");
+		return;
+	}
+	if (mode >= 3) {
+		gmu_boot();
+	} else {
+		tcm_test(mode >= 2);
+	}
+	IOLog("VGPU: probe done\n");
+}
+
+extern "C" void sweet_glyph_test(void);
+extern "C" int sweet_i2c7_init(void);
+extern "C" int sweet_pmic_cam_gpio(int gpio, int high);
+extern "C" int sweet_cam_probe(void);
+extern "C" int sweet_i2c7_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len);
+extern "C" int sweet_i2c7_write(uint8_t addr, uint8_t reg, uint8_t val);
+
+static void
+wl_dump(int e7, uint8_t (*w)[12], int *f, const char *tag)
+{
+	for (int j = 0; j < 2 && !e7; j++) {
+		for (int t = 0; t < 3; t++) {
+			f[j] = 0;
+			for (int r = 0; r < 12; r++) {
+				f[j] |= sweet_i2c7_read(j ? 0x61 : 0x35, (uint8_t)r, &w[j][r], 1);
+			}
+			if (!f[j]) {
+				break;
+			}
+			IOSleep(20);
+		}
+	}
+	for (int k = 0; k < 3; k++) {
+		for (int j = 0; j < 2; j++) {
+			IOLog("@@C@@ %s i2c7 %d wl%02x %d: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    tag, e7, j ? 0x61 : 0x35, f[j], w[j][0], w[j][1], w[j][2], w[j][3], w[j][4], w[j][5],
+			    w[j][6], w[j][7], w[j][8], w[j][9], w[j][10], w[j][11]);
+		}
+	}
+}
+
+static void
+glyph_thread(void *, wait_result_t)
+{
+	uint32_t vg = 0;
+	PE_parse_boot_argn("vglyph", &vg, sizeof(vg));
+	IOSleep(8000);
+	/*
+	 * camera LDO PMICs WL28681 (Android wl28681-regulator.c probe): both power up at 0x35.
+	 * Hold gpio3 chip in reset, release gpio4 chip, reprogram it to 0x61 (reg 0x12 = 2), then release gpio3.
+	 */
+	int e7 = sweet_i2c7_init();
+	int p0 = sweet_pmic_cam_gpio(0, 0);
+	int p1 = sweet_pmic_cam_gpio(1, 0);
+	IOSleep(11);
+	int p2 = sweet_pmic_cam_gpio(1, 1);
+	IOSleep(11);
+	int wa = e7 ? -9 : sweet_i2c7_write(0x35, 0x12, 0x02);
+	IOSleep(2);
+	int p3 = sweet_pmic_cam_gpio(0, 1);
+	IOSleep(11);
+	IOLog("@@P@@ seq %d %d %d %d readdr %d\n", p0, p1, p2, p3, wa);
+	uint8_t w[2][12] = {};
+	int f[2] = { -1, -1 };
+	wl_dump(e7, w, f, "init");
+	/* slot0 (main s5kgn9) supplies on chip 0x35: LDO1 vdig 1.048 V, LDO3 vana 2.804 V, LDO4 vio 1.804 V, LDO6 3.004 V */
+	if (!e7 && !f[0] && w[0][0] == 0x0d) {
+		int v = 0;
+		v |= sweet_i2c7_write(0x35, 0x04, 0x45);
+		v |= sweet_i2c7_write(0x35, 0x06, 0xb3);
+		v |= sweet_i2c7_write(0x35, 0x07, 0x36);
+		v |= sweet_i2c7_write(0x35, 0x09, 0xcc);
+		v |= sweet_i2c7_write(0x35, 0x03, (uint8_t)(w[0][3] | 0x08));      /* vio first */
+		IOSleep(2);
+		v |= sweet_i2c7_write(0x35, 0x03, (uint8_t)(w[0][3] | 0x08 | 0x04 | 0x20));
+		IOSleep(2);
+		v |= sweet_i2c7_write(0x35, 0x03, (uint8_t)(w[0][3] | 0x2d));
+		IOSleep(5);
+		uint8_t en = 0, sq = 0, uv = 0, oc = 0;
+		sweet_i2c7_read(0x35, 0x03, &en, 1);
+		sweet_i2c7_read(0x35, 0x0f, &sq, 1);
+		sweet_i2c7_read(0x35, 0x18, &uv, 1);
+		sweet_i2c7_read(0x35, 0x19, &oc, 1);
+		for (int k = 0; k < 3; k++) {
+			IOLog("@@C@@ ldo on wr %d en %02x seq %02x uvp %02x ocp %02x\n", v, en, sq, uv, oc);
+		}
+		wl_dump(e7, w, f, "ldo");
+		IOSleep(10);
+		int cid = sweet_cam_probe();
+		for (int k = 0; k < 3; k++) {
+			IOLog("@@K@@ cam probe result %d (%#x)\n", cid, cid);
+		}
+	}
+	if (vg & 1) {
+		sweet_glyph_test();
+	}
+}
+#endif /* VOLCANO */
+
+extern "C" void
+volcano_adreno_init(void)
+{
+#if defined(VOLCANO)
+	uint32_t on = 0, vg = 0;
+	if (PE_parse_boot_argn("vglyph", &vg, sizeof(vg)) && vg) {
+		thread_t gt;
+		if (kernel_thread_start(glyph_thread, NULL, &gt) == KERN_SUCCESS) {
+			thread_deallocate(gt);
+		}
+	}
+	if (!PE_parse_boot_argn("vgpu", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(probe, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+#endif
+}
