+/* volcano REQUEST_MEM: TLV 1 = u8 n, n x { u32 size, u32 type, u8 ncfg, ncfg x { u64, u32, u8 } } */
+static void
+w_v_request_mem(const uint8_t *d, uint32_t len)
+{
+	uint16_t l = 0;
+	const uint8_t *v = qm_find(d, len, 0x01, &l);
+	uint8_t out[1 + 17 * 52];
+	uint32_t n = (v != NULL && l >= 1) ? v[0] : 0, o = 1, pos = 1, k = 0;
+	uint64_t total = 0;
+
+	LOG("t=%u ms: wlfw: REQUEST_MEM, %u segment(s)", g_ms, n);
+	for (uint32_t i = 0; i < n && i < 52 && pos + 9 <= l; i++) {
+		uint32_t size, type;
+		memcpy(&size, v + pos, 4);
+		memcpy(&type, v + pos + 4, 4);
+		uint8_t ncfg = v[pos + 8];
+		pos += 9 + 13u * ncfg;
+		uint64_t pa = 0;
+		void *va = size != 0 ? pool_alloc(size, &pa) : NULL;
+		LOG(" mem seg %u: type %u size %x cfg %u -> %llx%s", i, type, size, ncfg, pa, va == NULL ? " (NO MEMORY)" : "");
+		if (va == NULL) {
+			pa = 0;
+		}
+		total += size;
+		memcpy(out + o, &pa, 8);
+		memcpy(out + o + 8, &size, 4);
+		memcpy(out + o + 12, &type, 4);
+		out[o + 16] = 0;                        /* restore */
+		o += 17;
+		k++;
+	}
+	out[0] = (uint8_t)k;
+	LOG("wlfw: %llu KB requested", total >> 10);
+	struct wmsg m;
+	if (wm_new(&m, WLFW_RESPOND_MEM)) {
+		wm_tlv(&m, 0x01, out, (uint16_t)o);
+		wm_send(&m);
+		w_step = "respond_mem sent";
+	}
+}
