+	for (uint32_t c = 0; c < VCE_N; c++) {
+		struct vce_state *s = &vce[c];
+		if (vce_tx(c)) {
+			s->src = (volatile uint32_t *)(va + off); s->src_pa = pa + off; off += 0x1000;
+			s->tx_buf = va + off; s->tx_pa = pa + off; off += VCE_RING * VCE_BUF;
+			vce_src_init(VCE_SRC(c), s->src_pa, 4, VCE_RING, vce_ptr_pa + 4 * (2 * c));
+		}
+		if (vce_rx(c)) {
+			s->dst = (volatile uint32_t *)(va + off); s->dst_pa = pa + off; off += 0x1000;
+			s->sts = (volatile uint32_t *)(va + off); s->sts_pa = pa + off; off += 0x1000;
+			s->rx_buf = va + off; s->rx_pa = pa + off; off += VCE_RING * VCE_BUF;
+			vce_src_init(VCE_DST(c), s->dst_pa, 2, VCE_RING, vce_ptr_pa + 4 * (2 * c));
+			w_v_wr(VCE_DST(c) + 0xb0, VCE_BUF);   /* DEST_CTRL max_len */
+			vce_dst_init(VCE_DST(c) + 0x58, VCE_DST(c) + 0x408, s->sts_pa, 4, VCE_RING, 80 + c,
+			    vce_ptr_pa + 4 * (2 * c + 1));
+		}
+	}
+	for (uint32_t c = 0; c < VCE_N; c++) {
+		if (!vce_rx(c)) {
+			continue;
+		}
+		for (uint32_t i = 0; i < VCE_RING - 1; i++) {
+			vce_post(c);
+		}
+		vce_ptr_wr(VCE_DST(c) + 0x400, vce[c].dst_hp * 2);   /* HP in words */
+	}
+	ce_up = true;
+	dp_common_setup();
+	for (int k = 0; k < 3; k++) {
+		LOG("vce: rings at %llx, rx posted; CE1 dst base %08x misc %08x sts misc %08x", pa,
+		    w_v_rd(VCE_DST(1)), w_v_rd(VCE_DST(1) + 0x10), w_v_rd(VCE_DST(1) + 0x58 + 0x10));
+	}
+	return true;
+}
