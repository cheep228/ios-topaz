+	PE_parse_boot_argn("vwatch", &volcano_watch_secs, sizeof(volcano_watch_secs));
+	if (volcano_watch_secs == 0) {
+		printf("VOLCANO watch: off (vwatch=0)\n");
+		return;
+	}
+	if (kernel_thread_start_priority(volcano_watch, NULL, MAXPRI_KERNEL, &w) == KERN_SUCCESS) {
+		thread_deallocate(w);
+	} else {
+		printf("VOLCANO watch: failed to start\n");
+	}
