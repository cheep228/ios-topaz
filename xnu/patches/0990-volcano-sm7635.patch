+static bool
+w_smps_param(uint32_t param, uint32_t val)
+{
+	uint8_t m[4 + 12], *c = wmi_put_tlv(m, 0xda, 12);
+	c = put32(c, 0);
+	c = put32(c, param);
+	put32(c, val);
+	return wmi_send(0x22002, m, sizeof(m));
+}
