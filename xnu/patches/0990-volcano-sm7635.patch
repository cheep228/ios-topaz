+	DTEntry chosen = NULL;
+	void const *val = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "wifi-auto", &val, &size) != kSuccess || val == NULL || size < 4) {
+		LOG("wifi-auto: none");
+		return;
