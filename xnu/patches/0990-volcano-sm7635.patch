+	R32(cam_cci, 0x104) = (28u << 16) | 28u;
+	R32(cam_cci, 0x108) = (10u << 16) | 77u;
+	R32(cam_cci, 0x10c) = 118u;
+	R32(cam_cci, 0x110) = (6u << 4) | 1u;
+	for (int k = 0; k < 3; k++) {
+		printf("@@Q@@ cci ver %#x reset st %#x scl %#x misc %#x\n", ver, rs, R32(cam_cci, 0x100), R32(cam_cci, 0x110));
+	}
+	static const struct { uint8_t a; uint16_t r; } pr[4] = {
+		{ 0x20, 0x0000 }, { 0x20, 0x0002 }, { 0x5a, 0x0000 }, { 0x34, 0x0016 },
+	};
+	int id0 = -1;
+	for (int i = 0; i < 4; i++) {
+		uint32_t ws = 0, rsx = 0, r0 = 0, r1 = 0, lv = 0;
+		int v = cam_cci_rd16(pr[i].a, pr[i].r, &ws, &rsx, &r0, &r1, &lv);
+		if (i == 0) {
+			id0 = v;
+		}
+		for (int k = 0; k < 2; k++) {
+			printf("@@Q@@ sensor %#x reg %#x -> %d (%#x) wst %#x rst %#x lvl %u raw %#x %#x\n",
+			    pr[i].a, pr[i].r, v, v, ws, rsx, lv, r0, r1);
+		}
+	}
+	return id0;
+}
