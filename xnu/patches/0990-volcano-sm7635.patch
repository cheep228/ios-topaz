+		}
+		w_bar = (volatile uint8_t *)w_bar_map->getVirtualAddress();
+	}
+	static const uint32_t offs[] = { 0x01b80000, 0x01b80004, 0x01b80008, 0x01b8000c,
+	                                 0x01b81000, 0x01b81004 };
+	for (unsigned i = 0; i < sizeof(offs) / sizeof(offs[0]); i++) {
+		uint32_t v = w_v_rd(offs[i]);
