+static void
+sweet_seed_ax_prefs(void)
+{
+	static const char marker[] = "/private/var/mobile/Library/Preferences/.sweet-ax-seeded2";
+	static const char plist[] = "/private/var/mobile/Library/Preferences/com.apple.Accessibility.plist";
+	static const char body[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n"
+	    "\t<key>EnhancedBackgroundContrastEnabled</key>\n\t<true/>\n"
+	    "\t<key>ReduceMotionEnabled</key>\n\t<false/>\n"
+	    "</dict>\n</plist>\n";
+	int ax = 1;
+	vnode_t vp = NULLVP;
+	PE_parse_boot_argn("sweetax", &ax, sizeof(ax));
+	if (ax == 0) {
+		return;
+	}
+	if (ax == 1 && vnode_lookup(marker, 0, &vp, vfs_context_kernel()) == 0) {
+		vnode_put(vp);
+		printf("SWEET AX: preferences already seeded\n");
+		return;
+	}
+	int err = sweet_write_file(plist, body, (int)sizeof(body) - 1, 501, 501, 0600);
+	if (!err) {
+		err = sweet_write_file(marker, "", 0, 0, 0, 0644);
+	}
+	printf("SWEET AX: Reduce Transparency on, Reduce Motion off: error %d\n", err);
+}
+
+/*
+ * SWEET jailbreak payload: tools/mkjbpayload.py blob that tools/mkpayload.py
+ * --blob loads after the kernel, /chosen/memory-map "SweetPayload" = <phys,
+ * size>. The kernel only writes its files (sweetinit + the archive) into the
+ * root; sweetinit (PID 1 before launchd) unpacks the archive and writes the
+ * marker, after which the blob is ignored. Boot-arg sweetjb=0 skips it.
+ */
+#include <pexpert/device_tree.h>
+extern vm_offset_t ml_static_ptovirt(vm_offset_t);
+
+static void
+sweet_install_payload(void)
+{
+	DTEntry e;
+	void const *prop = NULL;
+	unsigned int psize = 0;
+	int jb = 1;
+	PE_parse_boot_argn("sweetjb", &jb, sizeof(jb));
+	if (!jb || SecureDTLookupEntry(NULL, "/chosen/memory-map", &e) != kSuccess ||
+	    SecureDTGetProperty(e, "SweetPayload", &prop, &psize) != kSuccess || psize < 16) {
+		return;
+	}
+	uint64_t pa = ((const uint64_t *)prop)[0], size = ((const uint64_t *)prop)[1];
+	const uint8_t *b = (const uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
+	if (b == NULL || size < 16 || memcmp(b, "SWPLOAD1", 8) != 0) {
+		printf("SWEET JB: payload at %#llx: bad header\n", pa);
+		return;
+	}
+	uint32_t count = *(const uint32_t *)(b + 8), mlen = *(const uint32_t *)(b + 12);
+	uint64_t off = 16;
+	char path[256];
+	if (mlen == 0 || mlen >= sizeof(path) || off + mlen > size) {
+		return;
+	}
+	memcpy(path, b + off, mlen);
+	path[mlen] = 0;
+	off += (mlen + 7) & ~7ull;
+	/* installed: only the entries flagged "always" (mode bit 31, e.g. sweetinit) are rewritten */
+	vnode_t vp = NULLVP;
+	bool installed = false;
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) == 0) {
+		vnode_put(vp);
+		installed = true;
+		printf("SWEET JB: installed (%s)\n", path);
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		if (off + 24 > size) {
+			break;
+		}
+		uint32_t mode = *(const uint32_t *)(b + off), uid = *(const uint32_t *)(b + off + 4);
+		uint32_t gid = *(const uint32_t *)(b + off + 8), plen = *(const uint32_t *)(b + off + 12);
+		uint64_t dlen = *(const uint64_t *)(b + off + 16);
+		off += 24;
+		if (plen == 0 || plen >= sizeof(path) || off + plen > size) {
+			break;
+		}
+		memcpy(path, b + off, plen);
+		path[plen] = 0;
+		off += (plen + 7) & ~7ull;
+		if (off + dlen > size || dlen > 0x7fffffffull) {
+			break;
+		}
+		if (installed && !(mode & 0x80000000u)) {
+			off += (dlen + 7) & ~7ull;
+			continue;
+		}
+		int err = sweet_write_file(path, (const char *)(b + off), (int)dlen, (int)uid, (int)gid, (int)(mode & 07777));
+		printf("SWEET JB: wrote %s (%llu bytes): error %d\n", path, dlen, err);
+		off += (dlen + 7) & ~7ull;
+	}
+}
