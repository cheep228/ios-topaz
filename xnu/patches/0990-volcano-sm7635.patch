+/*
+ * Device block lblk of the exposed device: absolute LBA, and in *run the
+ * number of blocks from there that are contiguous on the device.
+ */
+static uint64_t
+ufs_map(uint64_t lblk, uint64_t *run)
+{
+	if (!su_next) {
+		*run = su.nblocks - lblk;
+		return su.first_block + lblk;
+	}
+	unsigned lo = 0, hi = su_next;
+	while (hi - lo > 1) {
+		unsigned mid = (lo + hi) / 2;
+		if (su_ext[mid].lblk <= lblk) {
+			lo = mid;
+		} else {
+			hi = mid;
+		}
+	}
+	const struct ufs_ext *e = &su_ext[lo];
+	*run = e->n - (lblk - e->lblk);
+	return su.first_block + e->pblk + (lblk - e->lblk);
