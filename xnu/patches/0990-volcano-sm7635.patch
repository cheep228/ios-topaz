+	cam_gpio(89, (1u << 2) | 3u, -1);
+	cam_gpio(83, (1u << 2), -1);
+	delay(2000);
+	cam_gpio(40, 0x200u, 1);           /* release reset */
+	delay(20000);
+
+	cam_cci = ml_io_map(CAM_CCI0_PA, 0x1000);
+	if (!cam_cci) {
+		return -4;
+	}
+	uint32_t ver = R32(cam_cci, 0);
+	{
+		vm_offset_t ct = ml_io_map(0xac13000, 0x1000);
+		if (ct) {
+			for (int k = 0; k < 3; k++) {
+				printf("@@Q@@ cpastop %#x %#x %#x %#x cci0 %#x %#x\n", R32(ct, 0), R32(ct, 4), R32(ct, 8), R32(ct, 0xc), R32(cam_cci, 0), R32(cam_cci, 0xc0c));
+			}
+		}
+	}
+	R32(cam_cci, 0xc04) = 0x7fffffffu;
+	R32(cam_cci, 0xc08) = 0xffffffffu;
+	R32(cam_cci, 0xc00) = 1;
+	R32(cam_cci, 0x004) = 0x0f73f3f7u;
