+	st.d_fe2 = e2;
+	st.d_fid1 = id1;
+	st.d_fid2 = id2;
+	printf("SWEET TOUCH: ft chip-id=%02x:%02x err=%d/%d fw=%02x/%d vendor=%02x/%d devmode=%02x/%d status=%#x crc=%u busy=%u\n",
+	    id1, id2, e1, e2, fw, e3, vendor, e4, mode, e5, vt.status, vt.crc, vt.busy);
+	if (st.dead || e1 || e2 || id1 != 0x56) {
+		printf("SWEET TOUCH: no FocalTech 56:xx on SE0; stopping\n");
+		goto out;
+	}
+	st.kind = TOUCH_FTS;
+	v_mark("polling");
+	printf("SWEET TOUCH: polling FT3681 1080x2392 every 4 ms (IRQ GPIO%u hint)\n", V_PIN_IRQ);
+	{
+		unsigned ticks = 0, errors = 0, idle = 0;
+		uint64_t last_stat = mach_absolute_time(), period;
+		nanoseconds_to_absolutetime(30ull * NSEC_PER_SEC, &period);
+		while (!st.dead) {
+			bool irq = !(touch_rd(vt.tlmm, TOUCH_GPIO_IO(V_PIN_IRQ)) & 1u);
+			if (irq) {
+				vt.irqlow++;
+			}
+			++ticks;
+			if (irq || (st.active && (ticks % 4u) == 0) || (ticks % 50u) == 0) {
+				int err = v_frame();
+				if (err == EAGAIN) {
+					/* empty buffer: lift contacts nobody reported for 120 ms */
+					if (st.active && ++idle > 30u) {
+						touch_report(0, st.x, st.y);
+					}
+				} else if (err) {
+					st.s_errs++;
+					st.s_lasterr = err;
+					vt.errs++;
+					if ((errors++ % 50u) == 0) {
+						printf("SWEET TOUCH: report err=%d status=%#x crc=%u busy=%u\n",
+						    err, vt.status, vt.crc, vt.busy);
+					}
+					if (errors == 10) {
+						touch_report(0, st.x, st.y);
+					}
+				} else {
+					errors = 0;
+					idle = 0;
+				}
+			}
+			if (mach_absolute_time() - last_stat > period) {
+				last_stat = mach_absolute_time();
+				printf("SWEET TOUCH: stats reads=%u frames=%u empty=%u errs=%u crc=%u busy=%u irqlow=%u maxn=%u down=%u up=%u last=%d,%d raw %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    vt.reads, vt.frames, vt.ff, vt.errs, vt.crc, vt.busy, vt.irqlow, st.s_maxn,
+				    st.s_down, st.s_up, st.s_lastx, st.s_lasty, vt.raw[0], vt.raw[1], vt.raw[2],
+				    vt.raw[3], vt.raw[4], vt.raw[5], vt.raw[6], vt.raw[7], vt.raw[8], vt.raw[9]);
+			}
+			touch_wait(4);
+		}
+	}
+	touch_report(0, st.x, st.y);
+out:
+	printf("SWEET TOUCH: stopped at '%s' dead=%d\n", st.stage ? st.stage : "?", st.dead);
+	if (st.diag) {
+		panic("SWEET TOUCH diag: stopped at '%s' dead=%d | gcc vote=%#x cfg=%#x cbcr=%#x | "
+		    "se0 fw=%#x status=%#x hwtx=%#x hwrx=%#x | ft err=%d/%d id=%02x:%02x st=%#x crc=%u busy=%u | irq=%#x",
+		    st.stage ? st.stage : "?", st.dead, st.d_vote, st.d_cfg, st.d_cbcr,
+		    st.d_fw, st.d_status, st.d_hwtx, st.d_hwrx, st.d_fe1, st.d_fe2,
+		    st.d_fid1, st.d_fid2, vt.status, vt.crc, vt.busy, st.irq_status);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * sweetswipe=N: N seconds after boot-time init, inject a bottom-to-top swipe
+ * (the lock screen's home bar) and, 15 s later, a second one; with
+ * sweetswipetap=1 also a tap in the middle of the first icon row 15 s after.
+ * Tests the iOS side of touch (backboardd -> SpringBoard) without the panel.
+ */
+static void
+touch_swipe_one(unsigned rep)
+{
+	int x = 540, y = 2360;
+	printf("SWEET SWIPE: %u wake tap\n", rep);
+	sweet_hid_touch(0, 1, 540, 1400);
+	touch_wait(60);
+	sweet_hid_touch(0, 0, 540, 1400);
+	touch_wait(1500);
+	printf("SWEET SWIPE: %u start\n", rep);
+	for (unsigned i = 0; i < 24; ++i) {
+		y = 2360 - (int)i * 60;
+		sweet_hid_touch(0, 1, x, y);
+		touch_wait(16);
+	}
+	touch_wait(30);
+	sweet_hid_touch(0, 0, x, y);
+	printf("SWEET SWIPE: %u done at %d,%d\n", rep, x, y);
+}
+
+static void
+touch_swipe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned secs = 0, tap = 0;
+	(void)PE_parse_boot_argn("sweetswipe", &secs, sizeof(secs));
+	(void)PE_parse_boot_argn("sweetswipetap", &tap, sizeof(tap));
+	printf("SWEET SWIPE: armed, %u s (tap %u)\n", secs, tap);
+	touch_wait(secs * 1000u);
+	touch_swipe_one(0);
+	touch_wait(15000);
+	touch_swipe_one(1);
+	if (tap) {
+		touch_wait(15000);
+		printf("SWEET SWIPE: tap 152,280\n");
+		sweet_hid_touch(0, 1, 152, 280);
+		touch_wait(60);
+		sweet_hid_touch(0, 0, 152, 280);
+	}
+	if (tap >= 2) {
+		extern int sweet_fb_os_off;
+		unsigned s;
+		for (s = 0; s < 150 && !sweet_fb_os_off; ++s) {
+			touch_wait(1000);
+		}
+		printf("SWEET SWIPE: display off=%d after %u s\n", sweet_fb_os_off, s);
+		touch_wait(3000);
+		sweet_hid_touch(0, 1, 540, 1400);
+		touch_wait(60);
+		sweet_hid_touch(0, 0, 540, 1400);
+		printf("SWEET SWIPE: woke, off=%d\n", sweet_fb_os_off);
+		touch_wait(3000);
+		touch_swipe_one(2);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
