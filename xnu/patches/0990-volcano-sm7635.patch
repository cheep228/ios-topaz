+
+#define VCE_N               9
+#define VCE_SRC(c)          (0x01b80000u + (c) * 0x2000u)   /* R0; R2 (HP, TP) at +0x400 */
+#define VCE_DST(c)          (0x01b81000u + (c) * 0x2000u)   /* R0; R2 at +0x400; status R0 +0x58, R2 +0x408 */
+#define VCE_RING            64
+#define VCE_BUF             2048
+
+struct vce_state {
+	volatile uint32_t *src, *dst, *sts;        /* rings (descs 4, 2, 4 words) */
+	uint64_t src_pa, dst_pa, sts_pa, rx_pa, tx_pa;
+	uint8_t *rx_buf, *tx_buf;
+	uint32_t src_hp, dst_hp, dst_sw, sts_tp;   /* in entries */
+	uint32_t rx, tx, tx_full;
+};
+static struct vce_state vce[VCE_N];
+static volatile uint32_t *vce_ptr;              /* per-ring HW-written TP/HP words (rdp) */
+static uint64_t vce_ptr_pa;
+
+static bool vce_tx(uint32_t c) { return c == 0 || c == 3 || c == 4; }
+static bool vce_rx(uint32_t c) { return c == 1 || c == 2 || c == 5; }
+
+static void
+w_v_wr(uint32_t off, uint32_t v)
+{
+	uint32_t win = 0;
+	if ((off ^ 0x00a00000u) < 0x7FFFFu) {
+		win = 0x80000;
+	} else if ((off ^ 0x01b80000u) < 0x7FFFFu) {
+		win = 0x100000;
+	}
+	mb();
+	*(volatile uint32_t *)(w_bar + win + (off & 0x7FFFFu)) = v;
+	mb();
+}
+
+/* HP / TP update: shadow register when the target register is in the shadow table */
+static void
+vce_ptr_wr(uint32_t off, uint32_t v)
+{
+	for (uint32_t i = 0; i < sizeof(w_v_shadow) / sizeof(w_v_shadow[0]); i++) {
+		if (w_v_shadow[i] == off) {
+			w_v_wr(W_V_SHADOW_BASE + 4 * i, v);
+			return;
+		}
+	}
+	w_v_wr(off, v);
+}
