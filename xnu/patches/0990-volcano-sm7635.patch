+/* ath11k_dp_tx_htt_srng_setup */
+static bool
+dp_htt_ring(struct dp_ring *r, uint32_t htt_id, uint32_t htt_type, bool src, uint32_t mac = 0)
+{
+	uint32_t m[13] = {};
+	uint32_t lmac = r->id - DP_LMAC0;
+	uint64_t hp = src ? dp_wrp_pa + 4 * lmac : dp_rdp_pa + 4 * r->id;
+	uint64_t tp = src ? dp_rdp_pa + 4 * r->id : dp_wrp_pa + 4 * lmac;
+	uint32_t pdev = htt_type == 2 ? mac : mac + 1;   /* SW_TO_SW: mac_id, else DP_SW2HW_MACID */
+	m[0] = 0x0b | (pdev << 8) | (htt_id << 16) | (htt_type << 24);
+	m[1] = (uint32_t)r->pa;
+	m[2] = (uint32_t)(r->pa >> 32);
+	m[3] = (r->n * r->words) | (r->words << 16) | (htt_type == 1 ? (1u << 25) : 0);
+	m[4] = (uint32_t)hp;
+	m[5] = (uint32_t)(hp >> 32);
+	m[6] = (uint32_t)tp;
+	m[7] = (uint32_t)(tp >> 32);
+	m[11] = src ? ((500u >> 3) << 16) : (r->words | ((256u >> 3) << 16));
+	m[12] = src ? (r->n >> 3) * r->words : 0;
+	return htt_send(m, sizeof(m));
+}
+
+/* ath11k_dp_rx_pdev_alloc: refill, mac buf, rxdma err dst, mon status */
+static void
+dp_htt_setup(const char *why)
+{
+	if (!dp_up) {
+		LOG("t=%u ms: dp: rings not up, no HTT srng setup", g_ms);
+		return;
+	}
+	bool a = dp_htt_ring(&dp_refill, 5, 2, true);   /* HTT_HOST1_TO_FW_RXBUF_RING, SW_TO_SW */
+	bool b = dp_htt_ring(&dp_macbuf, 0, 1, true);   /* HTT_RXDMA_HOST_BUF_RING, SW_TO_HW */
+	bool c = dp_htt_ring(&dp_rxerr, 7, 0, false);   /* HTT_RXDMA_NON_MONITOR_DEST_RING, HW_TO_SW */
+	bool b1 = true;
+	bool c1 = true;                                /* fix69: wcn6750 num_rxdma_per_pdev = 1, no mac 1 rings */
+	b = b && b1;
+	c = c && c1;
+	bool d = dp_htt_ring(&dp_mon, 1, 1, true);      /* fix70: HTT_RXDMA_MONITOR_STATUS_RING, SW_TO_HW */
+	{
+		uint32_t m[7];
+		m[0] = 0x0c | (1u << 8) | (1u << 16);   /* RX_RING_SELECTION_CFG, pdev 1, ring MONITOR_STATUS */
+		m[1] = DP_BUF;
+		m[2] = 0x09049249;                      /* FP mgmt flags0 */
+		m[3] = 0x00001249;                      /* FP mgmt flags1 */
+		m[4] = 0x09200000;                      /* FP ctrl flags2 */
+		m[5] = 0x01249249;                      /* FP ctrl | data flags3 */
+		m[6] = (1u << 0) | (1u << 9) | (1u << 11);   /* MPDU_START | PPDU_END | PPDU_END_STATUS_DONE */
+		bool e = htt_send(m, sizeof(m));            /* fix70: ath11k_mac_mon_status_filter_default */
+		m[0] = 0x0c | (1u << 8) | (0u << 16);   /* RX_RING_SELECTION_CFG, pdev 1, ring RXDMA_HOST_BUF */
+		m[1] = DP_BUF;
+		m[2] = 0;                               /* mgmt stays with the fw */
+		m[3] = 0;
+		m[4] = 0;
+		m[5] = (1u << 18) | (1u << 21) | (1u << 24);   /* FP data mcast | ucast | null */
+		m[6] = 0xBF;                            /* MPDU/MSDU start, packet, MSDU/MPDU end, pkt header, attention */
+		bool f = htt_send(m, sizeof(m));
+		for (int k = 0; k < 2; k++) {
+			LOG("t=%u ms: dp: mon status rx filter %s, data ring filter %s", g_ms, e ? "ok" : "FAIL", f ? "ok" : "FAIL");
+		}
+	}
+	for (int k = 0; k < 3; k++) {
+		LOG("t=%u ms: dp (%s): HTT SRING_SETUP refill %s macbuf %s rxerr %s mon %s", g_ms, why, a ? "ok" : "FAIL",
+		    b ? "ok" : "FAIL", c ? "ok" : "FAIL", d ? "ok" : "FAIL");
+	}
+}
