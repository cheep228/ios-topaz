+static vm_offset_t glyph_gpio;
+static bool glyph_ready;
+static int glyph_level;
+
+static int
+aw_w(uint8_t reg, uint8_t val)
+{
+	int e = sweet_i2c7_write(AW_ADDR, reg, val);
+	if (e) {
+		e = sweet_i2c7_write(AW_ADDR, reg, val);
+	}
+	return e;
+}
+
+static void
+hwen(bool on)
+{
+	volatile uint32_t *g = (volatile uint32_t *)glyph_gpio;
+	g[1] = on ? 2u : 0u;                 /* IO: output value */
+	g[0] = (g[0] & ~0x3ffu) | (1u << 9); /* CFG: func 0 gpio, 2 mA, no pull, OE */
+	g[1] = on ? 2u : 0u;
+}
+
+int
+sweet_glyph_init(void)
+{
+	if (glyph_ready) {
+		return 0;
+	}
+	int e = sweet_i2c7_init();
+	if (e) {
+		printf("SWEET GLYPH: i2c7 init %d\n", e);
+		return e;
+	}
+	if (!glyph_gpio) {
+		glyph_gpio = ml_io_map(GLYPH_GPIO_PA, 0x1000);
+		if (!glyph_gpio) {
+			return ENOMEM;
+		}
+	}
+	uint32_t cfg0 = ((volatile uint32_t *)glyph_gpio)[0], io0 = ((volatile uint32_t *)glyph_gpio)[1];
+	hwen(false);
+	delay(1000);
+	hwen(true);
+	delay(2500);
+	uint8_t id = 0;
+	e = aw_w(AW_PAGE, AW_P0);
+	int r = e ? -1 : sweet_i2c7_read(AW_ADDR, 0x00, &id, 1);
+	printf("SWEET GLYPH: gpio54 cfg %#x io %#x -> %#x; page %d id %d %#x\n", cfg0, io0,
+	    ((volatile uint32_t *)glyph_gpio)[1], e, r, id);
+	if (e || r || id != 0x18) {
+		return EIO;
+	}
+	e |= aw_w(0x02, 0x01);               /* SWRST */
+	delay(2500);
+	e |= aw_w(AW_PAGE, AW_P0);
+	e |= aw_w(0x03, 0x38);               /* GCCR: imax (Android WHITE profile) */
+	e |= aw_w(0x80, 0x02);
+	e |= aw_w(0x01, 0x00);               /* GCR: chip on */
+	e |= aw_w(AW_PAGE, AW_P1);
+	for (unsigned i = 0; i < AW_NLED; i++) {
+		e |= aw_w((uint8_t)i, i == 0x14 ? 0x16 : i == 0x21 ? 0x2a : 0x02);
+	}
+	e |= aw_w(AW_PAGE, AW_P2);
+	for (unsigned i = 0; i < AW_NLED; i++) {
+		e |= aw_w((uint8_t)i, 0);
+	}
+	printf("SWEET GLYPH: AW20036 ready (err %d)\n", e);
+	if (e) {
+		return EIO;
+	}
+	glyph_ready = true;
+	return 0;
+}
+
+int
+sweet_glyph_led(unsigned idx, unsigned level)
+{
+	if (!glyph_ready || idx >= AW_NLED) {
+		return ENXIO;
+	}
+	int e = aw_w(AW_PAGE, AW_P2);
+	return e | aw_w((uint8_t)idx, (uint8_t)(level > 255 ? 255 : level));
+}
+
+int
+sweet_glyph_set(unsigned level)
+{
+	int e = sweet_glyph_init();
+	if (e) {
+		return e;
+	}
+	e = aw_w(AW_PAGE, AW_P2);
+	for (unsigned i = 0; i < AW_NLED; i++) {
+		e |= aw_w((uint8_t)i, (uint8_t)(level > 255 ? 255 : level));
+	}
+	glyph_level = (int)level;
+	return e;
+}
+
+void
+sweet_glyph_test(void)
+{
+	int e = sweet_glyph_init();
+	for (int k = 0; k < 4; k++) {
+		printf("@@G@@ glyph init %d\n", e);
+	}
+	if (e) {
+		return;
+	}
+	/* chase each LED, then all on, then off */
+	for (unsigned i = 0; i < AW_NLED; i++) {
+		sweet_glyph_led(i, 255);
+		delay(60000);
+		sweet_glyph_led(i, 0);
+	}
+	e = sweet_glyph_set(255);
+	delay(1500000);
+	e |= sweet_glyph_set(0);
+	for (int k = 0; k < 4; k++) {
+		printf("@@G@@ glyph test done %d\n", e);
+	}
+}
+
+static int
+sysctl_sweet_glyph SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = glyph_level, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e || !changed) {
+		return e;
+	}
+	if (v < 0 || v > 255) {
+		return EINVAL;
+	}
+	return sweet_glyph_set((unsigned)v) ? EIO : 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_glyph, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_glyph, "I", "glyph LED brightness 0..255");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_i2c13.c b/bsd/dev/sweet_i2c13.c
new file mode 100644
index 0000000..a418268
--- /dev/null
+++ b/bsd/dev/sweet_i2c13.c
@@ -0,0 +1,251 @@
+/*
+ * topaz: polled FIFO I2C on QUP0 SE1 (battery bus: SM5602 fuel gauge 0x71,
+ * bq2589x-class charger 0x6a). Values from MakrSas/topaz-woa TopazBattery
+ * (hw.h, hwio.c) and Linux i2c-qcom-geni.c. Read-only use by SweetBattery.
+ * The SE1 RCG is not touched: DFS level 0 already runs from XO (TopazBattery).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_i2c13_init(void);
+int sweet_i2c13_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len);
+int sweet_i2c13_write(uint8_t addr, uint8_t reg, uint8_t val);
+
+#define I2C13_SE_PA      0x00898000u
+#define I2C13_GCC_PA     0x00100000u
+#define I2C13_WEST_PA    0x0f13b000u     /* TLMM WEST tile: GPIO 4/5 */
+#define I2C13_GCC_VOTE   0x52010u        /* QUP0 wrapper + SE1 vote, bits 0xbc0 */
+#define I2C13_CBCR       0x1e62cu
+#define I2C13_RCG        0x1e638u        /* qupv3_wrap0_s1 branch */
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13))
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static vm_offset_t i2c13_se, i2c13_gcc, i2c13_west;
+static bool i2c13_ready;
+static LCK_GRP_DECLARE(sweet_i2c13_grp, "sweet_i2c13");
+static LCK_MTX_DECLARE(sweet_i2c13_lock, &sweet_i2c13_grp);
+
+static uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+wait_clear(vm_offset_t b, uint32_t o, uint32_t m)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(b, o) & m)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+i2c13_abort(void)
+{
+	wr(i2c13_se, SE_CTRL, 4);                /* cancel */
+	for (unsigned i = 0; i < 1000 && !(rd(i2c13_se, SE_IRQ) & (1u << 4)); ++i) {
+		delay(1);
+	}
+	if (!(rd(i2c13_se, SE_IRQ) & (1u << 4))) {
+		wr(i2c13_se, SE_CTRL, 2);        /* abort */
+		for (unsigned i = 0; i < 1000 && !(rd(i2c13_se, SE_IRQ) & (1u << 5)); ++i) {
+			delay(1);
+		}
+	}
+	for (unsigned i = 0; i < 64 && (rd(i2c13_se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)rd(i2c13_se, SE_RX);
+	}
+	wr(i2c13_se, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* One message: write nt (<= 3) bytes or read nr (<= 64) bytes. */
+static int
+i2c13_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	unsigned sent = 0, got = 0;
+	if (!wait_clear(i2c13_se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(i2c13_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c13_se, SE_TX_WM, nt ? 1u : 0u);
+	wr(i2c13_se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(i2c13_se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = rd(i2c13_se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			int err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 2000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = rd(i2c13_se, SE_IRQ);
+			}
+			if (!(irq & SE_DONE) || (rd(i2c13_se, SE_STATUS) & 1u)) {
+				i2c13_abort();
+			}
+			wr(i2c13_se, SE_IRQ_CLR, 0xffffffffu);
+			return err;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(i2c13_se, SE_TX, word);
+			sent = nt;
+			wr(i2c13_se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(i2c13_se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 16) {
+			break;
+		}
+		while (count--) {
+			uint32_t word = rd(i2c13_se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			wr(i2c13_se, SE_IRQ_CLR, 0xffffffffu);
+			return (got == nr && sent == nt) ? 0 : EIO;
+		}
+		wr(i2c13_se, SE_IRQ_CLR, irq & ~SE_DONE);
+		delay(1);
+	}
+	i2c13_abort();
+	return ETIMEDOUT;
+}
+
+int
+sweet_i2c13_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (!i2c13_ready || len == 0 || len > 64) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c13_lock);
+	int err = i2c13_msg(addr, &reg, 1, NULL, 0, true);
+	if (!err) {
+		err = i2c13_msg(addr, NULL, 0, buf, len, false);
+	}
+	lck_mtx_unlock(&sweet_i2c13_lock);
+	return err;
+}
+
+/* One register write (TopazAudio: the sia8159 speaker amp at 0x2b). */
+int
+sweet_i2c13_write(uint8_t addr, uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = { reg, val };
+
+	if (!i2c13_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c13_lock);
+	int err = i2c13_msg(addr, tx, 2, NULL, 0, false);
+	lck_mtx_unlock(&sweet_i2c13_lock);
+	return err;
+}
+
+int
+sweet_i2c13_init(void)
+{
+	if (i2c13_ready) {
+		return 0;
+	}
+	i2c13_gcc = ml_io_map(I2C13_GCC_PA, 0x80000);
+	i2c13_west = ml_io_map(I2C13_WEST_PA, 0x2000);
+	i2c13_se = ml_io_map(I2C13_SE_PA, 0x4000);
+	if (!i2c13_gcc || !i2c13_west || !i2c13_se) {
+		return ENOMEM;
+	}
+	/* OR our votes in: other bits of the shared register belong to others */
+	/* volcano QUP1: core 0x1, s_ahb 0x2, m_ahb 0x4, core2x 0x8, SE6 0x400 (gcc-volcano.ko) */
+	wr(i2c13_gcc, I2C13_GCC_VOTE, rd(i2c13_gcc, I2C13_GCC_VOTE) | 0x40fu);
+	/* SE6 RCG: XO 19.2 MHz, no divider */
+	wr(i2c13_gcc, I2C13_RCG + 4, 0);
+	wr(i2c13_gcc, I2C13_RCG, rd(i2c13_gcc, I2C13_RCG) | 1u);
+	(void)wait_clear(i2c13_gcc, I2C13_RCG, 1u);
+	if (!wait_clear(i2c13_gcc, I2C13_CBCR, 1u << 31)) {
+		printf("SWEET I2C13: SE1 clock off (cbcr %#x)\n", rd(i2c13_gcc, I2C13_CBCR));
+		return EIO;
+	}
+	/* GPIO4/5: function 1 (qup1), 2 mA, no pull (TopazBattery CTL 0x4) */
+	/* GPIO59 SDA / GPIO60 SCL: function 1 (qup1_se6), 2 mA, pull-up */
+	wr(i2c13_west, 0x0000, (rd(i2c13_west, 0x0000) & ~0x3ffu) | 0x4u | 0x3u);
+	wr(i2c13_west, 0x1000, (rd(i2c13_west, 0x1000) & ~0x3ffu) | 0x4u | 0x3u);
+
+	uint32_t fw = rd(i2c13_se, SE_FW), rxp = rd(i2c13_se, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3u || (rd(i2c13_se, SE_STATUS) & 0x1001u)) {
+		printf("SWEET I2C13: SE1 not an idle I2C engine (fw %#x status %#x)\n",
+		    fw, rd(i2c13_se, SE_STATUS));
+		return EIO;
+	}
+	wr(i2c13_se, 0xe18, 0);
+	wr(i2c13_se, 0xe1c, 0);
+	wr(i2c13_se, 0x644, 0);
+	wr(i2c13_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c13_se, 0x648, 0xffffffffu);
+	wr(i2c13_se, SE_DMA, 0);
+	wr(i2c13_se, 0x28, rd(i2c13_se, 0x28) | 0x7fu);
+	wr(i2c13_se, 0xe30, rd(i2c13_se, 0xe30) | 0x0fu);
+	wr(i2c13_se, 0x24, 0x7f);
+	wr(i2c13_se, 0x20, 1);
+	wr(i2c13_se, SE_CLK_SEL, 0);
+	wr(i2c13_se, SE_MCLK, (2u << 4) | 1u);                  /* 400 kHz from 19.2 MHz */
+	wr(i2c13_se, SE_SCL, (5u << 20) | (11u << 10) | 22u);
+	wr(i2c13_se, 0x254, 0);
+	wr(i2c13_se, 0x260, SE_PACK0);
+	wr(i2c13_se, 0x264, SE_PACK1);
+	wr(i2c13_se, 0x284, SE_PACK0);
+	wr(i2c13_se, 0x288, SE_PACK1);
+	wr(i2c13_se, SE_TX_WM, 0);
+	wr(i2c13_se, 0x810, 0);
+	wr(i2c13_se, 0x814, ((rxp >> 16) & 0x3fu) - 1u);
+	wr(i2c13_se, SE_IRQ_EN, SE_DONE | SE_ERRORS | (3u << 26) | SE_TX_WM_IRQ);
+	i2c13_ready = true;
+	printf("SWEET I2C13: SE1 ready (fw %#x vote %#x)\n", fw, rd(i2c13_gcc, I2C13_GCC_VOTE));
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
