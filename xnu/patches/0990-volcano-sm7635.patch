+/* fix143: PMIC GPIOs that differ from Android (fix140 pmd), set before the WPSS boot:
+ *  - PMK8550 GPIO5 (ppid 0x0bc): Android DT hog "function func1" = the 32 kHz SLEEP_CLK output to the WCN6750
+ *    (regs 40=01 out, 41=00 vin0, 42=05, 44=02 func1, 45=01, 46=80). Under iOS it is a disabled input -> the WCN
+ *    runs with no sleep clock. wifipmg bit2.
+ *  - PMXR2230 (SID 1) GPIO1/GPIO2 (ppid 0x188/0x189): digital outputs on both OSes, Android drives them HIGH
+ *    (44=80), iOS LOW. wifipmg bit0/bit1.
+ * Default wifipmg=7. Only written when the APPS own the APID. */
+static bool
+w_pm_chan(volatile uint8_t *core, volatile uint8_t *cnfg, uint32_t count, uint16_t ppid, uint32_t *apid_out, uint32_t *owner_out)
+{
+	uint32_t apid = 0xFFFF, owner = 7;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t e = sp_r32(core, 0x2000 + 4 * i);
+		if (e != 0 && ((e >> 8) & 0xFFF) == ppid) {
+			uint32_t o = sp_r32(cnfg, 4 * i) & 7;
+			if (apid == 0xFFFF || o == 0) {
+				apid = i;
+				owner = o;
+			}
+		}
+	}
+	*apid_out = apid;
+	*owner_out = owner;
+	if (apid == 0xFFFF) {
+		return false;
+	}
+	sp_obs_off = (0x20 * apid) & 0xFFF;
+	sp_obs_page = (volatile uint8_t *)ml_io_map(SPMI_OBS_PA + ((0x20 * apid) & ~0xFFFu), 0x1000);
+	sp_chnl = (volatile uint8_t *)ml_io_map(SPMI_CHNLS_PA + 0x1000 * apid, 0x1000);
+	return sp_obs_page != NULL && sp_chnl != NULL;
+}
