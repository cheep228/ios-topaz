+ */
+extern "C" void sweet_fb_snapshot(uint32_t scale);
+extern "C" void
+sweet_fb_snapshot(uint32_t scale)
+{
+	static char line[3 * 512 + 1];
+	static const char hx[] = "0123456789abcdef";
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (fb == NULL || fb->fPixels == 0) {
+		IOLog("SHOT none\n");
+		return;
+	}
+	if (scale < 2) {
+		scale = 8;
+	}
+	uint32_t ow = fb->fWidth / scale, oh = fb->fHeight / scale;
+	if (ow > 512) {
+		ow = 512;
+	}
+	IOLog("SHOT begin %u %u scale %u src %ux%u\n", ow, oh, scale, fb->fWidth, fb->fHeight);
+	for (uint32_t oy = 0; oy < oh; oy++) {
+		for (uint32_t ox = 0; ox < ow; ox++) {
+			uint32_t r = 0, g = 0, b = 0, n = 0;
+			for (uint32_t y = oy * scale; y < oy * scale + scale; y += 2) {
+				const volatile uint32_t *row = (const volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = ox * scale; x < ox * scale + scale; x += 2) {
+					uint32_t p = row[x];
+					b += p & 0xff;
+					g += (p >> 8) & 0xff;
+					r += (p >> 16) & 0xff;
+					n++;
+				}
+			}
+			r /= n;
+			g /= n;
+			b /= n;
+			line[3 * ox] = hx[r >> 4];
+			line[3 * ox + 1] = hx[g >> 4];
+			line[3 * ox + 2] = hx[b >> 4];
+		}
+		/* IOLog cuts a line after ~256 bytes: 64 pixels (192 digits) a line */
+		for (uint32_t x0 = 0; x0 < ow; x0 += 64) {
+			uint32_t n = ow - x0 < 64 ? ow - x0 : 64;
+			char save = line[3 * (x0 + n)];
+			line[3 * (x0 + n)] = 0;
+			IOLog("SHOT %u %u %s\n", oy, x0, line + 3 * x0);
+			line[3 * (x0 + n)] = save;
+		}
+	}
+	IOLog("SHOT end\n");
+}
