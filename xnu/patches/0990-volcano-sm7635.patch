+			line[3 * ox + 1] = hx[g >> 4];
+			line[3 * ox + 2] = hx[b >> 4];
+		}
+		/* IOLog cuts a line after ~256 bytes: 64 pixels (192 digits) a line */
+		for (uint32_t x0 = 0; x0 < ow; x0 += 64) {
+			uint32_t n = ow - x0 < 64 ? ow - x0 : 64;
+			char save = line[3 * (x0 + n)];
+			line[3 * (x0 + n)] = 0;
+			IOLog("SHOT %u %u %s\n", oy, x0, line + 3 * x0);
+			line[3 * (x0 + n)] = save;
+		}
+	}
