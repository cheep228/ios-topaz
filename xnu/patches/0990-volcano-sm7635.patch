+/* WMI_VDEV_CHAINMASK_CONFIG_CMDID 0x5021, tag 0x2fb, 18 words (Android: 2 chains / 2 nss) */
+static void
+w_andr_chainmask(void)
+{
+	if (!(w_arg("wifiandr", 0x3f) & 0x10)) {
