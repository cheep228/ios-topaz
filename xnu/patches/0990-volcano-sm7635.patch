+	    g_rd(0x15010u), g_rd(0x15048u), g_rd(0x15050u), g_rd(0x15060u), g_rd(0x15064u), g_rd(0x15068u), g_rd(0x1506cu),
+	    g_rd(0x15070u), g_rd(0x15074u), g_rd(0x15078u), g_rd(0x1507cu));
+	for (unsigned r = 0; r < 32u; r += 8u)
+		printf("SWEET TOUCH: gdbg %s rf%u: %#x %#x %#x %#x %#x %#x %#x %#x\n", why, r,
+		    g_rd(0x15100u + 4u * r), g_rd(0x15104u + 4u * r), g_rd(0x15108u + 4u * r), g_rd(0x1510cu + 4u * r),
+		    g_rd(0x15110u + 4u * r), g_rd(0x15114u + 4u * r), g_rd(0x15118u + 4u * r), g_rd(0x1511cu + 4u * r));
+}
+static void g_sedump(const char *why) {
