+extern "C" bool
+topaz_rpmh_write(const uint32_t *a, const uint32_t *d, uint32_t n)
+{
+	static volatile uint8_t *drv;
+	bool ok = false;
+	if (n == 0 || n > 14) {
+		return false;
+	}
