diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 94c7552..1a5a91a 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -8,6 +8,8 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_cpufreq_max(void);
@@ -18,10 +20,336 @@ int sweet_cpufreq_max(void);
 #define CPUFREQ_PERF_STATE      0x920u
 #define CPUFREQ_LUT_MAX         12
 
+#if defined(VOLCANO)
+/*
+ * fix153 (volcano, SM7635): thermal governor. qcom,cpufreq-epss, three domains
+ * at 0x17d91000 (cpu0-3), 0x17d92000 (cpu4-6), 0x17d93000 (cpu7): enable +0x0,
+ * state +0x20, DCVS ctrl +0xb0 (bit0 = per-core votes at +0x320 + 4*i), LUT
+ * +0x100 (4-byte rows), PERF_STATE +0x320. TSENS v2 TM at 0xc228000 (15 sensors)
+ * and 0xc229000 (14): status +0xa0 + 4*n, bits 11:0 signed 0.1 C, bit 21 valid.
+ * Old code pinned every domain at its top entry forever -> >60 C in 10 min.
+ * Now a 1 s loop keeps the hottest sensor near thermtgt (C, default 50) by
+ * stepping a 0..16 level, and resets to Android (PSCI) at thermcrit (default 80).
+ * Boot-args: sweetcpufreq=0 (do nothing), cpumax=0..16 (level cap),
+ * thermtgt, thermcrit, thermtest=N (reset to Android after N s, tests).
+ */
+#include <kern/thread.h>
+#include <kern/clock.h>
+
+extern void volcano_psci_reset(unsigned int delay_s);
+
+#define TH_LVLS 16
+static vm_offset_t th_epss[3];
+static uint32_t th_n[3], th_khz[3][40], th_cur[3] = { 99, 99, 99 }, th_pc[3];
+static const uint32_t th_cores[3] = { 4, 3, 1 };
+static vm_offset_t th_tsens;
+static uint32_t th_en[3];
+static int8_t th_trT[64], th_trL[64];
+
+static int th_lvl = 8, th_max = TH_LVLS, th_tgt = 500, th_crit = 850, th_test = 0, th_gov = 0;
+
+static void
+th_apply(void)
+{
+	for (int d = 0; d < 3; d++) {
+		if (th_epss[d] == 0 || th_n[d] == 0) {
+			continue;
+		}
+		uint32_t idx = (uint32_t)th_lvl * (th_n[d] - 1) / TH_LVLS;
+		if (idx == th_cur[d]) {
+			continue;
+		}
+		th_cur[d] = idx;
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint32_t nc = th_pc[d] ? th_cores[d] : 1;
+		for (uint32_t i = 0; i < nc; i++) {
+			*(volatile uint32_t *)(th_epss[d] + 0x320u + 4u * i) = idx;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+/* hottest valid sensor, 0.1 C; -1000 if none */
+static int
+th_temp(int *nvalid)
+{
+	int best = -1000, nv = 0;
+	if (th_tsens == 0) {
+		*nvalid = 0;
+		return best;
+	}
+	for (int blk = 0; blk < 2; blk++) {
+		int ns = blk ? 14 : 15;
+		for (int s = 0; s < ns; s++) {
+			uint32_t v = *(volatile uint32_t *)(th_tsens + 0x1000u * blk + 0xa0u + 4u * s);
+			if (!(v & (1u << 21))) {
+				continue;
+			}
+			int t = (int)(v & 0xfffu);
+			if (t & 0x800) {
+				t -= 0x1000;
+			}
+			if (t < -400 || t > 1500) {
+				continue;
+			}
+			nv++;
+			if (t > best) {
+				best = t;
+			}
+		}
+	}
+	*nvalid = nv;
+	return best;
+}
+
+#include <mach/processor_info.h>
+extern processor_t cpu_to_processor(int cpu);
+extern kern_return_t processor_info(processor_t, processor_flavor_t, host_t *, processor_info_t,
+    mach_msg_type_number_t *);
+static uint32_t th_ld0[8][4], th_ld1[8][4];
+
+static void
+th_load(uint32_t out[8][4])
+{
+	for (int c = 0; c < 8; c++) {
+		processor_t p = cpu_to_processor(c);
+		struct processor_cpu_load_info li = { { 0 } };
+		mach_msg_type_number_t cnt = PROCESSOR_CPU_LOAD_INFO_COUNT;
+		host_t h;
+		if (p != NULL && processor_info(p, PROCESSOR_CPU_LOAD_INFO, &h, (processor_info_t)&li, &cnt) == KERN_SUCCESS) {
+			for (int k = 0; k < 4; k++) {
+				out[c][k] = li.cpu_ticks[k];
+			}
+		}
+	}
+}
+
+#include <sys/proc.h>
+#include <mach/task_info.h>
+extern kern_return_t task_info(task_t, task_flavor_t, task_info_t, mach_msg_type_number_t *);
+extern task_t proc_task(proc_t);
+
+/* fix153d: top CPU users (total user+sys since spawn) and the highest pid seen */
+static void
+th_top(void)
+{
+	int tp[10] = { 0 }, maxpid = 0, nproc = 0;
+	uint32_t tms[10] = { 0 };
+	char tn[10][20];
+	for (int pid = 0; pid < 20000; pid++) {
+		proc_t p = proc_find(pid);
+		if (p == NULL) {
+			continue;
+		}
+		nproc++;
+		maxpid = pid;
+		task_t t = proc_task(p);
+		struct task_absolutetime_info ai;
+		mach_msg_type_number_t cnt = TASK_ABSOLUTETIME_INFO_COUNT;
+		uint32_t ms = 0;
+		if (t != NULL && task_info(t, TASK_ABSOLUTETIME_INFO, (task_info_t)&ai, &cnt) == KERN_SUCCESS) {
+			ms = (uint32_t)((ai.total_user + ai.total_system) / 19200u);
+		}
+		int slot = -1;
+		for (int i = 0; i < 10; i++) {
+			if (ms > tms[i]) {
+				slot = i;
+				break;
+			}
+		}
+		if (slot >= 0) {
+			for (int i = 9; i > slot; i--) {
+				tms[i] = tms[i - 1];
+				tp[i] = tp[i - 1];
+				bcopy(tn[i - 1], tn[i], 20);
+			}
+			tms[slot] = ms;
+			tp[slot] = pid;
+			proc_name(pid, tn[slot], 20);
+		}
+		proc_rele(p);
+	}
+	for (int k = 0; k < 6; k++) {
+		printf("@@P@@ nproc %d maxpid %d\n", nproc, maxpid);
+		for (int i = 0; i < 10; i++) {
+			printf("@@P%d@@ %d %s %u ms\n", i, tp[i], tms[i] ? tn[i] : "-", tms[i]);
+		}
+	}
+}
+
+static void
+th_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t sec = 0;
+	int hot = 0;
+	for (;;) {
+		int nv;
+		int t = th_temp(&nv);
+		if (nv > 0) {
+			if (t >= th_crit) {
+				if (++hot >= 2) {
+					for (int k = 0; k < 12; k++) {
+						printf("@@T@@ CRIT %d.%d C at %us -> reset to Android\n", t / 10, t % 10, sec);
+					}
+					volcano_psci_reset(1);
+				}
+			} else {
+				hot = 0;
+			}
+			if (!th_gov) {
+				/* default: old behaviour, every domain at its top entry */
+			} else if (t > th_tgt + 30) {
+				th_lvl -= 3;
+			} else if (t > th_tgt) {
+				th_lvl -= 1;
+			} else if (t < th_tgt - 40) {
+				th_lvl += 1;
+			}
+		} else {
+			if (th_gov) {
+				th_lvl = 4;     /* no sensor: stay low */
+			}
+		}
+		if (th_lvl < 0) {
+			th_lvl = 0;
+		}
+		if (th_lvl > th_max) {
+			th_lvl = th_max;
+		}
+		th_apply();
+		if (sec % 10 == 0) {
+			for (int k = 0; k < 3; k++) {
+				printf("@@T@@ %us T=%d.%dC n=%d lvl %d MHz %u/%u/%u\n", sec, t / 10, t % 10, nv, th_lvl,
+				    th_n[0] ? th_khz[0][th_cur[0]] / 1000 : 0, th_n[1] ? th_khz[1][th_cur[1]] / 1000 : 0,
+				    th_n[2] ? th_khz[2][th_cur[2]] / 1000 : 0);
+			}
+		}
+		if (sec % 5 == 0 && sec / 5 < 64) {
+			th_trT[sec / 5] = (int8_t)(t / 10);
+			th_trL[sec / 5] = (int8_t)th_lvl;
+		}
+		if (sec == 10) {
+			th_load(th_ld0);
+		}
+		if (th_test > 0 && sec >= (uint32_t)th_test) {
+			th_load(th_ld1);
+			for (int k = 0; k < 8; k++) {
+				for (int c = 0; c < 8; c++) {
+					printf("@@U@@ c%d u %u s %u i %u\n", c, th_ld1[c][0] - th_ld0[c][0],
+					    th_ld1[c][1] - th_ld0[c][1], th_ld1[c][2] - th_ld0[c][2]);
+				}
+				for (int blk = 0; blk < 2; blk++) {
+					int tv[15] = { 0 };
+					for (int s2 = 0; s2 < (blk ? 14 : 15); s2++) {
+						uint32_t rv = *(volatile uint32_t *)(th_tsens + 0x1000u * blk + 0xa0u + 4u * s2);
+						int x = (int)(rv & 0xfffu);
+						tv[s2] = ((x & 0x800) ? x - 0x1000 : x) / 10;
+					}
+					printf("@@S%d@@ %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d\n", blk, tv[0], tv[1], tv[2],
+					    tv[3], tv[4], tv[5], tv[6], tv[7], tv[8], tv[9], tv[10], tv[11], tv[12], tv[13], tv[14]);
+				}
+			}
+			for (int k = 0; k < 8; k++) {
+				for (int d = 0; d < 3; d++) {
+					printf("@@E@@ d%d en %x st %x pf %x n %u pc %u\n", d, th_en[d],
+					    th_epss[d] ? *(volatile uint32_t *)(th_epss[d] + 0x20u) : 0,
+					    th_epss[d] ? *(volatile uint32_t *)(th_epss[d] + 0x320u) : 0, th_n[d], th_pc[d]);
+				}
+			}
+			for (int r = 0; r < 8; r++) {
+				for (int k = 0; k < 8; k++) {
+					printf("@@Q%d@@ T %d %d %d %d %d %d %d %d L %d %d %d %d %d %d %d %d\n", r,
+					    th_trT[r * 8], th_trT[r * 8 + 1], th_trT[r * 8 + 2], th_trT[r * 8 + 3],
+					    th_trT[r * 8 + 4], th_trT[r * 8 + 5], th_trT[r * 8 + 6], th_trT[r * 8 + 7],
+					    th_trL[r * 8], th_trL[r * 8 + 1], th_trL[r * 8 + 2], th_trL[r * 8 + 3],
+					    th_trL[r * 8 + 4], th_trL[r * 8 + 5], th_trL[r * 8 + 6], th_trL[r * 8 + 7]);
+				}
+			}
+			printf("@@T@@ thermtest done at %us -> reset to Android\n", sec);
+			volcano_psci_reset(1);
+		}
+		delay_for_interval(1000, NSEC_PER_MSEC);
+		sec++;
+	}
+}
+
+static int
+volcano_epss_max(void)
+{
+	static const uint32_t pa[3] = { 0x17d91000u, 0x17d92000u, 0x17d93000u };
+	static int started;
+	if (started) {
+		return 0;
+	}
+	started = 1;
+	int v;
+	if (PE_parse_boot_argn("cpumax", &v, sizeof(v))) {
+		th_max = v;
+	}
+	if (PE_parse_boot_argn("thermtgt", &v, sizeof(v))) {
+		th_tgt = v * 10;
+	}
+	if (PE_parse_boot_argn("thermcrit", &v, sizeof(v))) {
+		th_crit = v * 10;
+	}
+	(void)PE_parse_boot_argn("thermtest", &th_test, sizeof(th_test));
+	(void)PE_parse_boot_argn("thermgov", &th_gov, sizeof(th_gov));
+	if (!th_gov) {
+		th_lvl = th_max = TH_LVLS;
+	}
+	if (th_lvl > th_max) {
+		th_lvl = th_max;
+	}
+	for (int d = 0; d < 3; d++) {
+		vm_offset_t b = ml_io_map(pa[d], 0x1000);
+		if (b == 0) {
+			continue;
+		}
+		uint32_t en = *(volatile uint32_t *)(b + 0x0u);
+		uint32_t prevKHz = 0, n = 0;
+		for (uint32_t i = 0; i < 40; i++) {
+			uint32_t r = *(volatile uint32_t *)(b + 0x100u + 4u * i);
+			uint32_t src = (r >> 30) & 3u, lval = r & 0xffu;
+			uint32_t khz = src ? 19200u * lval : 300000u;
+			if (i > 0 && khz <= prevKHz) {
+				break;  /* LUT repeats its last entry */
+			}
+			prevKHz = khz;
+			th_khz[d][i] = khz;
+			n = i + 1;
+		}
+		th_pc[d] = *(volatile uint32_t *)(b + 0xb0u) & 1u;
+		printf("SWEET CPUFREQ: epss%d en=%#x state=%#x lut=%u perf %u percore %u top %u MHz\n", d, en,
+		    *(volatile uint32_t *)(b + 0x20u), n, *(volatile uint32_t *)(b + 0x320u), th_pc[d],
+		    n ? th_khz[d][n - 1] / 1000 : 0);
+		th_en[d] = en;
+		if ((en & 3u) && n > 1) {
+			th_epss[d] = b;
+			th_n[d] = n;
+		}
+	}
+	th_tsens = ml_io_map(0x0c228000u, 0x2000);
+	th_apply();
+	thread_t th;
+	if (kernel_thread_start(th_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	printf("SWEET THERM: gov %d, lvl %d/%d tgt %d crit %d test %d\n", th_gov, th_lvl, th_max, th_tgt, th_crit, th_test);
+	return 0;
+}
+#endif
+
 int
 sweet_cpufreq_max(void)
 {
-	int on = 1;
+#if defined(VOLCANO)
+	{
+		int von = 1;
+		PE_parse_boot_argn("sweetcpufreq", &von, sizeof(von));
+		return von ? volcano_epss_max() : 0;
+	}
+#endif
+	int on = 0;     /* volcano: EPSS layout differs from SM6115; off until ported */
 	PE_parse_boot_argn("sweetcpufreq", &on, sizeof(on));
 	if (!on) {
 		return 0;
