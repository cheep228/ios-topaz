+/* volcano: load name (board data or regdb) whole and start sending it */
+static void
+w_v_load(const char *name)
+{
+	int64_t sz = fw_size(name);
+	if (sz <= 0 || sz > 0x100000) {
+		LOG("wlfw: %s: size %lld, not sent", name, sz);
+		return;
+	}
+	if (w_vbuf == NULL || w_vbuf_cap < (uint32_t)sz) {
+		if (w_vbuf != NULL) {
+			IOFree(w_vbuf, w_vbuf_cap);
+		}
+		w_vbuf_cap = (uint32_t)sz;
+		w_vbuf = (uint8_t *)IOMalloc(w_vbuf_cap);
+		if (w_vbuf == NULL) {
+			w_vbuf_cap = 0;
+			return;
+		}
+	}
+	if (fw_read(name, w_vbuf, w_vbuf_cap) != sz) {
+		LOG("wlfw: %s: read failed", name);
+		return;
+	}
+	w_bdf_len = (uint32_t)sz;
+	w_bdf_off = 0;
+	w_bdf_seg = 0;
+	LOG("t=%u ms: wlfw: %s (type %u), %u bytes", g_ms, name, w_bdf_type, w_bdf_len);
+	w_bdf_segment();
