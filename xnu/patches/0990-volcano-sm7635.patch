+static void
+dp_poll(void)
+{
+	if (!dp_up) {
+		return;
+	}
+	bool any = false;
+	for (uint32_t i = 0; i < 4; i++) {
+		any |= dp_reap(&dp_reo[i], false);
+	}
+	any |= dp_reap(&dp_reo_exc, false);
+	any |= dp_reap(&dp_rxrel, false);
+	any |= dp_reap(&dp_wbm1, false);
+	any |= dp_reap(&dp_wbm2, false);
+	any |= dp_reap(&dp_wbm4, false);
+	any |= dp_reap(&dp_wbm0, false);
+	any |= dp_reap(&dp_rxerr, true);
+	any |= dp_reap(&dp_rxerr1, true);
