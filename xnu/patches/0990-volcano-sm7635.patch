+/* clean the ring, write WPTR, wait for RPTR to catch up */
+static bool
+rb_flush(const char *what)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sweet_dcache_clean((vm_offset_t)rbb.va, (unsigned)rbb.size);
+	g_wr(R_CP_RB_WPTR, rb_wptr);
+	bool ok = poll(base, 4 * R_CP_RB_RPTR, 0xffffffff, rb_wptr, 200000);
+	sweet_dcache_flush((vm_offset_t)memb.va, 0x1000);
+	aperture(PIPE_BR);
+	uint32_t sqe = g_rd(R_CP_SQE_STATUS_PIPE), hwf = g_rd(R_CP_HW_FAULT_PIPE), ints = g_rd(R_CP_INT_STATUS_PIPE);
+	aperture(0);
+	if (!ok) {
+		/* same format as Android gpudump (GPD gpu <byteoff>: 4 regs), for diffing */
+		static const uint16_t rng[][2] = { { 0x0, 0x60 }, { 0x800, 0x850 }, { 0x3c00, 0x3c50 } };
+		for (int pass = 0; pass < 2; pass++) {
+			for (unsigned r = 0; r < 3; r++) {
+				for (uint32_t o = rng[r][0]; o < rng[r][1]; o += 4) {
+					uint32_t a = g_rd(o), b = g_rd(o + 1), c = g_rd(o + 2), d = g_rd(o + 3);
+					if (a | b | c | d) {
+						IOLog("VGD gpu %05x: %08x %08x %08x %08x\n", 4 * o, a, b, c, d);
+					}
+				}
+			}
+		}
+		/*
+		 * Crash dumper (independent CP DMA engine): reads regs into memory per a script.
+		 * If it completes, the GX -> SMMU -> DDR path works and the SQE problem is elsewhere.
+		 */
+		uint32_t vcd = 0;
+		PE_parse_boot_argn("vgpucb", &vcd, sizeof(vcd));
+		if (!(vcd & 64)) {
+			goto no_cd;     /* log381: crash dumper run -> cold reset, ramoops lost */
+		}
+		{
+		volatile uint64_t *sc = (volatile uint64_t *)(memb.va + 0x2000);
+		volatile uint32_t *dd = (volatile uint32_t *)(memb.va + 0x3000);
+		for (int i = 0; i < 0x100; i++) {
+			dd[i] = 0x55555555u;
+		}
+		dd[0x40] = 0xaaaaaaaau;
+		sc[0] = memb.iova + 0x3000; sc[1] = (0x012ull << 44) | 1;    /* RBBM_STATUS only (0x0-0xf has locked regs) */
+		sc[2] = memb.iova + 0x3040; sc[3] = (0x800ull << 44) | 16;   /* CP 0x800..0x80f */
+		sc[4] = memb.iova + 0x3100; sc[5] = (0x845ull << 44) | 1;    /* CRASH_DUMP_STATUS -> end marker */
+		sc[6] = 0; sc[7] = 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		sweet_dcache_clean((vm_offset_t)memb.va + 0x2000, 0x2000);
+		g_wr64(0x842, memb.iova + 0x2000);
+		g_wr(0x844, 1);
+		uint32_t cds = 0, end = 0;
+		for (int i = 0; i < 2000; i++) {
+			IODelay(50);
+			sweet_dcache_flush((vm_offset_t)memb.va + 0x3000, 0x1000);
+			end = dd[0x40];
+			if (end != 0xaaaaaaaau) {
+				break;
+			}
+		}
+		cds = g_rd(0x845);
+		g_wr(0x844, 0);
+		for (int k = 0; k < 3; k++) {
+			IOLog("VGPU: SUMMARY crashdump status %08x end %08x d0 %08x %08x %08x cp %08x %08x %08x rbbm %08x\n",
+			    cds, end, dd[0], dd[1], dd[2], dd[0x10], dd[0x12], dd[0x17], g_rd(R_RBBM_STATUS));
+		}
+		}
+no_cd:;
+	}
+	volatile uint8_t *cb = gpu_cb();
+	IOLog("VGPU: CP %s: wptr reg %u, RB_BASE %08x%08x CNTL %08x SQE_BASE %08x%08x\n", what, g_rd(R_CP_RB_WPTR),
+	    g_rd(R_CP_RB_BASE + 1), g_rd(R_CP_RB_BASE), g_rd(R_CP_RB_CNTL), g_rd(R_CP_SQE_INSTR_BASE + 1),
+	    g_rd(R_CP_SQE_INSTR_BASE));
+	IOLog("VGPU: SUMMARY CP %s %s: rptr %u wptr %u shadow %u rbbm %08x int0 %08x cpint %08x br sqe %08x hwfault %08x "
+	    "int %08x CB%u FSR %08x FAR %08x%08x FSYNR0 %08x sGFSR %08x sGFSYNR1 %08x\n", what, ok ? "OK" : "STUCK",
+	    g_rd(R_CP_RB_RPTR), rb_wptr, ((volatile uint32_t *)memb.va)[0], g_rd(R_RBBM_STATUS), g_rd(R_RBBM_INT_0_STATUS),
+	    g_rd(R_CP_INT_STATUS_GLOBAL), sqe, hwf, ints, GPU_CB, rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60), rd(cb, 0x68),
+	    rd(smmu, 0x48), rd(smmu, 0x54));
+	if (!ok) {
+		/* where did the GX traffic go: any bank with a fault, any valid stream match, GBIF halt state */
+		for (uint32_t i = 0; i < 22; i++) {
+			volatile uint8_t *c = smmu + SMMU_CB_BASE + i * 0x1000;
+			uint32_t fsr = rd(c, 0x58);
+			if (fsr & ~0x600u) {
+				IOLog("VGPU: SUMMARY CB%u FSR %08x FAR %08x%08x FSYNR0 %08x SCTLR %08x\n", i, fsr, rd(c, 0x64),
+				    rd(c, 0x60), rd(c, 0x68), rd(c, 0));
+			}
+		}
+		for (uint32_t i = 0; i < 24; i++) {
+			uint32_t smr = rd(smmu, 0x800 + 4 * i);
+			if (smr & (1u << 31)) {
+				IOLog("VGPU: SMR%u %08x S2CR %08x\n", i, smr, rd(smmu, 0xc00 + 4 * i));
+			}
+		}
+		{
+			/* gen8 snapshot regs (BR aperture): SQE_STAT 0x8f0/1, ROQ_DBG 0x8f4/5, UCODE_DBG 0x8f8/9 */
+			uint32_t st[32], rq[16];
+			aperture(PIPE_BR);
+			for (unsigned i = 0; i < 32; i++) {
+				g_wr(0x8f0, i);             /* explicit index (log373: no auto-increment seen) */
+				st[i] = g_rd(0x8f1);
+			}
+			uint32_t pc[8];
+			for (unsigned i = 0; i < 8; i++) {
+				g_wr(0x8f0, 0);
+				pc[i] = g_rd(0x8f1);
+				IODelay(500);
+			}
+			g_wr(0x8f4, 0);
+			for (unsigned i = 0; i < 16; i++) {
+				rq[i] = g_rd(0x8f5);
+			}
+			g_wr(0x8f8, 0);
+			uint32_t u0 = g_rd(0x8f9), u1 = g_rd(0x8f9), u2 = g_rd(0x8f9), u3 = g_rd(0x8f9);
+				uint32_t vcd2 = 0; PE_parse_boot_argn("vgpucb", &vcd2, sizeof(vcd2));
+				if (vcd2 & 128) {
+				/* kgsl snapshot sets CP_CHICKEN_DBG[StabilizeMVC] (0x8b2 bit2) before indexed dumps */
+				uint32_t ch = g_rd(0x8b2);
+				g_wr(0x8b2, ch | 4);
+					g_wr(R_CP_SQE_CNTL, 0);
+					IODelay(100);
+				const uint32_t *fw = (const uint32_t *)sqeb.va;
+				uint32_t nfw = 64, match = 0, firstbad = 0xffffffff, fbv = 0, fbf = 0, nz = 0;
+				uint32_t s0[8];
+				g_wr(0x8f8, 0);
+				for (uint32_t i = 0; i < nfw; i++) {
+					uint32_t v = g_rd(0x8f9);
+					if (i < 8) {
+						s0[i] = v;
+					}
+					if (v) {
+						nz++;
+					}
+					if (v == fw[i]) {
+						match++;
+					} else if (firstbad == 0xffffffff) {
+						firstbad = i; fbv = v; fbf = fw[i];
+					}
+				}
+				uint32_t st0 = 0, st1 = 0;
+				g_wr(0x8f0, 0); st0 = g_rd(0x8f1); st1 = g_rd(0x8f1);
+				g_wr(0x8b2, ch);
+				for (int k = 0; k < 3; k++) {
+					IOLog("VGPU: SUMMARY ucodecmp chk %08x match %u/%u nz %u bad@%x %08x fw %08x u %08x %08x %08x %08x fw %08x %08x stat %08x %08x\n",
+					    ch, match, nfw, nz, firstbad, fbv, fbf, s0[0], s0[1], s0[2], s0[3], fw[0], fw[1], st0, st1);
+				}
+			}
+			aperture(0);
+			for (unsigned k = 0; k < 2; k++) {
+				IOLog("VGPU: SUMMARY sqepc %08x %08x %08x %08x %08x %08x %08x %08x rbbm1 %08x gfx %08x %08x br %08x bv %08x misc %08x\n",
+				    pc[0], pc[1], pc[2], pc[3], pc[4], pc[5], pc[6], pc[7], g_rd(0x13), g_rd(0x15), g_rd(0x16),
+				    g_rd(0x1a), g_rd(0x1c), g_rd(0x1e));
+				IOLog("VGPU: SUMMARY hang int0 %08x 2f %08x 30 %08x %08x %08x %08x %08x %08x %08x %08x\n", g_rd(R_RBBM_INT_0_STATUS),
+				    g_rd(0x2f), g_rd(0x30), g_rd(0x31), g_rd(0x32), g_rd(0x33), g_rd(0x34), g_rd(0x35), g_rd(0x36), g_rd(0x37));
+				IOLog("VGPU: SUMMARY sqestat %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				    st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[7], st[8], st[9], st[10], st[11], st[12],
+				    st[13], st[14], st[15]);
+				IOLog("VGPU: SUMMARY sqestat2 %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				    st[16], st[17], st[18], st[19], st[20], st[21], st[22], st[23], st[24], st[25], st[26], st[27],
+				    st[28], st[29], st[30], st[31]);
+				IOLog("VGPU: SUMMARY roq %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x ucode %08x %08x %08x %08x\n",
+				    rq[0], rq[1], rq[2], rq[3], rq[4], rq[5], rq[6], rq[7], rq[8], rq[9], rq[10], rq[11], rq[12],
+				    rq[13], rq[14], rq[15], u0, u1, u2, u3);
+			}
+		}
+		qtb_diag(what);
+		qtb_ecats(GPU_SID, sqeb.iova, false);
+		static bool dumped;
+		if (!dumped) {
+			dumped = true;
+			static const uint32_t gr[][2] = { {0, 0x100}, {0x200, 0x220}, {0x800, 0x830}, {0x840, 0x850},
+			    {0x8b0, 0x8c0}, {0xe00, 0xe20}, {0xf00, 0xf10}, {0x3c00, 0x3c50}, {0xf400, 0xf404}, {0xf800, 0xf814} };
+			for (unsigned i = 0; i < sizeof(gr) / sizeof(gr[0]); i++) {
+				vgpd("gpu", base, 4 * gr[i][0], 4 * gr[i][1]);
+			}
+			vgpd("gcca", gcca, 0, 0x1000);
+			vgpd("gccb", gccb, 0, 0x1000);
+			vgpd("smmucb3", gpu_cb(), 0, 0x80);
+		}
+		IOLog("VGPU: SUMMARY gbif halt %08x ack %08x rbbm_gbif halt %08x ack %08x gbif_cx_cfg %08x qsb0 %08x "
+		    "sGFSR %08x sGFAR %08x%08x sGFSYNR0 %08x\n", g_rd(R_GBIF_HALT), g_rd(R_GBIF_HALT + 1),
+		    g_rd(R_RBBM_GBIF_HALT), g_rd(R_RBBM_GBIF_HALT + 1), g_rd(0x3c00), g_rd(0x3c03), rd(smmu, 0x48),
+		    rd(smmu, 0x44), rd(smmu, 0x40), rd(smmu, 0x50));
+	}
+	return ok;
+}
