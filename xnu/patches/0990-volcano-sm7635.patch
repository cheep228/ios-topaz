diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 4da50d8..1e80ec0 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -355,4 +355,220 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * volcano (SM7635): apps RSC DRV2 at 0x17a20000, TCS block at +0xd00 (DT
+ * qcom,tcs-offset), tcs-config ACTIVE 3 / SLEEP 2 / WAKE 2 / FAST 1, so the
+ * ACTIVE TCSs are 0..2. The RSC is v3+ here (rpmh-rsc.c ver_3_0 offsets);
+ * v2 offsets are kept for an older ID. VRM addresses come from the live
+ * cmd-db (/sys/kernel/debug/cmd-db: ldob11 0x40a00, ldob22 0x42800), so no
+ * cmd-db parsing: its reserved RAM is ordinary memory to XNU here.
+ */
+#define VR_DRV_PA       0x17a20000u
+#define VR_TCS_OFF      0xd00u
+#define VR_DRV          2u
+#define VR_ACTIVE_N     3u
+
+static vm_offset_t vr_drv;
+static uint32_t vr_cmd_stride, vr_wait, vr_control, vr_status, vr_enable,
+    vr_msgid, vr_addr, vr_data, vr_cmd_status;
+static unsigned vr_ncpt;
+static bool vr_poisoned, vr_ready;
+
+static uint32_t
+vr_rd(uint32_t off)
+{
+	return rh_read(vr_drv, off);
+}
+
+static bool
+vr_sync(uint32_t off, uint32_t value)
+{
+	rh_write(vr_drv, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(vr_drv, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(vr_drv, off));
+	return false;
+}
+
+static int
+vr_map(void)
+{
+	if (vr_ready) {
+		return 0;
+	}
+	if (!vr_drv) {
+		vr_drv = ml_io_map(VR_DRV_PA, 0x4000);
+	}
+	if (!vr_drv) {
+		return ENOMEM;
+	}
+	uint32_t id = vr_rd(0), config = vr_rd(0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * VR_DRV)) & 0x3fu;
+	vr_ncpt = (config >> 27) & 0x1fu;
+	if (major >= 3) {
+		vr_cmd_stride = 24; vr_wait = 0x20; vr_control = 0x24; vr_status = 0x28;
+		vr_enable = 0x2c; vr_msgid = 0x34; vr_addr = 0x38; vr_data = 0x3c; vr_cmd_status = 0x40;
+	} else {
+		vr_cmd_stride = 20; vr_wait = 0x10; vr_control = 0x14; vr_status = 0x18;
+		vr_enable = 0x1c; vr_msgid = 0x30; vr_addr = 0x34; vr_data = 0x38; vr_cmd_status = 0x3c;
+	}
+	printf("SWEET RPMH: volcano drv2 id=%#x (v%u.%u) solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    id, major, (id >> 8) & 0xffu, vr_rd(4), config, count, vr_ncpt);
+	if (id == 0xffffffffu || config == 0xffffffffu || major < 1 || major > 5 ||
+	    count < VR_ACTIVE_N || count > 16 || vr_ncpt < 3 || vr_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	vr_ready = true;
+	return 0;
+}
+
+#define VR_TCS(t)       (VR_TCS_OFF + (t) * RH_TCS_STRIDE)
+
+static bool
+vr_free(unsigned t)
+{
+	uint32_t b = VR_TCS(t);
+	return vr_rd(b + vr_status) != 0 && vr_rd(b + vr_status) != 0xffffffffu &&
+	    vr_rd(b + vr_control) == 0 && vr_rd(b + vr_enable) == 0 &&
+	    vr_rd(b + vr_wait) == 0 && !(vr_rd(VR_TCS_OFF + RH_IRQ_STATUS) & (1u << t));
+}
+
+/* One ACTIVE request of n commands (n <= 3), waiting for completion of all. */
+static int
+vr_send_cmds(unsigned n, const uint32_t *addrs, const uint32_t *values)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < VR_ACTIVE_N; ++t) {
+		if (vr_free(t)) {
+			chosen = (int)t;
+			break;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no idle ACTIVE TCS\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = VR_TCS(t), bit = 1u << t, irqen = VR_TCS_OFF + RH_IRQ_EN;
+	uint32_t irq_en = vr_rd(irqen);
+	if (irq_en == 0xffffffffu || !vr_sync(irqen, irq_en & ~bit)) {
+		vr_poisoned = true;
+		return EIO;
+	}
+	vr_poisoned = true;
+	uint32_t mask = (1u << n) - 1u;
+	for (unsigned c = 0; c < n; ++c) {
+		uint32_t cmd = b + c * vr_cmd_stride;
+		if (!vr_sync(cmd + vr_msgid, RH_WRITE_ACK) ||
+		    !vr_sync(cmd + vr_addr, addrs[c]) ||
+		    !vr_sync(cmd + vr_data, values[c])) {
+			return EIO;
+		}
+	}
+	if (!vr_sync(b + vr_wait, mask) || !vr_sync(b + vr_enable, mask) ||
+	    !vr_sync(b + vr_control, 0) || !vr_sync(b + vr_control, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(vr_drv, b + vr_control, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = vr_rd(VR_TCS_OFF + RH_IRQ_STATUS);
+		idle = vr_rd(b + vr_status);
+		bool complete = true;
+		for (unsigned c = 0; c < n; ++c) {
+			status[c] = vr_rd(b + vr_cmd_status + c * vr_cmd_stride);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: %#x=%#x (+%u) TCS%u done=%d irq=%#x idle=%#x cmd-status=%#x/%#x/%#x\n",
+	    addrs[0], values[0], n - 1u, t, done, irq, idle, status[0], status[1], status[2]);
+	if (!done) {
+		return ETIMEDOUT;
+	}
+	if (!vr_sync(b + vr_control, RH_AMC_EN) || !vr_sync(b + vr_control, 0) ||
+	    !vr_sync(b + vr_enable, 0) || !vr_sync(b + vr_wait, 0)) {
+		return EIO;
+	}
+	rh_write(vr_drv, VR_TCS_OFF + RH_IRQ_CLEAR, bit);
+	if (!vr_sync(irqen, (vr_rd(irqen) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	vr_poisoned = false;
+	return 0;
+}
+
+/* VRM: voltage, mode, enable (rpmh-regulator command order). */
+static int
+vr_send(uint32_t address, unsigned mv, unsigned mode)
+{
+	const uint32_t addrs[3] = {address, address + 8u, address + 4u};
+	const uint32_t values[3] = {mv, mode, 1};
+	return vr_send_cmds(3, addrs, values);
+}
+
+int sweet_rpmh_vrm_enable(uint32_t address, unsigned mv, unsigned mode);
+int sweet_rpmh_bcm_vote(uint32_t address, unsigned x, unsigned y);
+
+/*
+ * BCM vote (icc-rpmh BCM_TCS_CMD: commit 30, valid 29, x << 14, y), e.g.
+ * QUP0 0x5003c: Linux keeps it on (keepalive); without it the QUP0 core
+ * clock may be off and any SE register access stalls the bus.
+ */
+int
+sweet_rpmh_bcm_vote(uint32_t address, unsigned x, unsigned y)
+{
+	if ((address >> 16) != 5u || (address & 3u) || x > 0x3fffu || y > 0x3fffu) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = vr_poisoned ? EIO : vr_map();
+	if (!error) {
+		uint32_t data = (1u << 30) | (1u << 29) | (x << 14) | y;
+		error = vr_send_cmds(1, &address, &data);
+	}
+	if (error) {
+		printf("SWEET RPMH: BCM %#x vote failed errno=%d\n", address, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_rpmh_vrm_enable(uint32_t address, unsigned mv, unsigned mode)
+{
+	if ((address >> 16) != RH_VRM || (address & 15u) || mv < 1000 || mv > 3600 || mode > 7) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = vr_poisoned ? EIO : vr_map();
+	if (!error) {
+		error = vr_send(address, mv, mode);
+	}
+	if (error) {
+		printf("SWEET RPMH: VRM %#x enable failed errno=%d\n", address, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
