+#define VOLCANO_RAMOOPS_DATA    (0x200000u - 12u)
+static volatile uint8_t *volcano_early_log = (volatile uint8_t *)(uintptr_t)VOLCANO_RAMOOPS_PA;
+
+void
+volcano_log_putc(volatile uint8_t *base, char c)
+{
+	volatile uint32_t *h = (volatile uint32_t *)base;
+	if (base == NULL || c == '\r' || h[0] != VOLCANO_RAMOOPS_SIG) {
+		return;
+	}
+	uint32_t n = h[2];
+	if (n >= VOLCANO_RAMOOPS_DATA) {
+		return;
+	}
+	base[12 + n] = (uint8_t)c;
+	h[1] = n + 1;
+	h[2] = n + 1;
