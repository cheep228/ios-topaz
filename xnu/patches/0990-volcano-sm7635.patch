+/* tight watch after a doorbell: last line before a reset shows how far it got */
+static void g_dbg(const char *why) {
+	/* msm_gpi debug regs live at gpi-top (= ee_base + 0x10000) */
+	printf("SWEET TOUCH: gdbg %s busy %#x pc %#x qsb sel %#x err %#x log %#x %#x %#x misc %#x %#x %#x %#x\n", why,
+	    g_rd(0x15010u), g_rd(0x15048u), g_rd(0x15050u), g_rd(0x15060u), g_rd(0x15064u), g_rd(0x15068u), g_rd(0x1506cu),
+	    g_rd(0x15070u), g_rd(0x15074u), g_rd(0x15078u), g_rd(0x1507cu));
+	for (unsigned r = 0; r < 32u; r += 8u)
+		printf("SWEET TOUCH: gdbg %s rf%u: %#x %#x %#x %#x %#x %#x %#x %#x\n", why, r,
+		    g_rd(0x15100u + 4u * r), g_rd(0x15104u + 4u * r), g_rd(0x15108u + 4u * r), g_rd(0x1510cu + 4u * r),
+		    g_rd(0x15110u + 4u * r), g_rd(0x15114u + 4u * r), g_rd(0x15118u + 4u * r), g_rd(0x1511cu + 4u * r));
+}
+static void g_sedump(const char *why) {
+	static const uint32_t rg[][2] = {{0, 0x80}, {0x200, 0x280}, {0x600, 0x660}, {0x800, 0x820}, {0xc00, 0xc60}, {0xd00, 0xd60}, {0xe00, 0xe40}};
+	for (unsigned k = 0; k < sizeof(rg) / sizeof(rg[0]); ++k)
+		for (uint32_t o = rg[k][0]; o < rg[k][1]; o += 16u) {
+			uint32_t a = touch_rd(st.se, o), b = touch_rd(st.se, o + 4), c = touch_rd(st.se, o + 8), d = touch_rd(st.se, o + 12);
+			if (a | b | c | d)
+				printf("SWEET TOUCH: sed %s %03x: %08x %08x %08x %08x\n", why, o, a, b, c, d);
+		}
+}
+static void g_qtb(const char *why) {
+	static const uint32_t pa[2] = {0x171b000u, 0x16f1000u};
+	for (unsigned k = 0; k < 2; ++k) {
+		vm_offset_t q = ml_io_map(pa[k], 0x1000);
+		if (!q) continue;
+		for (unsigned o = 0; o < 0x1000u; o += 16u) {
+			uint32_t a = touch_rd(q, o), b = touch_rd(q, o + 4), c = touch_rd(q, o + 8), d = touch_rd(q, o + 12);
+			if (a | b | c | d)
+				printf("SWEET TOUCH: qtb %s a%u %03x: %08x %08x %08x %08x\n", why, 2u - k, o, a, b, c, d);
+		}
+	}
+}
+static void
+g_watch(const char *why, unsigned n, unsigned us)
+{
+	for (unsigned i = 0; i < n; ++i) {
+		delay(us);
+		printf("SWEET TOUCH: w %s %u: f %#x %#x %#x txrp %#x rxrp %#x ch0 %#x evrp %#x se st %#x mirq %#x sirq %#x dma %#x fsr %#x gfsr %#x\n",
+		    why, i, g_rd(G_CH_CNTXT(0) + 0x50u), g_rd(G_CH_CNTXT(0) + 0x54u), g_rd(G_CH_CNTXT(0) + 0x58u), g_rd(G_CH_CNTXT(0) + 0x10u), g_rd(G_CH_CNTXT(1) + 0x10u), g_rd(G_CH_CNTXT(0)),
+		    g_rd(G_EV_CNTXT + 0x10u), touch_rd(st.se, 0x40u), touch_rd(st.se, 0x610u), touch_rd(st.se, 0x640u),
+		    touch_rd(st.se, 0xc10u),
+		    g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x58) : 0u, g_smmu_gr0 ? touch_rd(g_smmu_gr0, 0x48) : 0u);
+	}
+}
