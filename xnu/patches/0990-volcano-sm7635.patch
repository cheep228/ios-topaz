+	volatile uint8_t *tb = drv + 0xd00, *t0 = tb;
+#define R32(b, o) (*(volatile uint32_t *)((b) + (o)))
+	for (int w = 0; w < 2000 && R32(t0, r_st) == 0; w++) {
+		IODelay(10);
+	}
+	if (R32(t0, r_st) != 0) {
+		uint32_t mask = 0;
+		R32(t0, r_en) = 0;
+		mb();
+		for (uint32_t i = 0; i < n; i++) {
+			R32(t0, r_msg + r_cmdoff * i) = 8u | (1u << 16) | (1u << 8);
+			R32(t0, r_addr + r_cmdoff * i) = a[i];
+			R32(t0, r_data + r_cmdoff * i) = d[i];
+			mask |= 1u << i;
+		}
+		R32(t0, r_wfc) = mask;
+		R32(t0, r_en) = mask;
+		mb();
+		uint32_t c = R32(t0, r_ctl) & ~(1u << 24);
+		R32(t0, r_ctl) = c;
+		mb();
+		c &= ~(1u << 16);
+		R32(t0, r_ctl) = c;
+		mb();
+		R32(t0, r_ctl) = 1u << 16;
+		mb();
+		R32(t0, r_ctl) = (1u << 16) | (1u << 24);
+		mb();
