+		assert_wait_timeout((event_t)&volcano_watch_ev, THREAD_UNINT, 10, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		thread_t t = volcano_watched;
+		if (t == THREAD_NULL) {
