+	}
+	if (error) {
+		printf("VOLCANO UFS: LUN %u: test unit ready %d\n", lun, error);
+		return;
+	}
+	error = ufs_read_blocks(1, 1);
+	if (error == ETIMEDOUT) {
+		(*timeouts)++;
+	}
+	if (error || memcmp(b, "EFI PART", 8) != 0) {
+		printf("VOLCANO UFS: LUN %u: no GPT (%d)\n", lun, error);
+		return;
+	}
+	uint64_t entry_lba, alt;
+	uint32_t nent, esz;
+	memcpy(&alt, b + 32, 8);
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	printf("VOLCANO UFS: LUN %u: GPT, %u entries x %u at %llu, backup %#llx, %llu MiB\n",
+	    lun, nent, esz, entry_lba, alt, (alt + 1) * UFS_BLOCK >> 20);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE ||
+	    ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK) != 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (first == 0 && last == 0) {
+			continue;
+		}
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		printf("VOLCANO UFS: LUN %u #%u %s %#llx+%#llx %llu MiB\n", lun, i, name,
+		    first, last - first + 1, (last - first + 1) * UFS_BLOCK >> 20);
+	}
+}
+
+/*
+ * The UFS Device well-known LU (0xD0 in the UPIU LUN field) takes the power
+ * mode commands. ufsprobe=3 also sends START STOP UNIT with POWER CONDITION
+ * 1h (Active), as Linux does on every resume: a power mode change only, no
+ * medium access.
+ */
+static void
+ufs_probe_wlun(uint32_t mode)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	int error = 0;
+
+	su.lun = 0;                             /* LUN 0 as ABL left it, for the sense data */
+	(void)ufs_scsi(tur, sizeof(tur), 0, false);
+	su.lun = 0xd0;
+	for (int i = 0; i < 3; i++) {
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (error != EIO) {
+			break;
+		}
+	}
+	printf("VOLCANO UFS: device W-LUN: test unit ready %d\n", error);
+	if (mode & 2) {
+		ufs_cmd_timeout_ns = 30ull * NSEC_PER_SEC;
+		for (int i = 0; i < 3; i++) {
+			error = ufs_scsi(ssu, sizeof(ssu), 0, false);
+			if (error != EIO) {
+				break;
+			}
+		}
+		ufs_cmd_timeout_ns = CMD_TIMEOUT_NS;
+		printf("VOLCANO UFS: device W-LUN: start stop unit (active) %d\n", error);
+	}
+}
+
+/*
+ * What ABL left in its own transfer request list (still in RAM): command
+ * type, OCS, LUN, CDB and SCSI status of each used slot. Read only; UCD
+ * addresses outside DRAM are skipped.
+ */
+static void
+ufs_probe_abl(uint64_t list)
+{
+	if (list < 0x80000000ull || list >= 0x240000000ull) {
+		return;
+	}
+	uint64_t base = list & ~(uint64_t)PAGE_MASK;
+	vm_offset_t v = ml_io_map(base, 2 * PAGE_SIZE);
+	const volatile uint32_t *t = (const volatile uint32_t *)(v + (list - base));
+	unsigned shown = 0;
+	for (unsigned slot = 0; slot < 32 && shown < 6; slot++, t += 8) {
+		uint64_t ucd = (uint64_t)t[5] << 32 | (t[4] & ~0x7fu);
+		if (t[0] == 0 || ucd < 0x80000000ull || ucd >= 0x240000000ull) {
+			continue;
+		}
+		uint64_t ub = ucd & ~(uint64_t)PAGE_MASK;
+		vm_offset_t uv = ml_io_map(ub, 2 * PAGE_SIZE);
+		const volatile uint8_t *c = (const volatile uint8_t *)(uv + (ucd - ub));
+		unsigned ro = (t[6] >> 16) * 4;         /* response UPIU offset, DWORDs */
+		if (ro < 32 || ro > 4096) {
+			ro = 512;
+		}
+		printf("VOLCANO UFS: ABL slot %u dw0 %#x ocs %#x: upiu %02x lun %02x cdb %02x %02x %02x %02x %02x %02x"
+		    " -> %02x resp %02x status %02x sense %02x/%02x/%02x\n",
+		    slot, t[0], t[2] & 0xff, c[0], c[2], c[16], c[17], c[18], c[19], c[20], c[21],
+		    c[ro], c[ro + 6], c[ro + 7], c[ro + 36] & 0xf, c[ro + 46], c[ro + 47]);
+		shown++;
+	}
+}
+
+void
+sweet_ufs_probe(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("ufsprobe", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("VOLCANO UFS: no /sweet-ufs node in the device tree\n");
+		return;
+	}
+	printf("VOLCANO UFS: probe of the host at %#lx (read-only)\n", (unsigned long)reg[0]);
+	su.regs = ml_io_map(reg[0], reg[1]);
+	printf("VOLCANO UFS: cap %#x ver %#x hce %#x hcs %#x is %#x ie %#x\n",
+	    ufs_rd(REG_CAP), ufs_rd(0x08), ufs_rd(REG_HCE), ufs_rd(REG_HCS),
+	    ufs_rd(REG_IS), ufs_rd(REG_IE));
+	printf("VOLCANO UFS: utrl %#x:%#x dbr %#x rsr %#x\n",
+	    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLDBR), ufs_rd(REG_UTRLRSR));
+	uint64_t abl_list = (uint64_t)ufs_rd(REG_UTRLBAU) << 32 | (ufs_rd(REG_UTRLBA) & ~0x3ffu);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("VOLCANO UFS: no contiguous DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.secsize = DEV_BSIZE;
+	su.writable = false;
+	printf("VOLCANO UFS: DMA at %#llx\n", su.dma_pa);
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_take_over_host();
+	printf("VOLCANO UFS: take over: %d\n", error);
+	if (!error) {
+		unsigned timeouts = 0;
+		ufs_probe_wlun(on);
+		for (uint8_t lun = 0; lun < 8 && timeouts < 2; lun++) {
+			ufs_probe_lun(lun, &timeouts);
+		}
+	}
+	su.lun = 0;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	ufs_probe_abl(abl_list);
+	printf("VOLCANO UFS: probe done\n");
+}
+#endif /* VOLCANO */
