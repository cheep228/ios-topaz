+void
+volcano_log_putc(volatile uint8_t *base, char c)
+{
+	volatile uint32_t *h = (volatile uint32_t *)base;
+	if (base == NULL || c == '\r' || h[0] != VOLCANO_RAMOOPS_SIG) {
+		return;
+	}
+	uint32_t n = h[2];
+	if (n >= VOLCANO_RAMOOPS_DATA) {
+		return;
+	}
+	base[12 + n] = (uint8_t)c;
+	/*
+	 * start = 0: Linux then reads data[0..size) as-is. With start == size a
+	 * single bit flipped in start during the warm reset (seen: 11251 vs
+	 * 12275) makes start > size and Linux drops the whole record.
+	 */
+	h[1] = 0;
+	h[2] = n + 1;
