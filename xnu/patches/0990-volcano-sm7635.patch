+/* ---------------- ath11k DP (volcano / WCN6750): dp.c, dp_rx.c, hal.c */
+#define DP_REO              0x00a38000u         /* HAL_SEQ_WCSS_UMAC_REO_REG */
+#define DP_TCL              0x00a44000u
+#define DP_WBM              0x00a34000u
+#define DP_RBM_IDLE_DESC    1                   /* HAL_RX_BUF_RBM_WBM_IDLE_DESC_LIST */
+#define DP_RBM_SW1          4                   /* wcn6750 rx_buf_rbm = HAL_RX_BUF_RBM_SW1_BM (ath11k hw.c) */
+#define DP_RBM_SW0          3                   /* tcl0 -> wbm0 tx completions (tcl2wbm_rbm_map) */
+#define DP_N_LINK           8192
+#define DP_REFILL_POST (DP_N_REFILL - 1)
+#define DP_N_REFILL         1024
+#define DP_N_MON            128
+#define DP_BUF              2048
+#define DP_LMAC0            111                 /* HAL_SRNG_RING_ID_LMAC1_ID_START */
+
+struct dp_ring {
+	volatile uint32_t *va;
+	uint64_t pa;
+	uint32_t words, n, id, idx;                 /* entry words, entries, hal ring id, sw HP (src) / TP (dst) */
+	uint32_t ptr_reg;                           /* UMAC HP (src) / TP (dst) register */
+	uint32_t cnt;
+};
+
+static volatile uint32_t *dp_rdp, *dp_wrp;      /* hal rdp (HW-written ptrs) / wrp (host-written LMAC ptrs) */
+static uint64_t dp_rdp_pa, dp_wrp_pa;
+static struct dp_ring dp_reo[4], dp_reo_exc, dp_reo_reinj, dp_reo_cmd, dp_reo_sts, dp_tcl0, dp_tcl_cmd, dp_tcl_sts,
+    dp_idle, dp_sw2wbm, dp_wbm0, dp_wbm1, dp_wbm2, dp_wbm4, dp_rxrel, dp_refill, dp_macbuf, dp_rxerr, dp_mon, dp_macbuf1, dp_rxerr1;
+static uint8_t *dp_rxb, *dp_monb;
+static uint64_t dp_rxb_pa, dp_monb_pa;
+static bool dp_up;
+static uint32_t dp_stat_ms, dp_recycled, dp_bad, dp_mon_reap, dp_mon_cnt;
+
+static bool
+dp_alloc(struct dp_ring *r, uint32_t words, uint32_t n, uint32_t id)
+{
+	r->va = (volatile uint32_t *)pool_alloc((uint64_t)words * 4 * n, &r->pa);
+	r->words = words;
+	r->n = n;
+	r->id = id;
+	r->idx = 0;
+	r->cnt = 0;
+	r->ptr_reg = 0;
+	return r->va != NULL;
+}
+
+/* hal_srng_src_hw_init: TCL1 layout (msb +4, id +8, misc +0x10, tp_addr +0x1c/+0x20, int +0x30/+0x34) */
+static void
+dp_src_hw(struct dp_ring *r, uint32_t r0, uint32_t r2, bool idle)
+{
+	w_v_wr(r0 + 0x00, (uint32_t)r->pa);
+	w_v_wr(r0 + 0x04, ((uint32_t)(r->pa >> 32) & 0xFF) | ((r->words * r->n) << 8));
+	w_v_wr(r0 + 0x08, r->words);
+	w_v_wr(r0 + 0x30, 0);
+	w_v_wr(r0 + 0x34, 0);
+	if (!idle) {
+		uint64_t tp = dp_rdp_pa + 4 * r->id;
+		w_v_wr(r0 + 0x1c, (uint32_t)tp);
+		w_v_wr(r0 + 0x20, (uint32_t)(tp >> 32));
+	}
+	w_v_wr(r2, 0);
+	w_v_wr(r2 + 4, 0);
+	dp_rdp[r->id] = 0;
+	w_v_wr(r0 + 0x10, (1u << 1) | (1u << 6));  /* MSI loopcnt disable | SRNG enable */
+	r->ptr_reg = r2;
+}
+
+/* hal_srng_dst_hw_init: REO1 layout; HP lands in rdp[ring_id], TP register = HP + 4 */
+static void
+dp_dst_hw(struct dp_ring *r, uint32_t r0, uint32_t r2)
+{
+	dp_rdp[r->id] = 0;
+	vce_dst_init(r0, r2, r->pa, r->words, r->n, r->id, dp_rdp_pa + 4 * r->id);
+	r->ptr_reg = r2 + 4;
+}
+
+static void
+dp_buf_info(volatile uint32_t *e, uint64_t pa, uint32_t cookie, uint32_t rbm)
+{
+	e[0] = (uint32_t)pa;
+	e[1] = ((uint32_t)(pa >> 32) & 0xFF) | (rbm << 8) | (cookie << 11);
+}
+
+/* host-filled LMAC src ring (HP in wrp, TP from fw in rdp) */
+static bool
+dp_lmac_post(struct dp_ring *r, uint64_t pa, uint32_t cookie)
+{
+	uint32_t tp = (dp_rdp[r->id] / r->words) % r->n;
+	uint32_t nx = (r->idx + 1) % r->n;
+	if (nx == tp) {
+		return false;
+	}
+	dp_buf_info(r->va + r->words * r->idx, pa, cookie, DP_RBM_SW1);
+	r->idx = nx;
+	return true;
+}
+
+static void
+dp_lmac_publish(struct dp_ring *r)
+{
+	mb();
+	dp_wrp[r->id - DP_LMAC0] = r->idx * r->words;
+	mb();
+}
