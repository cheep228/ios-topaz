+{
+	if (!su_next) {
+		*run = su.nblocks - lblk;
+		return su.first_block + lblk;
+	}
+	unsigned lo = 0, hi = su_next;
+	while (hi - lo > 1) {
+		unsigned mid = (lo + hi) / 2;
+		if (su_ext[mid].lblk <= lblk) {
+			lo = mid;
+		} else {
+			hi = mid;
+		}
+	}
+	const struct ufs_ext *e = &su_ext[lo];
+	*run = e->n - (lblk - e->lblk);
+	return su.first_block + e->pblk + (lblk - e->lblk);
+}
+
+/* With extents: is [lba, lba + count) entirely inside one of them? */
+static bool
+ufs_in_extent(uint64_t lba, uint32_t count)
+{
+	if (!su_next) {
+		return true;
+	}
+	uint64_t pb = lba - su.first_block;
+	for (unsigned i = 0; i < su_next; i++) {
+		if (pb >= su_ext[i].pblk && pb - su_ext[i].pblk < su_ext[i].n) {
+			return count <= su_ext[i].n - (pb - su_ext[i].pblk);
+		}
+	}
+	return false;
+}
+
+/* Load and check "root-extents"; called with the partition known. */
+static int
+ufs_load_extents(DTEntry node)
+{
+	const uint64_t *v = NULL;
+	unsigned int size = 0;
+	if (SecureDTGetProperty(node, "root-extents", (void const **)&v, &size) != kSuccess) {
+		return 0;
+	}
+	if (size == 0 || size % 24 || size / 24 > UFS_MAX_EXT) {
+		printf("SWEET UFS: root-extents: bad size %u\n", size);
+		return EINVAL;
+	}
+	unsigned n = size / 24;
+	uint64_t next = 0;
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t l = v[3 * i], pb = v[3 * i + 1], c = v[3 * i + 2];
+		if (l != next || c == 0 || pb >= su.nblocks || c > su.nblocks - pb) {
+			printf("SWEET UFS: root-extents[%u] %#llx %#llx %#llx out of order or outside the partition\n",
+			    i, l, pb, c);
+			return EINVAL;
+		}
+		su_ext[i] = (struct ufs_ext){ l, pb, c };
+		next = l + c;
+	}
+	/* no two extents may share a block */
+	for (unsigned i = 0; i < n; i++) {
+		for (unsigned j = i + 1; j < n; j++) {
+			if (su_ext[i].pblk < su_ext[j].pblk + su_ext[j].n &&
+			    su_ext[j].pblk < su_ext[i].pblk + su_ext[i].n) {
+				printf("SWEET UFS: root-extents %u and %u overlap\n", i, j);
+				return EINVAL;
+			}
+		}
+	}
+	su_next = n;
+	su.size_blocks = next;
+	printf("SWEET UFS: root is %u extents, %llu MiB of the partition\n", n, next * UFS_BLOCK >> 20);
+	return 0;
+}
