+/* fix68: host TX on TCL data ring 0 (ath11k dp_tx.c), completions on WBM ring 106 (rbm SW0_BM) */
+#define DTX_SLOTS 32
+#define DTX_COOKIE0 0x4000u
+static uint8_t *dtx_pool;
+static uint64_t dtx_pool_pa;
+static uint32_t dtx_busy, dtx_sent, dtx_done, dtx_full;
+static int dtx_last = -1;
+static uint32_t dp_rx_msdus, dp_rx_logged;
+static volatile bool s_peer_map;
+static uint32_t s_peer_id;
+static void w_rx_native(const uint8_t *f, uint32_t len);
+static void w_rx_ether(const uint8_t *e, uint32_t len);
+
+static void
+w_hex(char *o, size_t osz, const uint8_t *p, uint32_t n)
+{
+	size_t k = 0;
+	o[0] = 0;
+	for (uint32_t i = 0; i < n && k + 3 < osz; i++) {
+		k += (size_t)snprintf(o + k, osz - k, "%02x", p[i]);
+	}
+}
