+/*
+ * volcano (Nothing Phone 3a, SM7635): FocalTech FT3681 (chip id 56:72,
+ * Android focaltech_fts V4.2) on QUP0 SE0 SPI at 0xa80000, mode 0, 8 bit.
+ * IRQ GPIO19 (low = report pending), reset GPIO20, SPI on GPIO0..3 function 1
+ * (pinctrl-milos.c). Power: RPMh ldob22 3.3 V (vci) and ldob11 1.8 V (vddio),
+ * dedicated to the touch IC (regulator_summary). Clocks: gcc-milos.c QUP0
+ * wrapper/S0 votes in 0x52008 bits 18..22, S0 RCG 0x18010 runs DFS, so the SE
+ * picks a level in SE_CLK_SEL. Bus protocol: focaltech_spi_v2.c, full-duplex
+ * [addr, 0xa0 read+crc | 0x00 write, len hi, len lo, 3 dummy, data, crc16].
+ * Reports: focaltech_core.c, read 84 bytes at 0x01; byte 1 = type << 4 | n,
+ * type 0: 6-byte records from 2, type 2: 8-byte records from 4 (1/16 px).
+ * Every report lists all contacts; a contact missing from it is lifted.
+ */
+#define V_SE_PA          0x00a80000u
+#define V_GCC_PA         0x00100000u
+#define V_TLMM_PA        0x0f100000u /* TLMM 0xf000000 + REG_BASE 0x100000 (pinctrl-volcano) */
+#define V_GCC_VOTE       0x52008u
+#define V_GCC_BITS       (0x1fu << 18)
+#define V_S0_CBCR        0x18004u
+#define V_S0_RCG         0x18010u
+#define V_PIN_IRQ        19u
+#define V_PIN_RESET      20u
+#define V_VRM_VCI        0x42800u        /* ldob22 */
+#define V_VRM_VDDIO      0x40a00u        /* ldob11 */
+#define V_SPI_CPHA       0x224u
+#define V_SPI_LOOPBACK   0x22cu
+#define V_SPI_CPOL       0x230u
+#define V_SPI_INV        0x24cu
+#define V_SPI_DEMUX      0x250u
+#define V_SPI_TRANS_CFG  0x25cu
+#define V_SPI_WORD_LEN   0x268u
+#define V_SPI_TX_LEN     0x26cu
+#define V_SPI_RX_LEN     0x270u
+#define V_SPI_DELAY      0x278u
+#define V_SPI_TX_RX      7u
+#define V_ERRORS         (0x0eu | (3u << 24) | (3u << 28))
+#define V_FRAME          84u
+#define V_SCLK_MAX       6000000u
+
+extern int sweet_rpmh_vrm_enable(uint32_t address, unsigned mv, unsigned mode);
+extern int sweet_rpmh_bcm_vote(uint32_t address, unsigned x, unsigned y);
+#define V_BCM_QUP0       0x5003cu        /* cmd-db "QUP0" (clk_virt qup0_core) */
+#define V_BCM_QUP0_VOTE  3840u           /* GENI 76.8 MB/s, width 4 / unit 20 */
+
+/*
+ * A bus stall freezes the only CPU and ramoops loses the last ~1 KiB, so
+ * after each stage line push it out of that window (sweetfb_noconsole).
+ */
+static void
+v_mark(const char *stage)
+{
+	static char pad[1281];
+	if (!pad[0]) {
+		for (unsigned i = 0; i < 1280; ++i) {
+			pad[i] = (i % 80u) == 79u ? '\n' : ' ';
+		}
+	}
+	st.stage = stage;
+	printf("SWEET TOUCH: stage %s\n%s", stage, pad);
+}
+
+static struct {
+	vm_offset_t tlmm;
+	unsigned depth;
+	unsigned level, div, se_hz;
+	uint8_t status;
+	unsigned frames, ff, crc, errs, busy, irqlow, reads;
+	uint8_t raw[16];
+	int rawn;
+} vt;
+
+static unsigned
+v_level_hz(uint32_t cfg, uint32_t m, uint32_t n)
+{
+	static const unsigned parent[8] = {19200000u, 600000000u, 0, 0, 0, 0, 300000000u, 0};
+	unsigned src = (cfg >> 8) & 7u, div = cfg & 31u;
+	uint64_t hz = parent[src];
+	if (div) {
+		hz = hz * 2u / (div + 1u);
+	}
+	if ((cfg >> 12) & 3u) {
+		m &= 0xffffu;
+		n = (~n + m) & 0xffffu;
+		if (!m || !n) {
+			return 0;
+		}
+		hz = hz * m / n;
+	}
+	return (unsigned)hz;
+}
+
+static bool
+v_clocks(void)
+{
+	uint32_t vote = touch_rd(st.gcc, V_GCC_VOTE);
+	touch_wr(st.gcc, V_GCC_VOTE, vote | V_GCC_BITS);
+	st.d_vote = touch_rd(st.gcc, V_GCC_VOTE);
+	bool on = false;
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (!(touch_rd(st.gcc, V_S0_CBCR) & (1u << 31))) {
+			on = true;
+			break;
+		}
+		delay(1);
+	}
+	st.d_cbcr = touch_rd(st.gcc, V_S0_CBCR);
+	st.d_cfg = touch_rd(st.gcc, V_S0_RCG + 4u);
+	uint32_t dfs = touch_rd(st.gcc, V_S0_RCG + 0x14u);
+	printf("SWEET TOUCH: gcc vote %#x -> %#x s0 cbcr=%#x rcg=%#x cfg=%#x dfs=%#x m/s ahb=%#x/%#x core=%#x/%#x\n",
+	    vote, st.d_vote, st.d_cbcr, touch_rd(st.gcc, V_S0_RCG), st.d_cfg, dfs,
+	    touch_rd(st.gcc, 0x23000), touch_rd(st.gcc, 0x23004),
+	    touch_rd(st.gcc, 0x23008), touch_rd(st.gcc, 0x23018));
+	if (!on) {
+		printf("SWEET TOUCH: QUP0 S0 branch stays off\n");
+		return false;
+	}
+	/* DFS levels: pick the slowest usable one, the divider does the rest. */
+	vt.se_hz = 0;
+	vt.level = 0;
+	for (unsigned l = 0; l < 8; ++l) {
+		uint32_t cfg = touch_rd(st.gcc, V_S0_RCG + 0x1cu + 4u * l);
+		uint32_t m = touch_rd(st.gcc, V_S0_RCG + 0x5cu + 4u * l);
+		uint32_t n = touch_rd(st.gcc, V_S0_RCG + 0x9cu + 4u * l);
+		unsigned hz = (dfs & 1u) ? v_level_hz(cfg, m, n) : 0;
+		printf("SWEET TOUCH: dfs level %u cfg=%#x m=%#x n=%#x -> %u Hz\n", l, cfg, m, n, hz);
+		if (hz >= 1000000u && (!vt.se_hz || hz < vt.se_hz)) {
+			vt.se_hz = hz;
+			vt.level = l;
+		}
+	}
+	if (!vt.se_hz) {
+		/* not DFS: the RCG as left by the boot chain, assume up to 120 MHz */
+		vt.se_hz = v_level_hz(st.d_cfg, touch_rd(st.gcc, V_S0_RCG + 8u),
+		    touch_rd(st.gcc, V_S0_RCG + 12u));
+		if (!vt.se_hz) {
+			vt.se_hz = 120000000u;
+		}
+	}
+	vt.div = (vt.se_hz + V_SCLK_MAX - 1u) / V_SCLK_MAX;
+	if (vt.div < 1u) {
+		vt.div = 1u;
+	}
+	if (vt.div > 255u) {
+		vt.div = 255u;
+	}
+	if (dfs & 1u) {
+		/* Android: "setup_config0_tre: ... freq 12000000 idx 2 div 4" */
+		vt.level = 2u;
+		vt.se_hz = 48000000u;
+		vt.div = 4u;
+	}
+	printf("SWEET TOUCH: SE0 clock level %u = %u Hz, div %u -> SCLK %u Hz\n",
+	    vt.level, vt.se_hz, vt.div, vt.se_hz / vt.div);
+	return true;
+}
+
+/*
+ * volcano SE0 has its FIFO interface fused off (GENI_IF_DISABLE_RO = 1), so
+ * the only data path is GSI: QUP0 GPI DMA at 0xa00000, ee-offset 0x10000
+ * (gpi.c: ee_base = regs - ee_offset), HLOS GPIIs 1..5. One GPII, polled
+ * (its GIC line stays masked), TX channel 0 / RX channel 1, one event ring.
+ * Ring layout and TREs follow gpi.c / spi-geni-qcom.c setup_gsi_xfer().
+ */
+#define V_GPI_PA         0x00a00000u
+#define V_GPI_SIZE       0x60000u
+#define V_GPI_EE         0x10000u
+#define V_GPII           0u      /* Android: static GPII 0 for SE0 SPI */
+#define G_N              (0x4000u * V_GPII)
+#define G_CH_CNTXT(k)    (0x20000u + G_N + 0x80u * (k))
+#define G_CH_QOS(k)      (0x2005cu + G_N + 0x80u * (k))
+#define G_CH_SCR(k, i)   (0x20060u + G_N + 0x80u * (k) + 4u * (i))
+#define G_EV_CNTXT       (0x21000u + G_N)
+#define G_CH_DB(k)       (0x22000u + G_N + 8u * (k))
+#define G_EV_DB          (0x22100u + G_N)
+#define G_CH_CMD         (0x23008u + G_N)
+#define G_EV_CMD         (0x23010u + G_N)
+#define G_TYPE_IRQ       (0x23080u + G_N)
+#define G_TYPE_MSK       (0x23088u + G_N)
+#define G_SRC_CH         (0x23090u + G_N)
+#define G_SRC_EV         (0x23094u + G_N)
+#define G_SRC_CH_MSK     (0x23098u + G_N)
+#define G_SRC_EV_MSK     (0x2309cu + G_N)
+#define G_SRC_CH_CLR     (0x230a0u + G_N)
+#define G_SRC_EV_CLR     (0x230a4u + G_N)
+#define G_IEOB_MSK       (0x230b8u + G_N)
+#define G_IEOB_CLR       (0x230c0u + G_N)
+#define G_GLOB_STTS      (0x23100u + G_N)
+#define G_GLOB_EN        (0x23108u + G_N)
+#define G_GLOB_CLR       (0x23110u + G_N)
+#define G_GPII_STTS      (0x23118u + G_N)
+#define G_GPII_EN        (0x23120u + G_N)
+#define G_GPII_CLR       (0x23128u + G_N)
+#define G_INTSET         (0x23180u + G_N)
+#define G_ERRLOG         (0x23200u + G_N)
+#define G_EL             16u
+#define G_EV_N           128u
+#define G_CH_N           64u
+#define G_OFF_EV         0x0000u
+#define G_OFF_TX         0x0800u
+#define G_OFF_RX         0x0c00u
+#define G_OFF_TXB        0x1000u
+#define G_OFF_RXB        0x2000u
+#define G_BUF_MAX        0x1000u
+#define G_DMA_SIZE       0x8000u /* 0x4000.. : SMMU stage-1 tables */
+#define G_OFF_PT         0x4000u
+#define TRE_CHAIN        (1u << 0)
+#define TRE_IEOB         (1u << 8)
+#define TRE_IEOT         (1u << 9)
+#define TRE_LINK         (1u << 11)
+#define TRE_TYPE(t)      ((uint32_t)(t) << 16)
+
+static struct {
+	bool on;
+	vm_offset_t regs;       /* ee_base: mapping - V_GPI_EE */
+	vm_offset_t dma;
+	uint64_t pa;
+	uint64_t da;     /* address the GPI uses: 32-bit IOVA via our S1 CB, else pa */
+	unsigned ev_rp, tx_wp, rx_wp;   /* element indexes */
+	unsigned xfers, fails, logged;
+} vg;
+
+static uint32_t
+g_rd(uint32_t off)
+{
+	return touch_rd(vg.regs, off);
+}
+
+static void
+g_wr(uint32_t off, uint32_t v)
+{
+	touch_wr(vg.regs, off, v);
+}
+
+static void
+g_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(vg.pa + off), len, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static unsigned
+g_ch_state(unsigned k)
+{
+	return (g_rd(G_CH_CNTXT(k)) >> 20) & 0xfu;
+}
+
+static unsigned
+g_ev_state(void)
+{
+	return (g_rd(G_EV_CNTXT) >> 20) & 0xfu;
+}
+
+static void
+g_dump(const char *why)
+{
+	printf("SWEET TOUCH: gpi %s: ch0 %#x rp %#x ch1 %#x rp %#x ev %#x rp %#x type %#x src ch %#x ev %#x glob %#x gpii %#x err %#x\n",
+	    why, g_rd(G_CH_CNTXT(0)), g_rd(G_CH_CNTXT(0) + 0x10u),
+	    g_rd(G_CH_CNTXT(1)), g_rd(G_CH_CNTXT(1) + 0x10u),
+	    g_rd(G_EV_CNTXT), g_rd(G_EV_CNTXT + 0x10u),
+	    g_rd(G_TYPE_IRQ), g_rd(G_SRC_CH), g_rd(G_SRC_EV),
+	    g_rd(G_GLOB_STTS), g_rd(G_GPII_STTS), g_rd(G_ERRLOG));
+}
+
+/* commands complete by a state change in the context (gpi_cmd_info[]) */
+static bool
+g_cmd(bool ev, unsigned k, unsigned op, unsigned want)
+{
+	if (ev) {
+		g_wr(G_EV_CMD, (op << 24) | 0u);
+	} else {
+		g_wr(G_CH_CMD, (op << 24) | k);
+	}
+	for (unsigned i = 0; i < 20000; ++i) {
+		unsigned s = ev ? g_ev_state() : g_ch_state(k);
+		if (want == 0xffu || s == want) {
+			if (want == 0xffu) {
+				delay(100);
+			}
+			g_wr(G_SRC_CH_CLR, 3u);
+			g_wr(G_SRC_EV_CLR, 1u);
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET TOUCH: gpi cmd %s%u op %u: state %u, want %u\n",
+	    ev ? "ev" : "ch", k, op, ev ? g_ev_state() : g_ch_state(k), want);
+	g_dump("cmd timeout");
+	return false;
+}
+
+static void
+g_ev_db(void)
+{
+	/* the ring is "full" of free event slots up to one before our RP */
+	unsigned wp = (vg.ev_rp + G_EV_N - 1u) % G_EV_N;
+	g_wr(G_EV_DB, (uint32_t)(vg.da + G_OFF_EV + wp * G_EL));
+}
+
+/*
+ * apps SMMU (qsmmu-v500 = SMMUv2 programming model) at 0x15000000. UFS
+ * (SID 0x60) works under XNU, GPI is SID 0x576 (DT iommus). Run 32 reset
+ * the SoC on the first GPI transfer: an unmatched stream with USFCFG=1 is a
+ * global fault. If nothing matches 0x576, add a bypass stream mapping.
+ */
+#define V_SMMU_PA        0x15000000u
+#define V_GPI_SID        0x576u
+
+static bool g_smmu_fault;
+static vm_offset_t g_smmu_gr0, g_smmu_cbr;
+static unsigned g_smmu_smri = 0xffffu;
+static int sweet_gpi_iova = 1;
+static unsigned g_smmu_cb = 0xffffu;
+
+/*
+ * Android puts SID 0x576 in a context bank of its own with stage-1 tables
+ * (SMR 4 -> S2CR 0x304 -> CB4, IOVA 0x1d9000..). Sharing the UFS bank with
+ * S1 bypass resets the SoC on the first GPI fetch (run 42: an RX doorbell
+ * alone). Do what Android does: a free CB, identity-mapped 4K tables over
+ * our DMA block, MAIR attr0 = Normal non-cacheable (we clean by hand).
+ */
+static bool
+g_smmu_s1(vm_offset_t s, uint32_t pg, uint32_t np, unsigned ncb, unsigned nsmr, unsigned *cbo)
+{
+	uint8_t used[128] = {0};
+	for (unsigned i = 0; i < nsmr; ++i) {
+		uint32_t smr = touch_rd(s, 0x800u + 4u * i), s2cr = touch_rd(s, 0xc00u + 4u * i);
+		printf("SWEET TOUCH: smmu smr %u = %#x s2cr %#x\n", i, smr, s2cr);
+		if ((smr >> 31) && ((s2cr >> 16) & 3u) == 0u) {
+			used[s2cr & 0x7fu] = 1;
+		}
+	}
+	unsigned cb = 0xffffu;
+	for (unsigned i = 1; i < ncb && i < 128u; ++i) {
+		if (!used[i]) {
+			cb = i;
+			break;
+		}
+	}
+	if (cb == 0xffffu) {
+		printf("SWEET TOUCH: smmu no free context bank\n");
+		return false;
+	}
+	uint64_t pa = vg.pa;
+	if ((pa >> 21) != ((pa + G_DMA_SIZE - 1u) >> 21) || (pa >> 36)) {
+		printf("SWEET TOUCH: smmu dma block %#llx crosses 2M or >36 bit\n", pa);
+		return false;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)(vg.dma + G_OFF_PT);
+	volatile uint64_t *l2 = (volatile uint64_t *)(vg.dma + G_OFF_PT + 0x1000u);
+	volatile uint64_t *l3 = (volatile uint64_t *)(vg.dma + G_OFF_PT + 0x2000u);
+	uint64_t pt = pa + G_OFF_PT;
+	for (unsigned i = 0; i < 512u * 3u; ++i) {
+		l1[i] = 0;
+	}
+	l1[(pa >> 30) & 0x3fu] = (pt + 0x1000u) | 3u;
+	l2[(pa >> 21) & 0x1ffu] = (pt + 0x2000u) | 3u;
+	for (uint64_t a = pa; a < pa + G_DMA_SIZE; a += 0x1000u) {
+		/* page | AttrIndx 0 | AP=01 (rw) | AF */
+		l3[(a >> 12) & 0x1ffu] = a | 3u | (1u << 2) | (1u << 6) | (3u << 8) | (1u << 10);  /* WB (attr1) ISH, as Android */
+	}
+	/*
+	 * Run 46: Android hands the GPI 32-bit IOVAs (rings at 0x1db000);
+	 * ours were 36-bit PAs and the GPI never fetched a TRE. Also map
+	 * the block at IOVA 0x40000000 + (pa & 0x1fffff) and use that.
+	 */
+	uint64_t da = 0x40000000ull | (pa & 0x1fffffull);
+	if (sweet_gpi_iova) {
+		l1[(da >> 30) & 0x3fu] = (pt + 0x3000u) | 3u;
+		volatile uint64_t *m2 = (volatile uint64_t *)(vg.dma + G_OFF_PT + 0x3000u);
+		for (unsigned i = 0; i < 512u; ++i) {
+			m2[i] = 0;
+		}
+		m2[(da >> 21) & 0x1ffu] = (pt + 0x2000u) | 3u;  /* same L3: offsets within 2M match */
+	}
+	flush_dcache64((addr64_t)pt, 0x4000u, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	vm_offset_t g1 = ml_io_map(V_SMMU_PA + pg, 0x1000);
+	vm_offset_t c = ml_io_map(V_SMMU_PA + (np + cb) * pg, 0x1000);
+	if (!g1 || !c) {
+		return false;
+	}
+	printf("SWEET TOUCH: smmu cb%u before: cbar=%#x sctlr=%#x\n", cb, touch_rd(g1, 4u * cb), touch_rd(c, 0));
+	touch_wr(c, 0x0, 0);                            /* SCTLR off while programming */
+	touch_wr(g1, 0x800u + 4u * cb, 1u);              /* CBA2R: VA64 */
+	touch_wr(g1, 4u * cb, 0x0001f300u);             /* CBAR: S1, WB memattr, NSH (as Android) */
+	touch_wr(c, 0x10, (7u << 15) | 2u);              /* TCR2: SEP upstream, PASize 40 */
+	touch_wr(c, 0x38, 0xf404ff44u);                  /* MAIR0: NC, WB, device */
+	touch_wr(c, 0x3c, 0);
+	touch_wr(c, 0x20, (uint32_t)pt);                 /* TTBR0, ASID 0 */
+	touch_wr(c, 0x24, (uint32_t)(pt >> 32));
+	touch_wr(c, 0x28, 0);
+	touch_wr(c, 0x2c, 0);
+	touch_wr(c, 0x30, 0x0080351cu);  /* Android CB4: WBWA ISH walks */             /* TCR: T0SZ 28 (36 bit), 4K, NC walks, EPD1 */
+	touch_wr(c, 0x58, 0xffffffffu);                  /* clear FSR */
+	touch_wr(c, 0x618, 0);                           /* TLBIALL */
+	touch_wr(c, 0x7f0, 0);                           /* TLBSYNC */
+	for (unsigned i = 0; i < 1000 && (touch_rd(c, 0x7f4) & 1u); ++i) {
+		delay(1);
+	}
+	touch_wr(c, 0x4, 3u);                           /* ACTLR as Android CB4 */
+	touch_wr(c, 0x0, 0x0a5f0067u);                   /* Android CB4 SCTLR minus stall */                         /* M TRE AFE CFRE CFIE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET TOUCH: smmu cb%u s1: cbar=%#x cba2r=%#x sctlr=%#x tcr=%#x tcr2=%#x ttbr0=%#x_%08x mair=%#x fsr=%#x pte=%#llx\n",
+	    cb, touch_rd(g1, 4u * cb), touch_rd(g1, 0x800u + 4u * cb), touch_rd(c, 0), touch_rd(c, 0x30),
+	    touch_rd(c, 0x10), touch_rd(c, 0x24), touch_rd(c, 0x20), touch_rd(c, 0x38), touch_rd(c, 0x58),
+	    (unsigned long long)l3[(pa >> 12) & 0x1ffu]);
+	g_smmu_cbr = c;
+	g_smmu_cb = cb;
+	*cbo = cb;
+	if (sweet_gpi_iova) {
+		vg.da = da;
+		printf("SWEET TOUCH: gpi uses iova %#llx for pa %#llx\n", da, pa);
+	}
+	return true;
+}
+
+static void
+g_smmu_poll(const char *why)
+{
+	if (!g_smmu_gr0) {
+		return;
+	}
+	printf("SWEET TOUCH: smmu %s: gfsr=%#x gfsynr0=%#x gfsynr1=%#x cb%u fsr=%#x far=%#x_%08x fsynr0=%#x\n", why,
+	    touch_rd(g_smmu_gr0, 0x48), touch_rd(g_smmu_gr0, 0x50), touch_rd(g_smmu_gr0, 0x54), g_smmu_cb,
+	    g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x58) : 0u, g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x64) : 0u,
+	    g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x60) : 0u, g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x68) : 0u);
+}
