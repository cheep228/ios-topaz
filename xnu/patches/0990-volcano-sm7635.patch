+}
+static void
+g_watch(const char *why, unsigned n, unsigned us)
+{
+	for (unsigned i = 0; i < n; ++i) {
+		delay(us);
+		printf("SWEET TOUCH: w %s %u: f %#x %#x %#x txrp %#x rxrp %#x ch0 %#x evrp %#x se st %#x mirq %#x sirq %#x dma %#x fsr %#x gfsr %#x\n",
+		    why, i, g_rd(G_CH_CNTXT(0) + 0x50u), g_rd(G_CH_CNTXT(0) + 0x54u), g_rd(G_CH_CNTXT(0) + 0x58u), g_rd(G_CH_CNTXT(0) + 0x10u), g_rd(G_CH_CNTXT(1) + 0x10u), g_rd(G_CH_CNTXT(0)),
+		    g_rd(G_EV_CNTXT + 0x10u), touch_rd(st.se, 0x40u), touch_rd(st.se, 0x610u), touch_rd(st.se, 0x640u),
+		    touch_rd(st.se, 0xc10u),
+		    g_smmu_cbr ? touch_rd(g_smmu_cbr, 0x58) : 0u, g_smmu_gr0 ? touch_rd(g_smmu_gr0, 0x48) : 0u);
+	}
+}
+
+static void
+g_smmu(void)
+{
+	vm_offset_t s = ml_io_map(V_SMMU_PA, 0x1000);
+	if (!s) {
+		return;
+	}
+	v_mark("smmu read");
+	uint32_t cr0 = touch_rd(s, 0x0), idr0 = touch_rd(s, 0x20), gfsr = touch_rd(s, 0x48);
+	{
+		uint32_t idr1 = touch_rd(s, 0x24);
+		uint32_t pg = (idr1 >> 31) ? 0x10000u : 0x1000u;
+		uint32_t np = 1u << (((idr1 >> 28) & 7u) + 1u);
+		vm_offset_t g1 = ml_io_map(V_SMMU_PA + pg, 0x1000);
+		vm_offset_t c0 = ml_io_map(V_SMMU_PA + np * pg, 0x1000);
+		printf("SWEET TOUCH: smmu idr1=%#x pg=%#x np=%u ncb=%u\n", idr1, pg, np, idr1 & 0xffu);
+		if (g1 && c0) {
+			printf("SWEET TOUCH: smmu cb0 cbar=%#x cba2r=%#x sctlr=%#x tcr=%#x ttbr0=%#x_%08x fsr=%#x far=%#x_%08x\n",
+			    touch_rd(g1, 0x0), touch_rd(g1, 0x800), touch_rd(c0, 0x0), touch_rd(c0, 0x30),
+			    touch_rd(c0, 0x24), touch_rd(c0, 0x20), touch_rd(c0, 0x58), touch_rd(c0, 0x64), touch_rd(c0, 0x60));
+		}
+	}
+	unsigned n = idr0 & 0xffu, used = 0, freei = 0xffffu, hit = 0xffffu, ufs = 0xffffu;
+	bool exids = (cr0 >> 3) & 1u;
+	if (n > 128u) {
+		n = 128u;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		uint32_t smr = touch_rd(s, 0x800u + 4u * i), s2cr = touch_rd(s, 0xc00u + 4u * i);
+		bool valid = exids ? ((s2cr >> 10) & 1u) : (smr >> 31);
+		uint32_t id = smr & (exids ? 0xffffu : 0x7fffu), mask = (smr >> 16) & (exids ? 0xffffu : 0x7fffu);
+		if (!valid) {
+			if (freei == 0xffffu) {
+				freei = i;
+			}
+			continue;
+		}
+		used++;
+		if (((V_GPI_SID ^ id) & ~mask) == 0) {
+			hit = i;
+		}
+		if (((0x60u ^ id) & ~mask) == 0) {
+			ufs = i;
+		}
+	}
+	printf("SWEET TOUCH: smmu cr0=%#x idr0=%#x gfsr=%#x gfsynr0=%#x smrs %u used %u free %u exids %d ufs %u%s gpi %u\n",
+	    cr0, idr0, gfsr, touch_rd(s, 0x50), n, used, freei, exids, ufs,
+	    ufs != 0xffffu ? "" : " (none)", hit);
+	if (ufs != 0xffffu) {
+		printf("SWEET TOUCH: smmu ufs smr=%#x s2cr=%#x\n",
+		    touch_rd(s, 0x800u + 4u * ufs), touch_rd(s, 0xc00u + 4u * ufs));
+	}
+	if (hit != 0xffffu) {
+		printf("SWEET TOUCH: smmu gpi smr=%#x s2cr=%#x (left alone)\n",
+		    touch_rd(s, 0x800u + 4u * hit), touch_rd(s, 0xc00u + 4u * hit));
+		return;
+	}
+	if ((cr0 & 1u) || !(cr0 & (1u << 10))) {
+		/* CLIENTPD=1 or USFCFG=0: unmatched streams bypass */
+		printf("SWEET TOUCH: smmu unmatched streams bypass (USFCFG=0)\n");
+		return;
+	}
+	if (freei == 0xffffu) {
+		printf("SWEET TOUCH: smmu no free SMR\n");
+		return;
+	}
+	v_mark("smmu write");
+	/*
+	 * Run 33: the hypervisor turns a bypass S2CR into TYPE=fault (reads back
+	 * 0x20000) and the first doorbell reset the SoC. UFS (SID 0x60) works
+	 * through translation context bank of its own S2CR: share that one.
+	 */
+	if (ufs == 0xffffu) {
+		printf("SWEET TOUCH: smmu no UFS stream to share\n");
+		g_smmu_fault = true;
+		return;
+	}
+	g_smmu_gr0 = s;
+	unsigned s1 = 1, cb = 0;
+	(void)PE_parse_boot_argn("sweetgpis1", &s1, sizeof(s1));
+	if (s1) {
+		uint32_t idr1 = touch_rd(s, 0x24);
+		uint32_t pg = (idr1 >> 31) ? 0x10000u : 0x1000u;
+		uint32_t np = 1u << (((idr1 >> 28) & 7u) + 1u);
+		if (!g_smmu_s1(s, pg, np, idr1 & 0xffu, n, &cb)) {
+			g_smmu_fault = true;
+			return;
+		}
+		touch_wr(s, 0xc00u + 4u * freei, 0x300u | cb);  /* translate via our CB (Android: 0x304) */
+	} else {
+		touch_wr(s, 0xc00u + 4u * freei, touch_rd(s, 0xc00u + 4u * ufs));
+	}
+	touch_wr(s, 0x800u + 4u * freei, exids ? V_GPI_SID : ((1u << 31) | V_GPI_SID));
+	g_smmu_smri = freei;
+	/*
+	 * Android: SMR1 = 0x80000563 (QUPv3_0 wrapper, s2cr 0x301). In GSI mode the
+	 * SPI data buffers are mapped through the wrapper device (SID 0x563), not the
+	 * GPI one: the SE side masters with SID 0x563. Route it to the same CB.
+	 */
+	for (unsigned j = freei + 1u; j < n; ++j) {
+		uint32_t smr2 = touch_rd(s, 0x800u + 4u * j), s2c2 = touch_rd(s, 0xc00u + 4u * j);
+		bool v2 = exids ? ((s2c2 >> 10) & 1u) : (smr2 >> 31);
+		if (v2) {
+			continue;
+		}
+		touch_wr(s, 0xc00u + 4u * j, touch_rd(s, 0xc00u + 4u * freei));
+		touch_wr(s, 0x800u + 4u * j, exids ? 0x563u : ((1u << 31) | 0x563u));
+		__builtin_arm_dsb(0xf);
+		printf("SWEET TOUCH: smmu SID 0x563 (qup wrapper) at %u: smr=%#x s2cr=%#x\n", j,
+		    touch_rd(s, 0x800u + 4u * j), touch_rd(s, 0xc00u + 4u * j));
+		break;
+	}
+	printf("SWEET TOUCH: smmu SID %#x shares UFS context at %u: smr=%#x s2cr=%#x\n", V_GPI_SID, freei,
+	    touch_rd(s, 0x800u + 4u * freei), touch_rd(s, 0xc00u + 4u * freei));
+	if (((touch_rd(s, 0xc00u + 4u * freei) >> 16) & 3u) == 2u) {
+		printf("SWEET TOUCH: smmu S2CR forced to fault; no GPI DMA\n");
+		g_smmu_fault = true;
+	}
+}
+
+static bool
+g_init(void)
+{
+	v_mark("gpi map");
+	vm_offset_t m = ml_io_map(V_GPI_PA, V_GPI_SIZE);
+	if (!m) {
+		printf("SWEET TOUCH: GPI mapping failed\n");
+		return false;
+	}
+	vg.regs = m - V_GPI_EE;
+	if (kmem_alloc_contig(kernel_map, &vg.dma, G_DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET TOUCH: no contiguous DMA memory\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)vg.dma);
+	if (!pn) {
+		return false;
+	}
+	vg.pa = ptoa_64(pn);
+	vg.da = vg.pa;
+	g_smmu();
+	if (g_smmu_fault) {
+		return false;
+	}
+	g_sync(0, G_DMA_SIZE);
+	v_mark("gpi read");
+	g_dump("before");
+	printf("SWEET TOUCH: gpi gpii%u dma va %#lx pa %#llx\n", V_GPII, (unsigned long)vg.dma, vg.pa);
+
+	/* inherited state: stop/reset/free whatever is there */
+	for (unsigned k = 0; k < 2; ++k) {
+		unsigned s = g_ch_state(k);
+		if (s == 2u) {
+			(void)g_cmd(false, k, 2, 3);
+			s = g_ch_state(k);
+		}
+		if (s != 0u) {
+			(void)g_cmd(false, k, 9, 1);
+			(void)g_cmd(false, k, 10, 0);
+		}
+	}
+	if (g_ev_state() != 0u) {
+		(void)g_cmd(true, 0, 9, 0xffu);
+		(void)g_cmd(true, 0, 10, 0);
+	}
+
+	/* interrupts: masked at the source (polled), IRQ not MSI */
+	/* polled: nothing raises the GPII's GIC line (no handler under XNU) */
+	g_wr(G_TYPE_MSK, 0);
+	g_wr(G_IEOB_MSK, 0);
+	g_wr(G_SRC_CH_MSK, 0);
+	g_wr(G_SRC_EV_MSK, 0);
+	g_wr(G_GLOB_EN, 0);
+	g_wr(G_GPII_EN, 0);
+	g_wr(G_INTSET, 1);
+	g_wr(G_SRC_CH_CLR, 3u);
+	g_wr(G_SRC_EV_CLR, 1u);
+	g_wr(G_IEOB_CLR, 1u);
+	g_wr(G_GLOB_CLR, 0xffffffffu);
+	g_wr(G_GPII_CLR, 0xffffffffu);
+
+	v_mark("gpi ev alloc");
+	if (!g_cmd(true, 0, 0, 1)) {
+		return false;
+	}
+	uint64_t ev = vg.da + G_OFF_EV;
+	g_wr(G_EV_CNTXT + 0x00u, (G_EL << 24) | (1u << 16) | 2u);
+	g_wr(G_EV_CNTXT + 0x04u, G_EV_N * G_EL);
+	g_wr(G_EV_CNTXT + 0x08u, (uint32_t)ev);
+	g_wr(G_EV_CNTXT + 0x0cu, (uint32_t)(ev >> 32));
+	g_wr(G_EV_DB + 4u, (uint32_t)(ev >> 32));
+	g_wr(G_EV_CNTXT + 0x20u, 0);
+	g_wr(G_EV_CNTXT + 0x28u, 0);
+	g_wr(G_EV_CNTXT + 0x2cu, 0);
+	g_wr(G_EV_CNTXT + 0x30u, 0);
+	g_wr(G_EV_CNTXT + 0x34u, 0);
+	vg.ev_rp = 0;
+	g_ev_db();
+
+	v_mark("gpi ch alloc");
+	for (unsigned k = 0; k < 2; ++k) {
+		uint64_t r = vg.da + (k ? G_OFF_RX : G_OFF_TX);
+		if (!g_cmd(false, k, 0, 1)) {
+			return false;
+		}
+		/* TX = OUT (dir 1), RX = IN; event ring 0; protocol GPI */
+		g_wr(G_CH_CNTXT(k) + 0x00u, (G_EL << 24) | ((k ? 0u : 1u) << 3) | 2u);
+		g_wr(G_CH_CNTXT(k) + 0x04u, G_CH_N * G_EL);
+		g_wr(G_CH_CNTXT(k) + 0x08u, (uint32_t)r);
+		g_wr(G_CH_CNTXT(k) + 0x0cu, (uint32_t)(r >> 32));
+		g_wr(G_CH_DB(k) + 4u, (uint32_t)(r >> 32));
+		/* pair channel, protocol 1 = SPI, SE id 0 */
+		g_wr(G_CH_SCR(k, 0), ((k ? 0u : 1u) << 16) | (1u << 4) | 0u);
+		g_wr(G_CH_SCR(k, 1), 0);
+		g_wr(G_CH_SCR(k, 2), 0);
+		g_wr(G_CH_SCR(k, 3), 0);
+		g_wr(G_CH_QOS(k), 1);
+	}
+	vg.tx_wp = vg.rx_wp = 0;
+	v_mark("gpi start");
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!g_cmd(false, k, 1, 2)) {
+			return false;
+		}
+	}
+	g_dump("started");
+	vg.on = true;
+	return true;
+}
+
+static void
+g_tre(unsigned off, unsigned *wp, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(vg.dma + off + *wp * G_EL);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	*wp = (*wp + 1u) % G_CH_N;
+}
+
+/* One full-duplex SPI transfer through GSI: CONFIG0 + GO + DMA on TX, DMA on RX. */
+static int
+v_gpi_spi(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	if (!vg.on || st.dead || !n || n > G_BUF_MAX) {
+		return EIO;
+	}
+	uint8_t *txb = (uint8_t *)(vg.dma + G_OFF_TXB), *rxb = (uint8_t *)(vg.dma + G_OFF_RXB);
+	memcpy(txb, tx, n);
+	memset(rxb, 0xee, n);
+	if (0 && !vg.xfers) { /* run 56: SID 0x563 mapped, go straight to CONFIG0+GO+DMA */
+		/*
+		 * Run 38: CONFIG0 alone and an RX doorbell are harmless; CONFIG0 +
+		 * GO + DMA reset the SoC. Next bisect: TX-only (GO cmd 1), so the
+		 * GPI writes nothing to memory but the completion event.
+		 */
+		/*
+		 * Run 42: does the GPI read memory at all? One RX DMA TRE, RX
+		 * doorbell (harmless in run 38), then look at the channel's fetch
+		 * pointers (ctx +0x50..0x58: Android shows RP low bits there).
+		 */
+		{
+			uint64_t ra = vg.da + G_OFF_RXB;
+			for (unsigned i = 0; i < 2; ++i) {
+				printf("SWEET TOUCH: rx ctx pre %u: %#x %#x %#x %#x | %#x %#x %#x %#x | 50: %#x %#x %#x %#x\n", i,
+				    g_rd(G_CH_CNTXT(1)), g_rd(G_CH_CNTXT(1) + 4u), g_rd(G_CH_CNTXT(1) + 8u), g_rd(G_CH_CNTXT(1) + 12u),
+				    g_rd(G_CH_CNTXT(1) + 0x10u), g_rd(G_CH_CNTXT(1) + 0x14u), g_rd(G_CH_CNTXT(1) + 0x18u), g_rd(G_CH_CNTXT(1) + 0x1cu),
+				    g_rd(G_CH_CNTXT(1) + 0x50u), g_rd(G_CH_CNTXT(1) + 0x54u), g_rd(G_CH_CNTXT(1) + 0x58u), g_rd(G_CH_CNTXT(1) + 0x5cu));
+				if (i == 0) {
+					g_tre(G_OFF_RX, &vg.rx_wp, (uint32_t)ra, (uint32_t)(ra >> 32), 4u, TRE_TYPE(0x10) | TRE_IEOT);
+					g_sync(G_OFF_RX, G_CH_N * G_EL);
+					v_mark("gpi rx-only db");
+					g_wr(G_CH_DB(1), (uint32_t)(vg.da + G_OFF_RX + vg.rx_wp * G_EL));
+					for (unsigned t = 0; t < 10; ++t) {
+						delay(2000);
+						g_smmu_poll("rx-only");
+					}
+					v_mark("rx-only 20ms");
+				}
+			}
+			g_dump("after rx-only");
+			v_mark("rx-only checked");
+		}
+		uint64_t a = vg.da + G_OFF_TXB;
+		/*
+		 * Run 45: in every survivor so far the GPI never consumed a TRE
+		 * (CONFIG0 was chained, RX waits for the SE). An unchained
+		 * CONFIG0 + IEOT makes the GPI fetch, hand the config to the SE
+		 * and write one event, with no serial activity.
+		 */
+		g_tre(G_OFF_TX, &vg.tx_wp, (8u - 4u) | (1u << 24) | (1u << 25), 0,
+		    (vt.div & 0xfffu) | ((vt.level & 0xfu) << 16), TRE_TYPE(0x22) | TRE_IEOT);
+		g_sync(G_OFF_TX, G_CH_N * G_EL);
+		g_sync(G_OFF_EV, G_EV_N * G_EL);
+		if (0 && g_smmu_gr0 && g_smmu_smri != 0xffffu) {
+			/* run 48: unmatch the GPI stream; any GPI AXI access must now raise a global USF fault */
+			touch_wr(g_smmu_gr0, 0x800u + 4u * g_smmu_smri, 0);
+			__builtin_arm_dsb(0xf);
+			printf("SWEET TOUCH: usf test: smr %u = %#x cr0 %#x gfsr %#x\n", g_smmu_smri, touch_rd(g_smmu_gr0, 0x800u + 4u * g_smmu_smri), touch_rd(g_smmu_gr0, 0), touch_rd(g_smmu_gr0, 0x48));
+		}
+		g_qtb("pre");
+		g_dbg("pre");
+		g_sedump("pre");
+		g_watch("pre", 1, 10);
+		v_mark("gpi cfg0 unchained db");
+		g_wr(G_CH_DB(0), (uint32_t)(vg.da + G_OFF_TX + vg.tx_wp * G_EL));
+		g_watch("cfg0", 30, 300);
+		g_smmu_poll("cfg0");
+		g_dbg("cfg0");
+		g_sedump("cfg0");
+		if (g_smmu_gr0) printf("SWEET TOUCH: usf result gfsr %#x gfsynr0 %#x gfsynr1 %#x gfsynr2 %#x gfar %#x_%08x\n", touch_rd(g_smmu_gr0, 0x48), touch_rd(g_smmu_gr0, 0x50), touch_rd(g_smmu_gr0, 0x54), touch_rd(g_smmu_gr0, 0x58), touch_rd(g_smmu_gr0, 0x44), touch_rd(g_smmu_gr0, 0x40));
+		flush_dcache64((addr64_t)(vg.dma + G_OFF_EV), 64, FALSE);
+		{
+			volatile uint32_t *e = (volatile uint32_t *)(vg.dma + G_OFF_EV);
+			printf("SWEET TOUCH: cfg0 ev mem %#x %#x %#x %#x | %#x %#x %#x %#x\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+		}
+		v_mark("cfg0 survived");
+		g_tre(G_OFF_TX, &vg.tx_wp, 1u, 0, 0, TRE_TYPE(0x20) | TRE_CHAIN);
+		g_tre(G_OFF_TX, &vg.tx_wp, (uint32_t)a, (uint32_t)(a >> 32), 4u, TRE_TYPE(0x10) | TRE_IEOT);
+		memset((void *)(vg.dma + G_OFF_TXB), 0, 4);
+		g_sync(G_OFF_TX, G_CH_N * G_EL);
+		g_sync(G_OFF_TXB, 4);
+		g_sync(G_OFF_EV, G_EV_N * G_EL);
+		v_mark("gpi tx-only");
+		g_wr(G_CH_DB(0), (uint32_t)(vg.da + G_OFF_TX + vg.tx_wp * G_EL));
+		g_watch("tx", 200, 200);
+		v_mark("tx-only watched 40ms");
+	g_qtb("after");
+	g_dbg("after");
+		v_mark("pad");
+		flush_dcache64((addr64_t)(vg.dma + G_OFF_EV), 64, FALSE);
+		{
+			volatile uint32_t *e = (volatile uint32_t *)(vg.dma + G_OFF_EV);
+			printf("SWEET TOUCH: ev mem %#x %#x %#x %#x | %#x %#x %#x %#x\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+		}
+		v_mark("ev mem read");
+		v_mark("pad");
+		uint32_t gs = touch_rd(st.se, 0x40u);
+		printf("SWEET TOUCH: se status %#x\n", gs);
+		v_mark("se mmio ok");
+		v_mark("pad");
+		uint32_t trp = g_rd(G_CH_CNTXT(0) + 0x10u);
+		printf("SWEET TOUCH: tx rp %#x\n", trp);
+		v_mark("gpi mmio ok");
+		v_mark("pad");
+		for (unsigned i = 0; i < 5; ++i) {
+			delay(10000);
+			flush_dcache64((addr64_t)(vg.dma + G_OFF_EV), 64, FALSE);
+			volatile uint32_t *e = (volatile uint32_t *)(vg.dma + G_OFF_EV + vg.ev_rp * G_EL);
+			printf("SWEET TOUCH: after tx-only %u: tx rp %#x ch0 %#x ev rp %#x ev %#x %#x %#x %#x se m-st %#x m-irq %#x\n", i,
+			    g_rd(G_CH_CNTXT(0) + 0x10u), g_rd(G_CH_CNTXT(0)), g_rd(G_EV_CNTXT + 0x10u), e[0], e[1], e[2], e[3],
+			    touch_rd(st.se, 0x40u), touch_rd(st.se, 0x610u));
+		}
+		uint32_t hw = g_rd(G_EV_CNTXT + 0x10u);
+		vg.ev_rp = (unsigned)(((uint64_t)hw - (uint32_t)(vg.da + G_OFF_EV)) / G_EL) % G_EV_N;
+		g_ev_db();
+		v_mark("gpi tx-only survived");
+	}
+	unsigned tx0 = vg.tx_wp, rx0 = vg.rx_wp;
+	uint64_t ta = vg.da + G_OFF_TXB, ra = vg.da + G_OFF_RXB;
+	/* CONFIG0: 8-bit words (8 - MIN_WORD_LEN 4), mode 0, tx/rx packing */
+	g_tre(G_OFF_TX, &vg.tx_wp, (8u - 4u) | (1u << 24) | (1u << 25), 0,
+	    (vt.div & 0xfffu) | ((vt.level & 0xfu) << 16), TRE_TYPE(0x22) | TRE_CHAIN);
+	/* GO: SPI_DUPLEX (3), CS0, rx_len n */
+	g_tre(G_OFF_TX, &vg.tx_wp, 3u, 0, n & 0xffffffu, TRE_TYPE(0x20) | TRE_CHAIN | TRE_LINK);
+	g_tre(G_OFF_TX, &vg.tx_wp, (uint32_t)ta, (uint32_t)(ta >> 32), n, TRE_TYPE(0x10) | TRE_IEOT);
+	g_tre(G_OFF_RX, &vg.rx_wp, (uint32_t)ra, (uint32_t)(ra >> 32), n, TRE_TYPE(0x10));
+	g_sync(G_OFF_TX, G_CH_N * G_EL);
+	g_sync(G_OFF_RX, G_CH_N * G_EL);
+	g_sync(G_OFF_TXB, n);
+	g_sync(G_OFF_RXB, n);
+	if (!vg.xfers) {
+		v_mark("gpi db");
+	}
+	/* RX first so the RX channel is ready when the GO starts the clock */
+	g_wr(G_CH_DB(1), (uint32_t)(vg.da + G_OFF_RX + vg.rx_wp * G_EL));
+	if (!vg.xfers) {
+		v_mark("gpi tx db");
+	}
+	g_wr(G_CH_DB(0), (uint32_t)(vg.da + G_OFF_TX + vg.tx_wp * G_EL));
+
+	if (!vg.xfers) {
+		v_mark("gpi wait");
+	}
+	bool txd = false, rxd = false;
+	unsigned codes = 0;
+	int err = 0;
+	for (unsigned i = 0; i < 20000 && !(txd && rxd); ++i) {
+		uint32_t hw = g_rd(G_EV_CNTXT + 0x10u);
+		unsigned hwi = (unsigned)(((uint64_t)hw - (uint32_t)(vg.da + G_OFF_EV)) / G_EL) % G_EV_N;
+		if (hwi == vg.ev_rp) {
+			/* RX may finish without an event: its RP passing our WP */
+			if (txd && g_rd(G_CH_CNTXT(1) + 0x10u) == (uint32_t)(vg.da + G_OFF_RX + vg.rx_wp * G_EL)) {
+				rxd = true;
+				break;
+			}
+			delay(2);
+			continue;
+		}
+		g_sync(G_OFF_EV, G_EV_N * G_EL);
+		while (vg.ev_rp != hwi) {
+			volatile uint32_t *e = (volatile uint32_t *)(vg.dma + G_OFF_EV + vg.ev_rp * G_EL);
+			uint32_t d2 = e[2], d3 = e[3];
+			unsigned code = (d2 >> 24) & 0xffu, type = (d3 >> 16) & 0xffu, chid = (d3 >> 24) & 0xffu;
+			if (vg.logged < 6u) {
+				vg.logged++;
+				printf("SWEET TOUCH: gpi event %08x %08x %08x %08x (type %#x ch %u code %u len %u)\n",
+				    e[0], e[1], d2, d3, type, chid, code, d2 & 0xffffffu);
+			}
+			if (type == 0x22u) {
+				codes |= code;
+				if (code & 16u) {
+					err = EIO;
+				}
+				if (chid == 0u) {
+					txd = true;
+				} else if (chid == 1u) {
+					rxd = true;
+				}
+			}
+			vg.ev_rp = (vg.ev_rp + 1u) % G_EV_N;
+		}
+		g_ev_db();
+		if (err) {
+			break;
+		}
+	}
+	vg.xfers++;
+	if (!err && txd && rxd) {
+		g_sync(G_OFF_RXB, n);
+		memcpy(rx, rxb, n);
+		return 0;
+	}
+	vg.fails++;
+	printf("SWEET TOUCH: gpi xfer %u len %u failed tx %d rx %d codes %#x tre tx %u..%u rx %u..%u\n",
+	    vg.xfers, n, txd, rxd, codes, tx0, vg.tx_wp, rx0, vg.rx_wp);
+	g_dump("xfer");
+	if (vg.fails <= 1u) { g_dbg("xfer"); g_sedump("xfer"); g_smmu_poll("xfer"); }
+	if (vg.fails >= 8u && vg.fails == vg.xfers) {
+		printf("SWEET TOUCH: gpi never completes; giving up\n");
+		st.dead = true;
+	}
+	return err ? err : ETIMEDOUT;
+}
+
+static void
+v_se_gsi(void)
+{
+	/* geni_se_select_gpi_mode() */
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, 0xe1c, 0);
+	printf("SWEET TOUCH: se0 before: m-irq-en=%#x s-irq-en=%#x mclk=%#x clksel=%#x pack=%#x/%#x wl=%#x e14=%#x e20=%#x\n",
+	    touch_rd(st.se, SE_IRQ_EN), touch_rd(st.se, 0x644), touch_rd(st.se, SE_MCLK),
+	    touch_rd(st.se, SE_CLK_SEL), touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x268), touch_rd(st.se, 0xe14), touch_rd(st.se, 0xe20));
+	/* values read live from Android (gpidump.ko) with the touch running */
+	touch_wr(st.se, SE_IRQ_EN, 0x33c0007eu);
+	touch_wr(st.se, 0x644, 0x03001e36u);
+	touch_wr(st.se, 0x260, 0x0007f8feu);
+	touch_wr(st.se, 0x264, 0x000ffefeu);
+	touch_wr(st.se, 0x268, 4u);
+	touch_wr(st.se, SE_DMA, 1);
+	touch_wr(st.se, 0xe18, 0xfu);
+	touch_wr(st.se, SE_CLK_SEL, vt.level);
+	touch_wr(st.se, SE_MCLK, (vt.div << 4) | 1u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET TOUCH: se0 after: m-irq-en=%#x s-irq-en=%#x mclk=%#x clksel=%#x pack=%#x/%#x wl=%#x\n",
+	    touch_rd(st.se, SE_IRQ_EN), touch_rd(st.se, 0x644), touch_rd(st.se, SE_MCLK),
+	    touch_rd(st.se, SE_CLK_SEL), touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x268));
+	printf("SWEET TOUCH: se0 GSI mode: dma=%#x gsi-ev=%#x m-irq-en=%#x\n",
+	    touch_rd(st.se, SE_DMA), touch_rd(st.se, 0xe18), touch_rd(st.se, SE_IRQ_EN));
+}
+
+static bool
+v_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	uint32_t ifdis = touch_rd(st.se, 0x64);
+	st.d_fw = fw;
+	st.d_status = touch_rd(st.se, SE_STATUS);
+	st.d_hwtx = tx;
+	st.d_hwrx = rx;
+	vt.depth = (tx >> 16) & 0x3fu;
+	printf("SWEET TOUCH: se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x if-disable=%#x dma=%#x\n",
+	    fw, (fw >> 8) & 0xffu, st.d_status, tx, rx, ifdis, touch_rd(st.se, SE_DMA));
+	if (((fw >> 8) & 0xffu) != 1u) {
+		printf("SWEET TOUCH: SE0 has no SPI firmware; stopping\n");
+		return false;
+	}
+	if (ifdis & 1u) {
+		printf("SWEET TOUCH: SE0 FIFO interface disabled: using GPI DMA (GSI)\n");
+		if (st.d_status & 1u) {
+			printf("SWEET TOUCH: SE0 already busy; stopping\n");
+			return false;
+		}
+		v_se_gsi();
+		return g_init();
+	}
+	if (((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    vt.depth < 4u || ((rx >> 16) & 0x3fu) < 4u) {
+		printf("SWEET TOUCH: unexpected FIFO geometry; stopping\n");
+		return false;
+	}
+	if (st.d_status & 1u) {
+		printf("SWEET TOUCH: SE0 already busy; stopping\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0);              /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0);              /* no IRQ to the GIC: polled */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);             /* FIFO mode */
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, vt.level);
+	touch_wr(st.se, SE_MCLK, (vt.div << 4) | 1u);
+	/* spi-geni-qcom.c: mode 0, CS0 active low, no loopback, CS not toggled */
+	touch_wr(st.se, V_SPI_LOOPBACK, 0);
+	touch_wr(st.se, V_SPI_DEMUX, 0);
+	touch_wr(st.se, V_SPI_CPHA, 0);
+	touch_wr(st.se, V_SPI_CPOL, 0);
+	touch_wr(st.se, V_SPI_INV, 0);
+	touch_wr(st.se, V_SPI_TRANS_CFG, touch_rd(st.se, V_SPI_TRANS_CFG) & ~2u);
+	touch_wr(st.se, V_SPI_DELAY, 0);
+	touch_wr(st.se, V_SPI_WORD_LEN, 8u - 4u);
+	/* geni_se_config_packing(8, 4, msb first): as the I2C path */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 2u);    /* RFR: stall, never overflow */
+	touch_wr(st.se, SE_IRQ_EN, 1u | V_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST);
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x284) != SE_PACK0 ||
+	    touch_rd(st.se, V_SPI_WORD_LEN) != 4u) {
+		printf("SWEET TOUCH: SE0 config readback mismatch; stopping\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+/* One full-duplex transfer of n bytes, CS asserted throughout. */
+static int
+v_spi(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	if (vg.on) {
+		return v_gpi_spi(tx, rx, n);
+	}
+	if (st.dead || !n || n > 256u) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		return EBUSY;
+	}
+	st.irq_status = st.irq_last = 0;
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, V_SPI_TX_LEN, n);
+	touch_wr(st.se, V_SPI_RX_LEN, n);
+	touch_wr(st.se, SE_CMD, V_SPI_TX_RX << 27);
+	unsigned sent = 0, got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t txc = touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu;
+		while (sent < n && txc + 1u < vt.depth) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent + j < n; ++j) {
+				word |= (uint32_t)tx[sent + j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			sent += 4;
+			txc++;
+		}
+		uint32_t irq = touch_irq();
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < n; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & V_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if (irq & 1u) {
+			/* drain what arrived with DONE */
+			count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+			while (count-- && got < n) {
+				uint32_t word = touch_rd(st.se, SE_RX);
+				for (unsigned j = 0; j < 4 && got < n; ++j) {
+					rx[got++] = (uint8_t)(word >> (8u * j));
+				}
+			}
+			touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+			if (got == n && sent >= n) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		if (sent >= n) {
+			delay(1);
+		}
+	}
+	printf("SWEET TOUCH: spi xfer len=%u err=%d sent=%u got=%u irq=%#x seen=%#x status=%#x\n",
+	    n, err, sent, got, st.irq_last, st.irq_status, touch_rd(st.se, SE_STATUS));
+	touch_abort();
+	return err;
+}
+
+static uint16_t
+v_crc(const uint8_t *d, unsigned n)
+{
+	uint16_t crc = 0xffffu;
+	for (unsigned i = 0; i < n; ++i) {
+		crc ^= d[i];
+		for (unsigned j = 0; j < 8; ++j) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+/* focaltech_spi_v2.c fts_read(): READ_CMD with CRC, 3 dummy bytes. */
+static int
+v_fts_read(uint8_t addr, uint8_t *data, unsigned len)
+{
+	uint8_t tx[V_FRAME + 16], rx[V_FRAME + 16];
+	unsigned dp = 7, total = dp + len + 2;
+	int err = EIO;
+	if (total > sizeof(tx)) {
+		return EINVAL;
+	}
+	for (unsigned retry = 0; retry < 3 && !st.dead; ++retry) {
+		memset(tx, 0, total);
+		memset(rx, 0, total);
+		tx[0] = addr;
+		tx[1] = 0x80u | 0x20u;
+		tx[2] = (uint8_t)(len >> 8);
+		tx[3] = (uint8_t)len;
+		err = v_spi(tx, rx, total);
+		delay(150);     /* CS_HIGH_DELAY */
+		if (err) {
+			continue;
+		}
+		vt.status = rx[3];
+		if (rx[3] & 0xa0u) {
+			vt.busy++;
+			err = EBUSY;
+			continue;
+		}
+		if (v_crc(rx + dp, len) != (uint16_t)(rx[dp + len] | (rx[dp + len + 1] << 8))) {
+			vt.crc++;
+			err = EBADMSG;
+			continue;
+		}
+		memcpy(data, rx + dp, len);
+		return 0;
+	}
+	return err;
+}
+
+static int
+v_frame(void)
+{
+	uint8_t buf[V_FRAME];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = v_fts_read(0x01, buf, sizeof(buf));
+	vt.reads++;
+	if (err) {
+		return err;
+	}
+	unsigned type = buf[1] >> 4, n = buf[1] & 15u;
+	if (buf[1] == 0xffu) {
+		vt.ff++;
+		return EAGAIN;           /* no report in the buffer */
+	}
+	vt.frames++;
+	if (n || vt.rawn == 0) {
+		memcpy(vt.raw, buf, sizeof(vt.raw));
+		vt.rawn = 1;
+	}
+	if (type == 0) {
+		for (unsigned i = 0; n && i < TOUCH_MAX; ++i) {
+			const uint8_t *p = buf + 2u + 6u * i;
+			unsigned id = p[2] >> 4, flag = p[0] >> 6;
+			if (id >= 15u) {
+				break;
+			}
+			if (id >= TOUCH_MAX) {
+				return EIO;
+			}
+			if (flag == 1u) {
+				continue;       /* UP */
+			}
+			mask |= 1u << id;
+			x[id] = (int)(((unsigned)(p[0] & 15u) << 8) | p[1]);
+			y[id] = (int)(((unsigned)(p[2] & 15u) << 8) | p[3]);
+		}
+	} else if (type == 2) {
+		if (n > TOUCH_MAX) {
+			return EIO;
+		}
+		for (unsigned i = 0; i < n; ++i) {
+			const uint8_t *p = buf + 4u + 8u * i;
+			unsigned id = p[2] >> 4, flag = p[0] >> 6;
+			if (id >= TOUCH_MAX) {
+				return EIO;
+			}
+			if (flag == 1u) {
+				continue;
+			}
+			mask |= 1u << id;
+			x[id] = (int)((((unsigned)(p[0] & 15u) << 12) | ((unsigned)p[1] << 4) | (p[4] >> 4)) / 16u);
+			y[id] = (int)((((unsigned)(p[2] & 15u) << 12) | ((unsigned)p[3] << 4) | (p[4] & 15u)) / 16u);
+		}
+	} else {
+		return 0;               /* pen/gesture/other: not handled */
+	}
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		if (mask & (1u << id)) {
+			x[id] = x[id] > 1079 ? 1079 : x[id];
+			y[id] = y[id] > 2391 ? 2391 : y[id];
+			st.s_lastx = x[id];
+			st.s_lasty = y[id];
+		}
+	}
+	if (n > st.s_maxn) {
+		st.s_maxn = n;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+touch_thread_volcano(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 40;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: volcano FT3681 SPI, starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	v_mark("map");
+	st.gcc = ml_io_map(V_GCC_PA, 0x60000);
+	vt.tlmm = ml_io_map(V_TLMM_PA, 0x16000);
+	st.se = ml_io_map(V_SE_PA, 0x4000);
+	st.west = st.east = vt.tlmm;
+	if (!st.gcc || !vt.tlmm || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET TOUCH: TLMM before: gpio0..3 %#x %#x %#x %#x irq %#x/%#x reset %#x/%#x\n",
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(0)), touch_rd(vt.tlmm, TOUCH_GPIO_CFG(1)),
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(2)), touch_rd(vt.tlmm, TOUCH_GPIO_CFG(3)),
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(V_PIN_IRQ)), touch_rd(vt.tlmm, TOUCH_GPIO_IO(V_PIN_IRQ)),
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(V_PIN_RESET)), touch_rd(vt.tlmm, TOUCH_GPIO_IO(V_PIN_RESET)));
+	v_mark("bcm");
+	{
+		int be = sweet_rpmh_bcm_vote(V_BCM_QUP0, V_BCM_QUP0_VOTE, V_BCM_QUP0_VOTE);
+		printf("SWEET TOUCH: BCM QUP0 vote %u -> %d\n", V_BCM_QUP0_VOTE, be);
+		/*
+		 * qup-memory path qhm_qup0 -> a2noc -> qnm_aggre2_noc (system NoC)
+		 * -> gem -> ebi: vote every system NoC BCM (cmd-db SN0..SN5);
+		 * UFS rides on aggre1 whose BCM the bootloader left on.
+		 */
+		static const uint32_t sn_bcm[] = {0x50010u, 0x50014u, 0x50018u, 0x5001cu, 0x50020u, 0x50024u, 0x50000u, 0x50004u, 0x50030u};
+		for (unsigned i = 0; i < sizeof(sn_bcm) / sizeof(sn_bcm[0]); ++i) {
+			int sn = sweet_rpmh_bcm_vote(sn_bcm[i], 0x100u, 0x100u);
+			printf("SWEET TOUCH: BCM SN%u vote -> %d\n", i, sn);
+		}
+		{ int ip0 = sweet_rpmh_bcm_vote(0x50038u, 0u, 1u); printf("SWEET TOUCH: BCM IP0 (aggre2 noc clk) vote -> %d\n", ip0); }
+		{ int acv = sweet_rpmh_bcm_vote(0x50068u, 0u, 1u); printf("SWEET TOUCH: BCM ACV vote -> %d\n", acv); }
+		if (be) {
+			goto out;
+		}
+	}
+	v_mark("clocks");
+	if (!v_clocks()) {
+		goto out;
+	}
+	v_mark("se0 init");
+	if (!v_se_init()) {
+		goto out;
+	}
+	v_mark("power/reset");
+	/* fts_power_source_ctrl(): reset low, vci, vddio, 2 ms, reset high, 200 ms */
+	touch_gpio(V_PIN_RESET, 0, 0, 1, true, false);
+	touch_gpio(V_PIN_IRQ, 0, 3, 0, false, false);
+	touch_wait(5);
+	int pe1 = sweet_rpmh_vrm_enable(V_VRM_VCI, 3300, 7);
+	int pe2 = sweet_rpmh_vrm_enable(V_VRM_VDDIO, 1800, 7);
+	printf("SWEET TOUCH: power vci(ldob22)=%d vddio(ldob11)=%d\n", pe1, pe2);
+	for (unsigned pin = 0; pin < 4; ++pin) {
+		touch_gpio(pin, 1, 0, 2, false, false);  /* qup0_se0, 6 mA, no pull */
+	}
+	touch_wait(5);
+	touch_gpio(V_PIN_RESET, 0, 0, 1, true, true);
+	touch_wait(250);
+	printf("SWEET TOUCH: TLMM after: gpio0 %#x irq %#x/%#x reset %#x/%#x\n",
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(0)),
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(V_PIN_IRQ)), touch_rd(vt.tlmm, TOUCH_GPIO_IO(V_PIN_IRQ)),
+	    touch_rd(vt.tlmm, TOUCH_GPIO_CFG(V_PIN_RESET)), touch_rd(vt.tlmm, TOUCH_GPIO_IO(V_PIN_RESET)));
+	v_mark("probe");
