+bool
+topaz_wlan_heard(unsigned index, struct topaz_wlan_bss *out)
+{
+	if (index >= nbss) {
+		return false;
+	}
+	const struct bss *b = &bss[index];
+	bzero(out, sizeof(*out));
+	memcpy(out->bssid, b->bssid, 6);
