+/* hal_srng_src_hw_init (TCL1 layout offsets: msb +4, id +8, misc +0x10, tp +0x1c/0x20, int +0x30/0x34) */
+static void
+vce_src_init(uint32_t r0, uint64_t pa, uint32_t words, uint32_t n, uint64_t tp_pa)
+{
+	w_v_wr(r0 + 0x00, (uint32_t)pa);
+	w_v_wr(r0 + 0x04, ((uint32_t)(pa >> 32) & 0xFF) | ((words * n) << 8));
+	w_v_wr(r0 + 0x08, words);
+	w_v_wr(r0 + 0x30, 0);
+	w_v_wr(r0 + 0x34, 0);
+	w_v_wr(r0 + 0x1c, (uint32_t)tp_pa);
+	w_v_wr(r0 + 0x20, (uint32_t)(tp_pa >> 32));
+	w_v_wr(r0 + 0x400, 0);
+	w_v_wr(r0 + 0x404, 0);
+	w_v_wr(r0 + 0x10, (1u << 1) | (1u << 6));  /* MSI loopcnt disable | SRNG enable */
+}
+
+/* hal_srng_dst_hw_init (REO1 layout offsets: msb +4, id +8, misc +0x10, hp +0x14/0x18, int +0x24) */
+static void
+vce_dst_init(uint32_t r0, uint32_t r2, uint64_t pa, uint32_t words, uint32_t n, uint32_t ring_id, uint64_t hp_pa)
+{
+	w_v_wr(r0 + 0x00, (uint32_t)pa);
+	w_v_wr(r0 + 0x04, ((uint32_t)(pa >> 32) & 0xFF) | ((words * n) << 8));
+	w_v_wr(r0 + 0x08, (ring_id << 8) | words);
+	w_v_wr(r0 + 0x24, 0);
+	w_v_wr(r0 + 0x14, (uint32_t)hp_pa);
+	w_v_wr(r0 + 0x18, (uint32_t)(hp_pa >> 32));
+	w_v_wr(r2 + 0, 0);
+	w_v_wr(r2 + 4, 0);
+	w_v_wr(r0 + 0x10, 1u << 6);
+}
+
+static void
+vce_post(uint32_t c)
+{
+	struct vce_state *s = &vce[c];
+	uint32_t slot = s->dst_hp;
+	uint64_t pa = s->rx_pa + (uint64_t)slot * VCE_BUF;
+	s->dst[2 * slot] = (uint32_t)pa;
+	s->dst[2 * slot + 1] = (uint32_t)(pa >> 32) & 0xFF;
+	s->dst_hp = (slot + 1) % VCE_RING;
+}
