+/* "image/qca6750/wpss.b00": first cluster and size */
+static bool
+fat_path(const char *path, uint32_t *first, uint32_t *size)
+{
+	uint32_t cl = 0, sz = 0;
+	if (!fat_init()) {
+		return false;
+	}
+	for (const char *c = path; *c;) {
+		const char *e = strchr(c, '/');
+		size_t n = e ? (size_t)(e - c) : strlen(c);
+		if (!fat_lookup(cl, c, n, &cl, &sz)) {
+			LOG("%s: no \"%.*s\" on %s", path, (int)n, c, fw_part);
+			return false;
+		}
+		c += n + (e ? 1 : 0);
+	}
+	*first = cl;
+	*size = sz;
+	return true;
+}
+
+/* whole file into dst, contiguous cluster runs in one read */
+static int64_t
+fat_read(const char *path, void *dst, uint64_t max)
+{
+	uint32_t cl, size;
+	if (!fat_path(path, &cl, &size)) {
+		LOG("%s: not found on %s", path, fw_part);
+		return -1;
+	}
+	if (size > max) {
+		LOG("%s: %u bytes, room for %llu", path, size, max);
+		return -1;
+	}
+	uint64_t done = 0;
+	while (done < size && cl >= 2 && cl < 0xFFF8) {
+		uint32_t run = 1;
+		while (cl + run - 1 < fat.nfat && fat.fat[cl + run - 1] == cl + run && (uint64_t)run * fat.csize < size - done) {
+			run++;
+		}
+		uint64_t take = MIN((uint64_t)run * fat.csize, size - done);
+		if (sweet_ufs_read_part(fw_part, fat.data_off + (uint64_t)(cl - 2) * fat.csize, (uint8_t *)dst + done, take) != 0) {
+			LOG("%s: read error", path);
+			return -1;
+		}
+		done += take;
+		uint32_t last = cl + run - 1;
+		cl = last < fat.nfat ? fat.fat[last] : 0xFFFF;
+	}
+	return done == size ? (int64_t)size : -1;
+}
