+static bool
+w_coex(uint32_t type, uint32_t a1, uint32_t a2)
+{
+	uint8_t m[4 + 32], *c = wmi_put_tlv(m, 0x20a, 32);
+	bzero(c, 32);
+	c = put32(c, 0);
+	c = put32(c, type);
+	c = put32(c, a1);
+	put32(c, a2);
+	return wmi_send(0x29003, m, sizeof(m));
+}
