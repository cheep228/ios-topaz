+	if (!wait_clear(i2c7_se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(i2c7_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c7_se, SE_TX_WM, nt ? 1u : 0u);
+	wr(i2c7_se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(i2c7_se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = rd(i2c7_se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			int err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 2000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = rd(i2c7_se, SE_IRQ);
+			}
+			if (!(irq & SE_DONE) || (rd(i2c7_se, SE_STATUS) & 1u)) {
+				i2c7_abort();
+			}
+			wr(i2c7_se, SE_IRQ_CLR, 0xffffffffu);
+			return err;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(i2c7_se, SE_TX, word);
+			sent = nt;
+			wr(i2c7_se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(i2c7_se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 16) {
+			break;
+		}
+		while (count--) {
+			uint32_t word = rd(i2c7_se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			wr(i2c7_se, SE_IRQ_CLR, 0xffffffffu);
+			return (got == nr && sent == nt) ? 0 : EIO;
+		}
+		wr(i2c7_se, SE_IRQ_CLR, irq & ~SE_DONE);
+		delay(1);
+	}
+	{
+		static int logged;
+		if (logged++ < 2) {
+			printf("SWEET I2C7: timeout addr %#x status %#x irq %#x s_irq %#x ifdis %#x txc %#x rxc %#x m_cmd %#x clk %#x/%#x tlmm %#x/%#x\n",
+			    addr, rd(i2c7_se, SE_STATUS), rd(i2c7_se, SE_IRQ), rd(i2c7_se, 0x640), rd(i2c7_se, 0x64),
+			    rd(i2c7_se, SE_TX_COUNT), rd(i2c7_se, SE_RX_COUNT), rd(i2c7_se, SE_CMD),
+			    rd(i2c7_gcc, I2C7_CBCR), rd(i2c7_se, SE_MCLK), rd(i2c7_west, 0x0004), rd(i2c7_west, 0x1004));
+		}
+	}
+	i2c7_abort();
+	return ETIMEDOUT;
+}
+
+/*
+ * GSI transport. QUP1 SE0 is "qcom,shared" on volcano: GENI_IF_DISABLE_RO=1,
+ * FIFO is off, only GPI DMA works. Minimal polled driver for gpi@800000
+ * (apps EE at ee-offset 0x10000), GPII 0, ch0 TX / ch1 RX, one event ring.
+ * TRE layout from msm_gpi.h / i2c-msm-geni.c (lock, cfg0, go, dma, unlock).
+ */
+#define GPI_PA          0x00800000u
+#define GPI_SZ          0x00060000u
+#define GPII_N          0u
+#define GR(o)           ((o) - 0x10000u + 0x4000u * GPII_N)
+#define CH_CTX(k)       GR(0x20000u + 0x80u * (k))
+#define CH_DB(k)        GR(0x22000u + 0x8u * (k))
+#define CH_SCR(k, i)    GR(0x20060u + 0x80u * (k) + 4u * (i))
+#define CH_QOS(k)       GR(0x2005cu + 0x80u * (k))
+#define CH_CMD          GR(0x23008u)
+#define EV_CTX          GR(0x21000u)
+#define EV_DB           GR(0x22100u)
+#define EV_CMD          GR(0x23010u)
+#define GPII_INTSET     GR(0x23180u)
+#define GPII_ERRLOG     GR(0x23200u)
+#define RING_N          64u
+#define RING_SZ         (RING_N * 16u)
+
+static vm_offset_t i2c7_gpi;
+static bool i2c7_gsi;
+static uint8_t gpi_mem[0x8000] __attribute__((aligned(0x4000)));
+static uint64_t gpi_pa, gpi_da;
+static unsigned tx_wp, rx_wp, ev_rp;
+static int gpi_logs;
+#define RING_TX         0x0000u
+#define RING_RX         0x0400u
+#define RING_EV         0x0800u
+#define BUF_RX          0x1000u
+
+extern vm_offset_t ml_vtophys(vm_offset_t);
+extern void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+extern void sweet_dcache_flush(vm_offset_t addr, unsigned length);
+
+static unsigned
+ch_state(unsigned k)
+{
+	return (rd(i2c7_gpi, CH_CTX(k)) >> 20) & 0xfu;
+}
+
+static unsigned
+ev_state(void)
+{
+	return (rd(i2c7_gpi, EV_CTX) >> 20) & 0xfu;
+}
+
+static void
+gpi_clr_irqs(void)
+{
+	wr(i2c7_gpi, GR(0x230a0u), 0xffffffffu);
+	wr(i2c7_gpi, GR(0x230a4u), 0xffffffffu);
+	wr(i2c7_gpi, GR(0x230c0u), 0xffffffffu);
+	wr(i2c7_gpi, GR(0x23110u), 0xffffffffu);
+	wr(i2c7_gpi, GR(0x23128u), 0xffffffffu);
+}
+
+/* want 0xff: just give the command time, state not checked */
+static bool
+gpi_cmd(bool ev, unsigned k, unsigned op, unsigned want)
+{
+	wr(i2c7_gpi, ev ? EV_CMD : CH_CMD, (op << 24) | k);
+	for (unsigned i = 0; i < 20000; ++i) {
+		unsigned s = ev ? ev_state() : ch_state(k);
+		if (want != 0xffu && s == want) {
+			gpi_clr_irqs();
+			return true;
+		}
+		delay(1);
+		if (want == 0xffu && i > 2000) {
+			break;
+		}
+	}
+	gpi_clr_irqs();
+	return want == 0xffu;
+}
+
+static void
+gpi_teardown(void)
+{
+	for (unsigned k = 0; k < 2; ++k) {
+		if (ch_state(k) == 2u) {
+			(void)gpi_cmd(false, k, 2, 3);          /* STOP */
+		}
+		if (ch_state(k) != 0u) {
+			(void)gpi_cmd(false, k, 9, 0xff);       /* RESET */
+			(void)gpi_cmd(false, k, 10, 0);         /* DE_ALLOC */
+		}
+	}
+	if (ev_state() != 0u) {
+		(void)gpi_cmd(true, 0, 9, 0xff);
+		(void)gpi_cmd(true, 0, 10, 0);
+	}
+}
+
+static uint32_t
+lo(uint64_t pa)
+{
+	return (uint32_t)pa;
+}
+
+static uint32_t
+hi(uint64_t pa)
+{
+	return (uint32_t)(pa >> 32);
+}
+
+/*
+ * apps SMMU: unmatched streams fault (USFCFG=1) and the hypervisor turns a
+ * bypass S2CR into fault, so the first GPI fetch reset the SoC (log366).
+ * Same recipe as sweet_touch.c (its GPI@a00000 SID 0x576): a free context
+ * bank with identity S1 tables over gpi_mem, IOVA 0x40000000 | (pa & 2M-1)
+ * (the GPI wants 32-bit addresses), SMRs for the GPI (0x36) and the QUP1
+ * wrapper (0x23, the SE masters RX data with it).
+ */
+#define SMMU_PA         0x15000000u
+#define PT_OFF          0x4000u
+
+static int
+i2c7_smmu(void)
+{
+	vm_offset_t s = ml_io_map(SMMU_PA, 0x1000);
+	if (!s) {
+		return 1;
+	}
+	uint32_t cr0 = rd(s, 0), idr0 = rd(s, 0x20), idr1 = rd(s, 0x24);
+	uint32_t pg = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	uint32_t np = 1u << (((idr1 >> 28) & 7u) + 1u);
+	unsigned nsmr = idr0 & 0xffu, ncb = idr1 & 0xffu;
+	bool exids = (cr0 >> 3) & 1u;
+	if (nsmr > 128u) {
+		nsmr = 128u;
+	}
+	uint8_t used[128] = {0};
+	unsigned fr[2] = { 0xffffu, 0xffffu }, nf = 0;
+	for (unsigned i = 0; i < nsmr; ++i) {
+		uint32_t smr = rd(s, 0x800u + 4u * i), s2cr = rd(s, 0xc00u + 4u * i);
+		bool valid = exids ? ((s2cr >> 10) & 1u) : (smr >> 31);
+		if (valid) {
+			if (((s2cr >> 16) & 3u) == 0u) {
+				used[s2cr & 0x7fu] = 1;
+			}
+			uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+			if (((0x36u ^ id) & ~mask) == 0) {
+				printf("SWEET GPI: smmu SID 0x36 already at %u smr %#x s2cr %#x\n", i, smr, s2cr);
+				return 2;
+			}
+		} else if (nf < 2) {
+			fr[nf++] = i;
+		}
+	}
+	unsigned cb = 0xffffu;
+	for (unsigned i = 1; i < ncb && i < 128u; ++i) {
+		if (!used[i]) {
+			cb = i;
+			break;
+		}
+	}
+	uint64_t pa = gpi_pa;
+	if (nf < 2 || cb == 0xffffu || (pa >> 21) != ((pa + sizeof(gpi_mem) - 1u) >> 21) || (pa >> 36) ||
+	    ml_vtophys((vm_offset_t)gpi_mem + sizeof(gpi_mem) - 1u) != pa + sizeof(gpi_mem) - 1u) {
+		printf("SWEET GPI: smmu no room (free smr %u cb %u pa %#llx)\n", nf, cb, pa);
+		return 3;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)(gpi_mem + PT_OFF);
+	volatile uint64_t *l2 = (volatile uint64_t *)(gpi_mem + PT_OFF + 0x1000u);
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpi_mem + PT_OFF + 0x2000u);
+	volatile uint64_t *m2 = (volatile uint64_t *)(gpi_mem + PT_OFF + 0x3000u);
+	uint64_t pt = pa + PT_OFF;
+	for (unsigned i = 0; i < 512u * 4u; ++i) {
+		l1[i] = 0;
+	}
+	uint64_t da = 0x40000000ull | (pa & 0x1fffffull);
+	l1[(pa >> 30) & 0x3fu] = (pt + 0x1000u) | 3u;
+	l2[(pa >> 21) & 0x1ffu] = (pt + 0x2000u) | 3u;
+	l1[(da >> 30) & 0x3fu] = (pt + 0x3000u) | 3u;
+	m2[(da >> 21) & 0x1ffu] = (pt + 0x2000u) | 3u;
+	for (uint64_t a = pa; a < pa + sizeof(gpi_mem); a += 0x1000u) {
+		l3[(a >> 12) & 0x1ffu] = a | 3u | (1u << 2) | (1u << 6) | (3u << 8) | (1u << 10);
+	}
+	sweet_dcache_flush((vm_offset_t)(gpi_mem + PT_OFF), 0x4000u);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	vm_offset_t g1 = ml_io_map(SMMU_PA + pg, 0x1000);
+	vm_offset_t c = ml_io_map(SMMU_PA + (np + cb) * pg, 0x1000);
+	if (!g1 || !c) {
+		return 4;
+	}
+	wr(c, 0x0, 0);
+	wr(g1, 0x800u + 4u * cb, 1u);                   /* CBA2R: VA64 */
+	wr(g1, 4u * cb, 0x0001f300u);                   /* CBAR: S1, as touch/Android */
+	wr(c, 0x10, (7u << 15) | 2u);                   /* TCR2 */
+	wr(c, 0x38, 0xf404ff44u);                       /* MAIR0 */
+	wr(c, 0x3c, 0);
+	wr(c, 0x20, (uint32_t)pt);
+	wr(c, 0x24, (uint32_t)(pt >> 32));
+	wr(c, 0x28, 0);
+	wr(c, 0x2c, 0);
+	wr(c, 0x30, 0x0080351cu);                       /* TCR: T0SZ 28, 4K, WBWA ISH walks */
+	wr(c, 0x58, 0xffffffffu);
+	wr(c, 0x618, 0);
+	wr(c, 0x7f0, 0);
+	for (unsigned i = 0; i < 1000 && (rd(c, 0x7f4) & 1u); ++i) {
+		delay(1);
+	}
+	wr(c, 0x4, 3u);
+	wr(c, 0x0, 0x0a5f0067u);
+	static const uint32_t sids[2] = { 0x36u, 0x23u };
+	for (unsigned j = 0; j < 2; ++j) {
+		wr(s, 0xc00u + 4u * fr[j], 0x300u | cb | (exids ? (1u << 10) : 0u));
+		wr(s, 0x800u + 4u * fr[j], exids ? sids[j] : ((1u << 31) | sids[j]));
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpi_da = da;
+	for (int k = 0; k < 2; ++k) {
+		printf("SWEET GPI: smmu cb%u smr %u/%u s2cr %#x/%#x sctlr %#x fsr %#x gfsr %#x da %#llx pa %#llx\n", cb,
+		    fr[0], fr[1], rd(s, 0xc00u + 4u * fr[0]), rd(s, 0xc00u + 4u * fr[1]), rd(c, 0), rd(c, 0x58),
+		    rd(s, 0x48), da, pa);
+	}
+	return 0;
+}
+
+static int
+gpi_setup(void)
+{
+	gpi_teardown();
+	bzero(gpi_mem, 0x4000);
+	sweet_dcache_flush((vm_offset_t)gpi_mem, 0x4000);
+	tx_wp = rx_wp = ev_rp = 0;
+	wr(i2c7_gpi, GPII_INTSET, 1);
+	gpi_clr_irqs();
+
+	uint64_t ev = gpi_da + RING_EV;
+	if (!gpi_cmd(true, 0, 0, 1)) {                  /* EV ALLOCATE */
+		return 1;
+	}
+	wr(i2c7_gpi, EV_CTX + 0x00, (16u << 24) | (1u << 16) | 2u);
+	wr(i2c7_gpi, EV_CTX + 0x04, RING_SZ);
+	wr(i2c7_gpi, EV_CTX + 0x08, lo(ev));
+	wr(i2c7_gpi, EV_CTX + 0x0c, hi(ev));
+	wr(i2c7_gpi, EV_DB + 0x04, hi(ev));
+	wr(i2c7_gpi, EV_CTX + 0x20, 0);
+	wr(i2c7_gpi, EV_CTX + 0x28, 0);
+	wr(i2c7_gpi, EV_CTX + 0x2c, 0);
+	wr(i2c7_gpi, EV_CTX + 0x30, 0);
+	wr(i2c7_gpi, EV_CTX + 0x34, 0);
+	wr(i2c7_gpi, EV_DB, lo(ev + RING_SZ - 16u));
+
+	for (unsigned k = 0; k < 2; ++k) {
+		uint64_t r = gpi_da + (k ? RING_RX : RING_TX);
+		if (!gpi_cmd(false, k, 0, 1)) {         /* CH ALLOCATE */
+			return 2 + (int)k;
+		}
+		/* ch0 = TX (dir OUT 1), ch1 = RX (dir IN 0), erindex 0, proto GPI */
+		wr(i2c7_gpi, CH_CTX(k) + 0x00, (16u << 24) | ((k ? 0u : 1u) << 3) | 2u);
+		wr(i2c7_gpi, CH_CTX(k) + 0x04, RING_SZ);
+		wr(i2c7_gpi, CH_CTX(k) + 0x08, lo(r));
+		wr(i2c7_gpi, CH_CTX(k) + 0x0c, hi(r));
+		wr(i2c7_gpi, CH_DB(k) + 0x04, hi(r));
+		wr(i2c7_gpi, CH_SCR(k, 0), ((k ? 0u : 1u) << 16) | (3u << 4) | 0u);  /* pair, I2C, SE0 */
+		wr(i2c7_gpi, CH_SCR(k, 1), 0);
+		wr(i2c7_gpi, CH_SCR(k, 2), 0);
+		wr(i2c7_gpi, CH_SCR(k, 3), 0);
+		wr(i2c7_gpi, CH_QOS(k), 1);
+	}
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!gpi_cmd(false, 1u - k, 1, 2)) {    /* START rx, then tx */
+			return 4 + (int)k;
+		}
+	}
+	return 0;
+}
+
+static void
+put_tre(uint32_t ring, unsigned *wp, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(gpi_mem + ring + 16u * *wp);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	*wp = (*wp + 1u) % RING_N;
+}
+
+/* write nt (1..8) bytes, then optionally read nr (1..64) bytes, as one locked sequence */
+static int
+gpi_xfer(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	if (nt && nr) {
+		/* log368/370: write+read in one sequence -> XFER code 0x10 on the imm DMA; do write+STOP, then read */
+		int e = gpi_xfer(addr, tx, nt, NULL, 0);
+		if (e) {
+			return e;
+		}
+		nt = 0;
+	}
+	uint32_t imm[2] = { 0, 0 };
+	for (unsigned j = 0; j < nt; ++j) {
+		imm[j / 4] |= (uint32_t)tx[j] << (8u * (j % 4));
+	}
+	bool rd2 = nr != 0;
+	uint64_t txr = gpi_da + RING_TX, rxr = gpi_da + RING_RX, evr = gpi_da + RING_EV;
+
+	put_tre(RING_TX, &tx_wp, 0, 0, 0, (3u << 20) | 1u);                            /* LOCK, chain */
+	put_tre(RING_TX, &tx_wp, (3u << 24) | (22u << 16) | (3u << 8) | 11u, 0, 2u,
+	    (2u << 20) | (2u << 16) | 1u);                                             /* CONFIG0 400k */
+	if (nt) {
+	put_tre(RING_TX, &tx_wp, ((uint32_t)addr << 8) | 1u, 0, 0,
+	    (2u << 20) | 1u);                                                          /* GO write */
+	put_tre(RING_TX, &tx_wp, imm[0], imm[1], nt & 0xfu,
+	    (1u << 20) | (1u << 16) | (1u << 9));                                      /* imm DMA, ieot, no chain (log368: chain -> 0x10 UNEXP) */
+	}
+	if (rd2) {
+		uint64_t b = gpi_da + BUF_RX;
+		put_tre(RING_RX, &rx_wp, lo(b), hi(b), nr, (1u << 20) | (1u << 9));    /* RX DMA, ieot */
+		put_tre(RING_TX, &tx_wp, ((uint32_t)addr << 8) | 2u, 0, nr,
+		    (2u << 20) | (1u << 11));                                          /* GO read, link_rx */
+	}
+	put_tre(RING_TX, &tx_wp, 0, 0, 0, (3u << 20) | (1u << 16) | (1u << 8));        /* UNLOCK, ieob */
+	sweet_dcache_flush((vm_offset_t)gpi_mem, 0x1100u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (rd2) {
+		wr(i2c7_gpi, CH_DB(1), lo(rxr + 16u * rx_wp));
+	}
+	wr(i2c7_gpi, CH_DB(0), lo(txr + 16u * tx_wp));
+
+	int err = ETIMEDOUT;
+	uint32_t evt[4] = { 0, 0, 0, 0 }, nev = 0, notif = 0;
+	for (unsigned i = 0; i < 30000; ++i) {
+		uint32_t erp = rd(i2c7_gpi, EV_CTX + 0x10);
+		unsigned eidx = ((erp - lo(evr)) / 16u) % RING_N;
+		if (eidx != ev_rp) {
+			sweet_dcache_flush((vm_offset_t)(gpi_mem + RING_EV), RING_SZ);
+			while (ev_rp != eidx) {
+				volatile uint32_t *e = (volatile uint32_t *)(gpi_mem + RING_EV + 16u * ev_rp);
+				for (unsigned j = 0; j < 4; ++j) {
+					evt[j] = e[j];
+				}
+				uint32_t type = (evt[3] >> 16) & 0xffu;
+				if (type == 0x31u) {
+					notif = evt[0] ? evt[0] : 0x80000000u;
+				} else if (type == 0x22u) {
+					uint32_t code = evt[2] >> 24;
+					if (code != 1u && code != 2u && code != 4u) {
+						notif = 0x40000000u | code;
+					}
+				}
+				++nev;
+				ev_rp = (ev_rp + 1u) % RING_N;
+			}
+			wr(i2c7_gpi, EV_DB, lo(evr + 16u * ((ev_rp + RING_N - 1u) % RING_N)));
+		}
+		bool txd = rd(i2c7_gpi, CH_CTX(0) + 0x10) == lo(txr + 16u * tx_wp);
+		bool rxd = !rd2 || rd(i2c7_gpi, CH_CTX(1) + 0x10) == lo(rxr + 16u * rx_wp);
+		if (notif) {
+			err = (notif & 0x40000000u) ? EIO : ENXIO;
+			break;
+		}
+		if (txd && rxd) {
+			err = 0;
+			break;
+		}
+		if (ch_state(0) == 0xfu || ch_state(1) == 0xfu) {
+			err = EIO;
+			break;
+		}
+		delay(1);
+	}
+	if (gpi_logs < 8) {
+		++gpi_logs;
+		printf("SWEET GPI: x%d a%02x n%u/%u e%d tx %x/%x rx %x/%x st %x/%x/%x ev%u %08x %08x %08x %08x el %x\n",
+		    gpi_logs, addr, nt, nr, err, rd(i2c7_gpi, CH_CTX(0) + 0x10), lo(txr + 16u * tx_wp),
+		    rd(i2c7_gpi, CH_CTX(1) + 0x10), lo(rxr + 16u * rx_wp), ch_state(0), ch_state(1), ev_state(),
+		    nev, evt[0], evt[1], evt[2], evt[3], rd(i2c7_gpi, GPII_ERRLOG));
+	}
+	if (!err && rd2) {
+		sweet_dcache_flush((vm_offset_t)(gpi_mem + BUF_RX), 64);
+		for (unsigned j = 0; j < nr; ++j) {
+			rx[j] = gpi_mem[BUF_RX + j];
+		}
+	}
+	if (err) {
+		int s = gpi_setup();                    /* channel may be stuck/locked: start over */
+		if (s && gpi_logs < 10) {
+			++gpi_logs;
+			printf("SWEET GPI: re-setup failed %d\n", s);
+		}
+	}
+	return err;
+}
+
+int
+sweet_i2c7_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (!i2c7_ready || len == 0 || len > 64) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c7_lock);
+	if (i2c7_gsi) {
+		int e = gpi_xfer(addr, &reg, 1, buf, len);
+		lck_mtx_unlock(&sweet_i2c7_lock);
+		return e;
+	}
+	int err = i2c7_msg(addr, &reg, 1, NULL, 0, true);
+	if (!err) {
+		err = i2c7_msg(addr, NULL, 0, buf, len, false);
+	}
+	lck_mtx_unlock(&sweet_i2c7_lock);
+	return err;
+}
+
+/* One register write (TopazAudio: the sia8159 speaker amp at 0x2b). */
+int
+sweet_i2c7_write(uint8_t addr, uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = { reg, val };
+
+	if (!i2c7_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c7_lock);
+	int err = i2c7_gsi ? gpi_xfer(addr, tx, 2, NULL, 0) : i2c7_msg(addr, tx, 2, NULL, 0, false);
+	lck_mtx_unlock(&sweet_i2c7_lock);
+	return err;
+}
+
+int
+sweet_i2c7_init(void)
+{
+	if (i2c7_ready) {
+		return 0;
+	}
+	i2c7_gcc = ml_io_map(I2C7_GCC_PA, 0x80000);
+	i2c7_west = ml_io_map(I2C7_WEST_PA, 0x2000);
+	i2c7_se = ml_io_map(I2C7_SE_PA, 0x4000);
+	if (!i2c7_gcc || !i2c7_west || !i2c7_se) {
+		return ENOMEM;
+	}
+	/* OR our votes in: other bits of the shared register belong to others */
+	/* volcano QUP1: core 0x1, s_ahb 0x2, m_ahb 0x4, core2x 0x8, SE6 0x400 (gcc-volcano.ko) */
+	wr(i2c7_gcc, I2C7_GCC_VOTE, rd(i2c7_gcc, I2C7_GCC_VOTE) | 0x1fu);
+	/* SE6 RCG: XO 19.2 MHz, no divider */
+	wr(i2c7_gcc, I2C7_RCG + 4, 0);
+	wr(i2c7_gcc, I2C7_RCG, rd(i2c7_gcc, I2C7_RCG) | 1u);
+	(void)wait_clear(i2c7_gcc, I2C7_RCG, 1u);
+	if (!wait_clear(i2c7_gcc, I2C7_CBCR, 1u << 31)) {
+		printf("SWEET I2C7: SE1 clock off (cbcr %#x)\n", rd(i2c7_gcc, I2C7_CBCR));
+		return EIO;
+	}
+	/* GPIO4/5: function 1 (qup1), 2 mA, no pull (TopazBattery CTL 0x4) */
+	/* GPIO59 SDA / GPIO60 SCL: function 1 (qup1_se6), 2 mA, pull-up */
+	wr(i2c7_west, 0x0000, (rd(i2c7_west, 0x0000) & ~0x3ffu) | 0x4u | 0x3u);
+	wr(i2c7_west, 0x1000, (rd(i2c7_west, 0x1000) & ~0x3ffu) | 0x4u | 0x3u);
+
+	uint32_t fw = rd(i2c7_se, SE_FW), rxp = rd(i2c7_se, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3u || (rd(i2c7_se, SE_STATUS) & 0x1001u)) {
+		printf("SWEET I2C7: SE1 not an idle I2C engine (fw %#x status %#x)\n",
+		    fw, rd(i2c7_se, SE_STATUS));
+		return EIO;
+	}
+	if (rd(i2c7_se, 0x64) & 1u) {
+		/* GSI only: geni_se_select_gpi_mode() then bring up our GPII */
+		i2c7_gpi = ml_io_map(GPI_PA, GPI_SZ);
+		gpi_pa = ml_vtophys((vm_offset_t)gpi_mem);
+		if (!i2c7_gpi || !gpi_pa) {
+			return ENOMEM;
+		}
+		int sm = i2c7_smmu();
+		if (sm) {
+			printf("SWEET GPI: smmu setup failed %d, no GSI\n", sm);
+			return EIO;
+		}
+		wr(i2c7_se, SE_IRQ_CLR, 0xffffffffu);
+		wr(i2c7_se, 0x648, 0xffffffffu);
+		wr(i2c7_se, 0xe1c, 0);
+		wr(i2c7_se, SE_IRQ_EN, rd(i2c7_se, SE_IRQ_EN) & ~(SE_DONE | SE_TX_WM_IRQ | (3u << 26)));
+		wr(i2c7_se, SE_DMA, 1);
+		wr(i2c7_se, 0xe18, rd(i2c7_se, 0xe18) | 0xfu);
+		unsigned s0 = ch_state(0), s1 = ch_state(1), se = ev_state();
+		int s = gpi_setup();
+		printf("SWEET GPI: setup %d pa %#llx pre %x/%x/%x now %x/%x/%x el %x\n", s, gpi_pa,
+		    s0, s1, se, ch_state(0), ch_state(1), ev_state(), rd(i2c7_gpi, GPII_ERRLOG));
+		printf("SWEET GPI: setup %d pa %#llx pre %x/%x/%x now %x/%x/%x el %x\n", s, gpi_pa,
+		    s0, s1, se, ch_state(0), ch_state(1), ev_state(), rd(i2c7_gpi, GPII_ERRLOG));
+		if (s) {
+			return EIO;
+		}
+		i2c7_gsi = true;
+		i2c7_ready = true;
+		return 0;
+	}
+	wr(i2c7_se, 0xe18, 0);
+	wr(i2c7_se, 0xe1c, 0);
+	wr(i2c7_se, 0x644, 0);
+	wr(i2c7_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c7_se, 0x648, 0xffffffffu);
+	wr(i2c7_se, SE_DMA, 0);
+	wr(i2c7_se, 0x28, rd(i2c7_se, 0x28) | 0x7fu);
+	wr(i2c7_se, 0xe30, rd(i2c7_se, 0xe30) | 0x0fu);
+	wr(i2c7_se, 0x24, 0x7f);
+	wr(i2c7_se, 0x20, 1);
+	wr(i2c7_se, SE_CLK_SEL, 0);
+	wr(i2c7_se, SE_MCLK, (2u << 4) | 1u);                  /* 400 kHz from 19.2 MHz */
+	wr(i2c7_se, SE_SCL, (5u << 20) | (11u << 10) | 22u);
+	wr(i2c7_se, 0x254, 0);
+	wr(i2c7_se, 0x260, SE_PACK0);
+	wr(i2c7_se, 0x264, SE_PACK1);
+	wr(i2c7_se, 0x284, SE_PACK0);
+	wr(i2c7_se, 0x288, SE_PACK1);
+	wr(i2c7_se, SE_TX_WM, 0);
+	wr(i2c7_se, 0x810, 0);
+	wr(i2c7_se, 0x814, ((rxp >> 16) & 0x3fu) - 1u);
+	wr(i2c7_se, SE_IRQ_EN, SE_DONE | SE_ERRORS | (3u << 26) | SE_TX_WM_IRQ);
+	i2c7_ready = true;
+	printf("SWEET I2C7: SE0 ready (fw %#x vote %#x ifdis %#x gpio32 %#x/%#x gpio33 %#x/%#x)\n", fw, rd(i2c7_gcc, I2C7_GCC_VOTE),
+	    rd(i2c7_se, 0x64), rd(i2c7_west, 0), rd(i2c7_west, 4), rd(i2c7_west, 0x1000), rd(i2c7_west, 0x1004));
+	return 0;
+}
+
+/*
+ * Minimal SPMI arbiter v7 write (apps EE 0) for PMR735B (SID 5) GPIO3/4
+ * = WL28681 camera-PMIC reset lines. Android state: 0x40=01 41=01 42=05
+ * 44=80 45=03 46=80 (out high). Channel: chnls + 0x1000*apid, CMD 0,
+ * STATUS 8, WDATA0 0x10; cmd v2 fmt (opc<<27)|((addr&0xff)<<4)|bc.
+ */
+#define SPMI_CORE_PA    0x0c400000u
+#define SPMI_CNFG_PA    0x0c42d000u
+#define SPMI_CHNL_PA    0x0c500000u
+#define SPMI_OBS_PA     0x0c440000u
+static vm_offset_t spmi_core, spmi_cnfg, spmi_obs;
+
+static int
+spmi_apid(uint16_t ppid, uint32_t *owner)
+{
+	uint32_t count = rd(spmi_core, 4) & 0x7ffu;
+	int found = -1;
+	if (count > 1024) {
+		count = 1024;
+	}
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t m = rd(spmi_core, 0x2000u + 4u * i);
+		if (m == 0 || ((m >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t o = rd(spmi_cnfg, 4u * i) & 7u;
+		if (found < 0 || o == 0) {
+			found = (int)i;
+			*owner = o;
+		}
+	}
+	return found;
+}
+
+static int
+spmi_rd8(int apid, uint16_t addr, uint8_t *v)
+{
+	uint32_t off = 0x20u * (uint32_t)apid;
+	wr(spmi_obs, off, (1u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = rd(spmi_obs, off + 8);
+		if (st & 1u) {
+			if (st & 0xeu) {
+				return (int)st;
+			}
+			*v = (uint8_t)rd(spmi_obs, off + 0x18);
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+spmi_wr8(vm_offset_t ch, uint16_t addr, uint8_t v)
+{
+	wr(ch, 0x10, v);
+	wr(ch, 0x00, (0u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = rd(ch, 8);
+		if (st & 1u) {
+			return (st & 0xeu) ? (int)st : 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/*
+ * mode: 0 = drive low (WL28681 in reset), 1 = drive high (released).
+ * gpio: 0 = PMR735B gpio3 (0x8a00, chip at 0x35), 1 = gpio4 (0x8b00, the "_j" chip, reprogrammed to 0x61).
+ */
+int sweet_pmic_cam_gpio(int gpio, int high);
+int
+sweet_pmic_cam_gpio(int gpio, int high)
+{
+	static const uint8_t ra[6] = { 0x41, 0x42, 0x45, 0x44, 0x40, 0x46 };
+	uint8_t rv[6] = { 0x01, 0x05, 0x03, 0x80, 0x01, 0x80 };
+	if (!high) {
+		rv[3] = 0x00;
+	}
+	if (!spmi_core) {
+		spmi_core = ml_io_map(SPMI_CORE_PA, 0x3000);
+		spmi_cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+		spmi_obs = ml_io_map(SPMI_OBS_PA, 0x8000);
+	}
+	if (!spmi_core || !spmi_cnfg || !spmi_obs) {
+		return -2;
+	}
+	uint16_t ppid = (uint16_t)((5u << 8) | (0x8au + (unsigned)(gpio & 1)));
+	uint32_t owner = 9;
+	int apid = spmi_apid(ppid, &owner);
+	uint8_t t = 0, st = 0, b[6] = {}, a[6] = {};
+	int e = -3, w[6] = { 9, 9, 9, 9, 9, 9 };
+	if (apid >= 0) {
+		e = spmi_rd8(apid, 0x04, &t) | spmi_rd8(apid, 0x05, &st);
+		for (int i = 0; i < 6; i++) {
+			spmi_rd8(apid, ra[i], &b[i]);
+		}
+		if (!e && t == 0x10 && st == 0x11 && owner == 0) {
+			vm_offset_t ch = ml_io_map(SPMI_CHNL_PA + 0x1000u * (uint32_t)apid, 0x1000);
+			for (int i = 0; ch && i < 6; i++) {
+				w[i] = spmi_wr8(ch, ra[i], rv[i]);
+			}
+			delay(1000);
+			for (int i = 0; i < 6; i++) {
+				spmi_rd8(apid, ra[i], &a[i]);
+			}
+		}
+	}
+	for (int k = 0; k < 2; k++) {
+		printf("@@P@@ ppid %#x hi %d apid %d own %u e %d type %02x/%02x before %02x %02x %02x %02x %02x %02x wr %d %d %d %d %d %d after %02x %02x %02x %02x %02x %02x\n",
+		    ppid, high, apid, owner, e, t, st, b[0], b[1], b[2], b[3], b[4], b[5],
+		    w[0], w[1], w[2], w[3], w[4], w[5], a[0], a[1], a[2], a[3], a[4], a[5]);
+	}
+	return (apid < 0 || e || w[5] || a[3] != rv[3]) ? -1 : 0;
+}
+
+/*
+ * Camera slot0 bring-up probe (volcano): GCC camera clocks, CAMCC gdsc + XO
+ * clocks for cci0/mclk0, TLMM (gpio83 MCLK0, 88/89 CCI0 M0, 40 reset), then a
+ * polled CCI0 master0 16-bit register read of the main sensor (0x20, reg 0).
+ */
+#define CAM_GCC_PA   0x00100000u
+#define CAM_CC_PA    0x0adb0000u
+#define CAM_CCI0_PA  0x0ac15000u
+#define CAM_TLMM_PA  0x0f100000u
+#define R32(b, o)    (*(volatile uint32_t *)((b) + (o)))
+
+static uint32_t
+cam_poll(vm_offset_t b, uint32_t o, uint32_t mask, uint32_t want, int us)
+{
+	uint32_t v = R32(b, o);
+	while (((v & mask) != want) && us-- > 0) {
+		delay(1);
+		v = R32(b, o);
+	}
+	return v;
+}
+
+static void
+cam_gpio(int gpio, uint32_t cfg, int out)
+{
+	vm_offset_t t = ml_io_map(CAM_TLMM_PA + 0x1000u * (uint32_t)gpio, 0x1000);
+	if (!t) {
+		return;
+	}
+	uint32_t before = R32(t, 0);
+	if (out >= 0) {
+		R32(t, 4) = out ? 2u : 0u;
+	}
+	R32(t, 0) = cfg;
+	printf("@@Q@@ gpio %d cfg %#x -> %#x io %#x\n", gpio, before, R32(t, 0), R32(t, 4));
+}
+
+static vm_offset_t cam_cci;
+
+static uint32_t
+cam_cci_run(int q, uint32_t donemask)
+{
+	uint32_t cnt = R32(cam_cci, 0x304 + 0x100 * q);
+	R32(cam_cci, 0x300 + 0x100 * q) = cnt;
+	R32(cam_cci, 0x008) = 1u << q;
+	uint32_t st = 0;
+	for (int i = 0; i < 20000; i++) {
+		st = R32(cam_cci, 0xc0c);
+		if (st & (donemask | 0x18000ee6u)) {
+			break;
+		}
+		delay(5);
+	}
+	for (int k = 0; k < 3; k++) {
+		printf("@@Q@@ q%d cnt %u st %#x exec %#x cur %#x cmd %#x rep %#x mask %#x\n", q, cnt, st,
+		    R32(cam_cci, 0x300 + 0x100 * q), R32(cam_cci, 0x304 + 0x100 * q), R32(cam_cci, 0x308 + 0x100 * q),
+		    R32(cam_cci, 0x30c + 0x100 * q), R32(cam_cci, 0xc04));
+	}
+	R32(cam_cci, 0xc08) = st;
+	R32(cam_cci, 0xc00) = 1;
+	if (st & 0x18000ee6u) {
+		R32(cam_cci, 0x034) = 1;   /* halt M0 */
+		delay(1000);
+		uint32_t s2 = R32(cam_cci, 0xc0c);
+		R32(cam_cci, 0xc08) = s2;
+		R32(cam_cci, 0xc00) = 1;
+		R32(cam_cci, 0x004) = 0x3f1u; /* reset M0 */
+		delay(1000);
+		s2 = R32(cam_cci, 0xc0c);
+		R32(cam_cci, 0xc08) = s2;
+		R32(cam_cci, 0xc00) = 1;
+	}
+	return st;
+}
+
+/* returns 16-bit value or negative; addr is 8-bit */
+static int
+cam_cci_rd16(uint8_t addr8, uint16_t reg, uint32_t *wst, uint32_t *rst, uint32_t *raw0, uint32_t *raw1, uint32_t *lvl)
+{
+	uint32_t a7 = (addr8 >> 1) & 0x7f;
+	R32(cam_cci, 0x310) = 1u | (a7 << 4);                 /* Q0 SET_PARAM */
+	R32(cam_cci, 0x310) = 9u | (2u << 4) | ((uint32_t)(reg >> 8) << 8) | ((uint32_t)(reg & 0xff) << 16);
+	R32(cam_cci, 0x310) = 8u | (1u << 8);                 /* REPORT + irq */
+	*wst = cam_cci_run(0, 1u << 4);
+	if (*wst & 0x18000ee6u) {
+		return -1;
+	}
+	R32(cam_cci, 0x410) = 1u | (a7 << 4);                 /* Q1 SET_PARAM */
+	R32(cam_cci, 0x410) = 10u | (2u << 4);                /* READ 2 */
+	*rst = cam_cci_run(1, 1u);
+	*lvl = R32(cam_cci, 0x11c);
+	*raw0 = *lvl ? R32(cam_cci, 0x118) : 0;
+	*raw1 = (*lvl > 1) ? R32(cam_cci, 0x118) : 0;
+	if (*rst & 0x18000ee6u) {
+		return -2;
+	}
+	/* LS byte of first word is skipped (see i2c-qcom-cci.c) */
+	return (int)((((*raw0 >> 8) & 0xff) << 8) | ((*raw0 >> 16) & 0xff));
+}
+
+int sweet_cam_probe(void);
+int
+sweet_cam_probe(void)
+{
+	vm_offset_t g = ml_io_map(CAM_GCC_PA, 0x80000);
+	vm_offset_t c = ml_io_map(CAM_CC_PA, 0x40000);
+	if (!g || !c) {
+		return -9;
+	}
+	uint32_t g0 = R32(g, 0x26004), g1 = R32(g, 0x26018), g2 = R32(g, 0x2601c), g3 = R32(g, 0x26010);
+	R32(g, 0x26004) |= 1; R32(g, 0x26018) |= 1; R32(g, 0x2601c) |= 1; R32(g, 0x26010) |= 1;
+	delay(100);
+	printf("@@Q@@ gcc cam ahb %#x->%#x hfxo %#x->%#x sfxo %#x->%#x hfaxi %#x->%#x\n",
+	    g0, R32(g, 0x26004), g1, R32(g, 0x26018), g2, R32(g, 0x2601c), g3, R32(g, 0x26010));
+	if (R32(g, 0x26004) & 0x80000000u) {
+		printf("@@Q@@ camera ahb clk still off, abort\n");
+		return -1;
+	}
+	uint32_t gd0 = R32(c, 0x25004), gc0 = R32(c, 0x25008);
+	printf("@@Q@@ camcc gdsc %#x cfg %#x gdscclk %#x sleep %#x cpas %#x core %#x cci %#x mclk %#x\n",
+	    gd0, gc0, R32(c, 0x25038), R32(c, 0x2505c), R32(c, 0x23004), R32(c, 0x2501c), R32(c, 0x2101c), R32(c, 0x1801c));
+	R32(c, 0x25038) |= 1;
+	R32(c, 0x2505c) |= 1;
+	delay(100);
+	if (gd0 & 1) {
+		R32(c, 0x25004) = gd0 & ~1u;
+	}
+	uint32_t gd = cam_poll(c, 0x25004, 0x80000000u, 0x80000000u, 100000);
+	printf("@@Q@@ gdsc on %#x cfg %#x\n", gd, R32(c, 0x25008));
+	if (!(gd & 0x80000000u)) {
+		return -2;
+	}
+	/* RCGs from XO: CFG=0 (bypass, src0), M/N/D 0, UPDATE */
+	static const uint32_t rcg[5] = { 0x1a04c, 0x21004, 0x18004, 0x2401c, 0x1a030 };
+	for (int i = 0; i < 5; i++) {
+		uint32_t cmd0 = R32(c, rcg[i]), cfg0 = R32(c, rcg[i] + 4);
+		R32(c, rcg[i] + 4) = 0;
+		if (i == 1 || i == 2) {
+			R32(c, rcg[i] + 8) = 0; R32(c, rcg[i] + 0xc) = 0; R32(c, rcg[i] + 0x10) = 0;
+		}
+		R32(c, rcg[i]) = cmd0 | 3u;    /* UPDATE + ROOT_EN (force root on) */
+		uint32_t cmd = cam_poll(c, rcg[i], 1u, 0u, 2000);
+		printf("@@Q@@ rcg %#x cmd %#x cfg %#x -> cmd %#x cfg %#x\n", rcg[i], cmd0, cfg0, cmd, R32(c, rcg[i] + 4));
+	}
+	static const uint32_t br[9] = { 0x23004, 0x2501c, 0x24010, 0x24004, 0x2101c, 0x1801c, 0x25018, 0x24034, 0x2404c };
+	uint32_t bv[9];
+	for (int i = 0; i < 9; i++) {
+		R32(c, br[i]) |= 1;
+		bv[i] = cam_poll(c, br[i], 0x80000000u, 0u, 5000);
+	}
+	for (int k = 0; k < 3; k++) {
+		printf("@@Q@@ br cpas %#x core %#x hfaxi %#x sfaxi %#x cci %#x mclk %#x\n", bv[0], bv[1], bv[2], bv[3], bv[4], bv[5]);
+		printf("@@Q@@ br2 soc %#x rt %#x nrt %#x\n", bv[6], bv[7], bv[8]);
+	}
+	if ((bv[0] | bv[1] | bv[4]) & 0x80000000u) {
+		printf("@@Q@@ cci clocks off, abort\n");
+		return -3;
+	}
+	/* pins: reset low, CCI pull-up func1, MCLK func1 */
+	cam_gpio(40, 0x200u, 0);           /* gpio, OE, out low */
