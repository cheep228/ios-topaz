+	c = put32(c, pw);
+	c = put32(c, 0);
+	c = wmi_put_tlv(c, TAG_ARRAY_STRUCT, 12);
+	c = wmi_put_tlv(c, 0x3b6, 8);
+	c = put32(c, freq);
+	put32(c, pw);
+	bool ok = wmi_send(0x502b, m, sizeof(m));
+	for (int k = 0; k < 2; k++) {
+		LOG("t=%u ms: fix133 andr tpc %u dBm @%u %s", g_ms, pw, freq, ok ? "sent" : "FAILED");
