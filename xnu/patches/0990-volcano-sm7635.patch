+/* ath11k_dp_alloc: srng_common_setup + wbm idle list + reo_setup, then pdev rx rings with buffers */
+static void
+dp_common_setup(void)
+{
+	uint64_t link_pa = 0;
+	if (dp_up || !volcano) {
+		return;
+	}
+	dp_rdp = (volatile uint32_t *)pool_alloc(0x1000, &dp_rdp_pa);
+	dp_wrp = (volatile uint32_t *)pool_alloc(0x1000, &dp_wrp_pa);
+	bool ok = dp_rdp != NULL && dp_wrp != NULL;
+	for (uint32_t i = 0; i < 4 && ok; i++) {
+		ok = dp_alloc(&dp_reo[i], 16, 256, i);
+	}
+	ok = ok && dp_alloc(&dp_reo_exc, 16, 128, 4) && dp_alloc(&dp_reo_reinj, 8, 32, 5) &&
+	    dp_alloc(&dp_reo_cmd, 10, 64, 8) && dp_alloc(&dp_reo_sts, 26, 64, 9) && dp_alloc(&dp_tcl0, 8, 512, 16) &&
+	    dp_alloc(&dp_tcl_cmd, 8, 32, 24) && dp_alloc(&dp_tcl_sts, 9, 32, 25) && dp_alloc(&dp_idle, 2, DP_N_LINK, 104) &&
+	    dp_alloc(&dp_sw2wbm, 8, 64, 105) && dp_alloc(&dp_wbm0, 8, 512, 106) && dp_alloc(&dp_rxrel, 8, 1024, 109) &&
+	    dp_alloc(&dp_wbm1, 8, 1024, 107) && dp_alloc(&dp_wbm2, 8, 512, 108) && dp_alloc(&dp_wbm4, 8, 512, 110) &&
+	    dp_alloc(&dp_refill, 2, DP_N_REFILL, 111) && dp_alloc(&dp_macbuf, 2, 1024, 112) &&
+	    dp_alloc(&dp_mon, 2, DP_N_MON, 115) && dp_alloc(&dp_rxerr, 8, 1024, 116) &&
+	    dp_alloc(&dp_macbuf1, 2, 1024, 112 + 9) && dp_alloc(&dp_rxerr1, 8, 1024, 116 + 9);   /* mac_id 1: +HAL_SRNG_RINGS_PER_LMAC */
+	uint8_t *link = ok ? (uint8_t *)pool_alloc((uint64_t)DP_N_LINK * 128, &link_pa) : NULL;
+	dp_rxb = link != NULL ? (uint8_t *)pool_alloc((uint64_t)DP_N_REFILL * DP_BUF, &dp_rxb_pa) : NULL;
+	dp_monb = dp_rxb != NULL ? (uint8_t *)pool_alloc((uint64_t)DP_N_MON * DP_BUF, &dp_monb_pa) : NULL;
+	if (dp_monb == NULL) {
+		for (int k = 0; k < 3; k++) {
+			LOG("t=%u ms: dp: alloc failed (pool used %llu)", g_ms, pool_used);
+		}
+		return;
+	}
+	for (uint32_t i = 0; i < 4; i++) {
+		dp_dst_hw(&dp_reo[i], DP_REO + 0x1ec + 0x58 * i, DP_REO + 0x3028 + 8 * i);
+	}
+	dp_dst_hw(&dp_reo_exc, DP_REO + 0x3fc, DP_REO + 0x3058);
+	dp_src_hw(&dp_reo_reinj, DP_REO + 0x13c, DP_REO + 0x3018, false);
+	dp_src_hw(&dp_reo_cmd, DP_REO + 0xe4, DP_REO + 0x3010, false);
+	dp_dst_hw(&dp_reo_sts, DP_REO + 0x504, DP_REO + 0x3070);
+	dp_src_hw(&dp_tcl0, DP_TCL + 0x694, DP_TCL + 0x2000, false);
+	dp_src_hw(&dp_tcl_cmd, DP_TCL + 0x79c, DP_TCL + 0x2018, false);
+	dp_dst_hw(&dp_tcl_sts, DP_TCL + 0x8a4, DP_TCL + 0x2030);
+	dp_src_hw(&dp_idle, DP_WBM + 0x874, DP_WBM + 0x30b0, true);
+	dp_src_hw(&dp_sw2wbm, DP_WBM + 0x1ec, DP_WBM + 0x3018, false);
+	dp_dst_hw(&dp_wbm0, DP_WBM + 0x924, DP_WBM + 0x30c0);
+	dp_dst_hw(&dp_rxrel, DP_WBM + 0x924 + 0x58 * 3, DP_WBM + 0x30c0 + 8 * 3);
+	dp_dst_hw(&dp_wbm1, DP_WBM + 0x924 + 0x58 * 1, DP_WBM + 0x30c0 + 8 * 1);
+	dp_dst_hw(&dp_wbm2, DP_WBM + 0x924 + 0x58 * 2, DP_WBM + 0x30c0 + 8 * 2);
+	dp_dst_hw(&dp_wbm4, DP_WBM + 0x924 + 0x58 * 4, DP_WBM + 0x30c0 + 8 * 4);
+
+	/* link descriptor idle list: one bank, cookie = bank 0, RBM = WBM idle desc list */
+	for (uint32_t i = 0; i < DP_N_LINK - 1; i++) {
+		dp_buf_info(dp_idle.va + 2 * i, link_pa + 128ull * i, ((i + 0x4000u) << 3) | 0, DP_RBM_IDLE_DESC);
+	}
+	dp_idle.idx = DP_N_LINK - 1;
+	mb();
+	vce_ptr_wr(dp_idle.ptr_reg, dp_idle.idx * 2);
+
+	/* ath11k_hw_wcn6855_reo_setup */
+	uint32_t v = w_v_rd(DP_REO + 0x0);
+	w_v_wr(DP_REO + 0x0, v | (1u << 2) | (1u << 3));
+	uint32_t mc = w_v_rd(DP_REO + 0x5d8);
+	w_v_wr(DP_REO + 0x5d8, mc & ~(0xFu << 17));  /* fragment dst ring = REO2SW1 */
+	for (uint32_t i = 0; i < 4; i++) {
+		w_v_wr(DP_REO + 0x564 + 4 * i, 40000);
+	}
+	w_v_wr(DP_REO + 0x0c, 0x43214321);
+	w_v_wr(DP_REO + 0x10, 0x43214321);
+
+	/* rx buffers: refill ring (host -> fw) and monitor status ring */
+	memset(dp_rxb, 0, (size_t)DP_N_REFILL * DP_BUF);
+	memset(dp_monb, 0, (size_t)DP_N_MON * DP_BUF);
+	mb();
+	for (uint32_t i = 0; i < DP_REFILL_POST; i++) {     /* experiment: fw asserts DmaLeak once it holds host buffers */
+		dp_lmac_post(&dp_refill, dp_rxb_pa + (uint64_t)i * DP_BUF, i + 1);
+	}
+	dp_lmac_publish(&dp_refill);
+	/* experiment: fw never moves refill buffers into the mac buf ring; host feeds RXDMA directly */
+	for (uint32_t i = 0; i < DP_N_MON - 1; i++) {
+		dp_lmac_post(&dp_mon, dp_monb_pa + (uint64_t)i * DP_BUF, 0x10000 + i);
+	}
+	dp_lmac_publish(&dp_mon);
+	dp_up = true;
+	uint32_t r1 = w_v_rd(DP_REO + 0x1ec), r2 = w_v_rd(DP_REO + 0x1fc), r3 = w_v_rd(DP_WBM + 0x884);
+	uint32_t r4 = w_v_rd(DP_REO + 0x0);
+	for (int k = 0; k < 3; k++) {
+		LOG("t=%u ms: dp: rings up, rdp %llx wrp %llx links %llx rxb %llx | REO1 base %08x misc %08x idle misc %08x gen %08x (was %08x) misc_ctl %08x",
+		    g_ms, dp_rdp_pa, dp_wrp_pa, link_pa, dp_rxb_pa, r1, r2, r3, r4, v, mc);
+	}
+}
