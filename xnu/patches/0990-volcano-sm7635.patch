+/* a native wifi frame (802.11 header without QoS, LLC, payload) */
+static bool
+dp_tx_frame(const uint8_t *f, uint32_t len)
+{
+	if (!dp_up || len == 0 || len > DP_BUF) {
+		return false;
+	}
+	if (dtx_pool == NULL) {
+		dtx_pool = (uint8_t *)pool_alloc((uint64_t)DTX_SLOTS * DP_BUF, &dtx_pool_pa);
+		if (dtx_pool == NULL) {
+			return false;
+		}
+	}
+	int slot = -1;
+	for (int i = 0; i < DTX_SLOTS; i++) {
+		if (!(dtx_busy & (1u << i))) {
+			slot = i;
+			break;
+		}
+	}
+	uint32_t tp = (dp_rdp[dp_tcl0.id] / dp_tcl0.words) % dp_tcl0.n;
+	uint32_t nx = (dp_tcl0.idx + 1) % dp_tcl0.n;
+	if (slot < 0 || nx == tp) {
+		dtx_full++;
+		return false;
+	}
+	uint8_t *b = dtx_pool + (uint64_t)slot * DP_BUF;
+	uint64_t pa = dtx_pool_pa + (uint64_t)slot * DP_BUF;
+	memcpy(b, f, len);
+	volatile uint32_t *e = dp_tcl0.va + dp_tcl0.words * dp_tcl0.idx;
+	e[0] = (0x144u << 1) | (28u << 10);         /* TLV hdr HAL_TCL_DATA_CMD (ath11k_hal_tx_init_data_ring) */
+	dp_buf_info(e + 1, pa, (DTX_COOKIE0 + (uint32_t)slot) << 2, DP_RBM_SW0);
+	e[3] = (1u << 2) | (2u << 14) | (1u << 16); /* nwifi encap, ADDRY_EN, metadata: vdev-based, vdev 0, pdev 0 */
+	e[4] = len;
+	e[5] = 1u << 21;                            /* TID_OVERWRITE, tid 0, lmac 0 */
+	e[6] = 0;
+	e[7] = 0;
+	mb();
+	dp_tcl0.idx = nx;
+	vce_ptr_wr(dp_tcl0.ptr_reg, nx * dp_tcl0.words);
+	dtx_busy |= 1u << slot;
+	dtx_last = slot;
+	dtx_sent++;
+	if (dtx_sent <= 6) {
+		char h[80];
+		w_hex(h, sizeof(h), f, MIN(len, 34u));
+		for (int k = 0; k < 2; k++) {
+			LOG("t=%u ms: dp tx #%u slot %d len %u: %s", g_ms, dtx_sent, slot, len, h);
+		}
+	}
+	return true;
+}
+
+static void
+dp_tx_done(volatile uint32_t *e, uint32_t cookie)
+{
+	uint32_t slot = (cookie >> 2) - DTX_COOKIE0;
+	if (slot < DTX_SLOTS) {
+		dtx_busy &= ~(1u << slot);
+	}
+	dtx_done++;
+	if (dtx_done <= 8) {
+		for (int k = 0; k < 2; k++) {
+			LOG("t=%u ms: dp tx done #%u slot %u src %u: %08x %08x %08x %08x", g_ms, dtx_done, slot, e[2] & 7,
+			    e[2], e[3], e[4], e[5]);
+		}
+	}
+}
+
+/* an rx buffer out of a REO2SW ring: hal_rx_desc (384 B, qcn9074 layout) + l3 pad + the msdu */
+static void
+dp_rx_msdu(const uint8_t *b, volatile uint32_t *e)
+{
+	uint32_t mlen = (e[4] >> 3) & 0x3fff;
+	uint32_t me4 = (uint32_t)(b[46] | b[47] << 8);
+	uint32_t pad = (me4 >> 10) & 3;
+	uint32_t dlen = (uint32_t)(b[96] | b[97] << 8) & 0x3fff;
+	uint32_t decap = ((uint32_t)(b[100] | b[101] << 8) >> 8) & 3;
+	dp_rx_msdus++;
+	if (mlen == 0) {
+		mlen = dlen;
+	}
+	if (dp_rx_logged < 12) {
+		dp_rx_logged++;
+		char h[100];
+		w_hex(h, sizeof(h), b + 384 + pad, 40);
+		for (int k = 0; k < 2; k++) {
+			LOG("t=%u ms: dp rx msdu #%u len %u/%u pad %u decap %u fl %u%u: %s", g_ms, dp_rx_msdus, mlen, dlen, pad, decap,
+			    (me4 >> 12) & 1, (me4 >> 13) & 1, h);
+		}
+	}
+	if (mlen == 0 || 384 + pad + mlen > DP_BUF) {
+		return;
+	}
+	if (decap == 2) {
+		w_rx_ether(b + 384 + pad, mlen);
+	} else {
+		w_rx_native(b + 384 + pad, mlen);
+	}
+}
+
+/* consume a HW-produced ring; rx buffers go straight back to the refill ring */
+static bool
+dp_reap(struct dp_ring *r, bool lmac)
+{
+	bool any = false;
+	for (int k = 0; k < 64; k++) {
+		uint32_t hp = (dp_rdp[r->id] / r->words) % r->n;
+		if (r->idx == hp) {
+			break;
+		}
+		mb();
+		volatile uint32_t *e = r->va + r->words * r->idx;
+		uint32_t cookie = e[1] >> 11, rbm = (e[1] >> 8) & 7;
+		uint64_t pa = e[0] | ((uint64_t)(e[1] & 0xFF) << 32);
+		r->cnt++;
+		if (r->cnt <= 3) {
+			for (int q = 0; q < 3; q++) {
+				LOG("t=%u ms: dp ring %u entry %u: %08x %08x %08x %08x %08x %08x %08x %08x", g_ms, r->id, r->cnt,
+				    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+			}
+		}
+		if (r == &dp_wbm0 && (cookie >> 2) >= DTX_COOKIE0 && (cookie >> 2) < DTX_COOKIE0 + DTX_SLOTS) {
+			dp_tx_done(e, cookie);
+		} else if (rbm == DP_RBM_SW1 && cookie >= 1 && cookie < DP_N_REFILL && pa == dp_rxb_pa + (uint64_t)(cookie - 1) * DP_BUF) {
+			if (r->id < 4) {
+				dp_rx_msdu(dp_rxb + (uint64_t)(cookie - 1) * DP_BUF, e);
+			}
+			if (r->cnt <= 3) {
+				const uint8_t *b = dp_rxb + (uint64_t)(cookie - 1) * DP_BUF;
+				for (int q = 0; q < 3; q++) {
+					LOG("dp buf %u: %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x", cookie,
+					    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+				}
+			}
+			if (dp_lmac_post(&dp_refill, pa, cookie)) {
+				dp_recycled++;
+				any = true;
+			} else {
+				dp_bad++;
+			}
+		} else {
+			dp_bad++;
+		}
+		r->idx = (r->idx + 1) % r->n;
+		mb();
+		if (lmac) {
+			dp_wrp[r->id - DP_LMAC0] = r->idx * r->words;
+		} else {
+			vce_ptr_wr(r->ptr_reg, r->idx * r->words);
+		}
+	}
+	return any;
+}
