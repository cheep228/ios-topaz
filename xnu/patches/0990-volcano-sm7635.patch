+/*
+ * ramoops console mirror. The write position lives in the header itself, so
+ * the shim's log, the early console (VA=PA) and fbcon (ml_io_map) all append
+ * to the same record. struct persistent_ram_buffer: sig, start, size, data[].
+ */
