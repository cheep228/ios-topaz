+/* ---------------------------------------------------------------- phase 2: GMU memory through the SMMU, GMU start */
+
+#define GMU_SID                 5               /* DT qcom,gmu iommus = <&kgsl_smmu 5 0> */
+#define GMU_CB                  2               /* a context bank nobody uses (all were unconfigured) */
+#define SMMU_CB_BASE            0x20000         /* IDR1: 32 pages of 4 KB before the context banks */
+#define GMU_FALNEXT_INTF        0x1f7ed
+#define GMU_FAL_INTF            0x1f7ec
+#define GMU_ICACHE_CONFIG       0x1f400
+#define GMU_DCACHE_CONFIG       0x1f401
+#define GMU_SYS_BUS_CONFIG      0x1f40f
+#define GMU_MRC_GBIF_QOS_CTRL   0x1f50b
+#define GMU_HFI_QTBL_INFO       0x1f984
+#define GMU_HFI_QTBL_ADDR       0x1f985
+#define GMU_GENERAL_8           0x1f9c8
+#define GMU_GENERAL_9           0x1f9c9
+#define GMU_GENERAL_10          0x1f9ca
+#define GMU_RSCC_CONTROL_REQ    0x23b07
+#define GMU_RSCC_CONTROL_ACK    0x23b08
+#define RSCC_SEQ_BUSY_DRV0      0x101           /* RSCC at GPU base + 0x50000 */
+#define GBIF_CX_CONFIG          0x3c00
+#define GBIF_QSB_SIDE0          0x3c03
+#define GMU_CHIPID              0x8030000       /* gen8_3_0 */
+
+#define PTE_PAGE        ((1ull << 0) | (1ull << 1) | (2ull << 8) | (1ull << 10))   /* privileged only (EL0-writable would mean no privileged execute) */
+#define PTE_TABLE       ((1ull << 0) | (1ull << 1))
+
+struct gbuf {
+	IOBufferMemoryDescriptor *md;
+	uint8_t *va;
+	uint64_t pa, iova, size;
+	const char *name;
+};
+static struct gbuf tables, icache, dummy, debugb, logb, hfib;
+static uint32_t tables_used;
+
+static bool
+gbuf_alloc(struct gbuf *b, uint64_t size, uint64_t iova, const char *name)
+{
+	size = (size + 0x3fff) & ~0x3fffull;
+	/*
+	 * Not contiguous: contiguous / masked allocations come from RAM below the
+	 * kernel's bank (0x900000000 + 4 GB here), which phystokv cannot map (panic).
+	 * The SMMU maps each 4 KB on its own; 36-bit OAS covers the kernel's bank.
+	 */
+	/* IOBufferMemoryDescriptor with a cache mode also took low RAM (phystokv panic): plain kernel memory, cacheable, cleaned by hand */
+	b->md = NULL;
+	b->va = (uint8_t *)IOMallocAligned(size, 0x4000);
+	if (b->va == NULL) {
+		IOLog("VGPU: alloc %s (%#llx) failed\n", name, size);
+		return false;
+	}
+	b->pa = ml_vtophys((vm_offset_t)b->va);
+	b->size = size;
+	b->iova = iova;
+	b->name = name;
+	bzero(b->va, size);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return b->va != NULL && b->pa != 0;
+}
+
+/* a 4 KB table from the table buffer: index, or -1 */
+static uint64_t *
+table_new(uint64_t *pa)
+{
+	if ((tables_used + 1) * 4096 > tables.size) {
+		return NULL;
+	}
+	*pa = ml_vtophys((vm_offset_t)(tables.va + 4096 * tables_used));
+	return (uint64_t *)(tables.va + 4096 * tables_used++);
+}
+
+static uint64_t *l1, l1pa;
+static int map_ap = -1;         /* >= 0: AP[2:1] for the next mappings (kgsl-like per-buffer priv/RO) */
+static uint64_t *l2v[4], *l3v[4][512];
+
+/* GPU (CB3) has its own tables (l1g) so a buffer can be RO for the CP but RW for the GMU (kgsl maps them separately) */
+static uint64_t *l1g, l1gpa;
+static uint64_t *l2g[4], *l3g[4][512];
+
+static bool
+map_one(uint64_t *top, uint64_t **l2s, uint64_t *(*l3s)[512], uint64_t iova, uint64_t pte)
+{
+	uint32_t i1 = (uint32_t)(iova >> 30), i2 = (uint32_t)((iova >> 21) & 511), i3 = (uint32_t)((iova >> 12) & 511);
+	uint64_t tpa;
+	if (i1 >= 4) {
+		return false;
+	}
+	if (l2s[i1] == NULL) {
+		if ((l2s[i1] = table_new(&tpa)) == NULL) {
+			return false;
+		}
+		top[i1] = tpa | PTE_TABLE;
+	}
+	if (l3s[i1][i2] == NULL) {
+		if ((l3s[i1][i2] = table_new(&tpa)) == NULL) {
+			return false;
+		}
+		l2s[i1][i2] = tpa | PTE_TABLE;
+	}
+	l3s[i1][i2][i3] = pte;
+	return true;
+}
+
+static bool
+map_page(uint64_t iova, uint64_t pa)
+{
+	/* GPU buffers (0x20000000-0x3fffffff): CP fetches are unprivileged (log365 CB3 permission fault) -> AP[1] EL0 RW */
+	/* log369: SQE fetch is a privileged instr fetch -> EL0-writable = implicit PXN; SQE (0x20000000-0x200fffff) RO all */
+	uint64_t ap = 0;
+	if (iova >= 0x20000000ull && iova < 0x20100000ull) {
+		ap = (3ull << 6);
+	} else if (iova >= 0x20100000ull && iova < 0x40000000ull) {
+		ap = (1ull << 6);
+	}
+	uint64_t gap = map_ap >= 0 ? ((uint64_t)map_ap << 6) : ap;
+	/* GMU view: per-buffer override -> privileged RW (the GMU writes the RB) */
+	if (!map_one(l1, l2v, l3v, iova, pa | PTE_PAGE | (map_ap >= 0 ? 0 : ap))) {
+		return false;
+	}
+	if (l1g != NULL && iova >= 0x20000000ull && iova < 0x40000000ull) {
+		return map_one(l1g, l2g, l3g, iova, pa | PTE_PAGE | gap);
+	}
+	return true;
+}
+
+static bool
+gbuf_map(struct gbuf *b)
+{
+	for (uint64_t o = 0; o < b->size; o += 4096) {
+		/* contiguous, so pa + o; checked once per 16 KB page anyway */
+		uint64_t pa = ml_vtophys((vm_offset_t)(b->va + o));
+		if (pa == 0 || !map_page(b->iova + o, pa)) {
+			IOLog("VGPU: map %s +%#llx failed\n", b->name, o);
+			return false;
+		}
+	}
+	IOLog("VGPU: %-6s iova %#llx size %#llx pa %#llx\n", b->name, b->iova, b->size, b->pa);
+	return true;
+}
+
+static inline volatile uint8_t *gmu_cb(void) { return smmu + SMMU_CB_BASE + GMU_CB * 0x1000; }
+
+static void
+cb_fault(const char *tag)
+{
+	volatile uint8_t *cb = gmu_cb();
+	IOLog("VGPU: [%s] sGFSR %08x sGFSYNR0 %08x CB%u FSR %08x FAR %08x%08x FSYNR0 %08x SCTLR %08x\n", tag,
+	    rd(smmu, 0x48), rd(smmu, 0x50), GMU_CB, rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60), rd(cb, 0x68), rd(cb, 0));
+}
+
+static bool
+smmu_gmu_setup(void)
+{
+	if (!gbuf_alloc(&tables, 0x40000, 0, "tables")) {
+		return false;
+	}
+	l1 = table_new(&l1pa);
+	l1g = table_new(&l1gpa);
+	if (!gbuf_alloc(&icache, 0x1000000 - 0x4000, 0x4000, "icache") || !gbuf_alloc(&dummy, 0x4000, 0x60000000, "dummy") ||
+	    !gbuf_alloc(&debugb, 0x8000, 0x60400000, "debug") || !gbuf_alloc(&logb, 0x4000, 0x60004000, "log") ||
+	    !gbuf_alloc(&hfib, 0x4000, 0x60008000, "hfi")) {
+		return false;
+	}
+	if (!gbuf_map(&icache) || !gbuf_map(&dummy) || !gbuf_map(&debugb) || !gbuf_map(&logb) || !gbuf_map(&hfib)) {
+		return false;
+	}
+	sweet_dcache_clean((vm_offset_t)tables.va, (unsigned)tables.size);
+
+	volatile uint8_t *cb = gmu_cb();
+	wr(cb, 0x000, 0);                               /* SCTLR off while programming */
+	wr(cb, 0x058, 0xffffffff);                      /* FSR clear */
+	wr(smmu, 0x1800 + 4 * GMU_CB, 1);               /* CBA2R: AArch64 */
+	wr(smmu, 0x1000 + 4 * GMU_CB, 0x0001f000);      /* CBAR: S1 translate, S2 bypass */
+	wr(cb, 0x020, (uint32_t)l1pa);
+	wr(cb, 0x024, (uint32_t)(l1pa >> 32));
+	wr(cb, 0x028, 0);
+	wr(cb, 0x02c, 0);
+	wr(cb, 0x030, 32 | (1u << 23));                 /* TCR: T0SZ 32 (4 GB, level 1), 4 KB, NC walks, EPD1 */
+	wr(cb, 0x010, 1);                               /* TCR2: 36-bit PA */
+	wr(cb, 0x038, 0x44);                            /* MAIR0 attr0: Normal non-cacheable */
+	wr(cb, 0x03c, 0);
+	wr(cb, 0x618, 0);                               /* TLBIALL */
+	wr(cb, 0x7f0, 0);                               /* TLBSYNC */
+	poll(cb, 0x7f4, 1, 0, 1000);
+	wr(cb, 0x000, 0x67);                            /* SCTLR: CFIE CFRE AFE TRE M */
+	wr(smmu, 0xc00 + 4 * GMU_CB, GMU_CB);           /* S2CR: translate in CB */
+	wr(smmu, 0x800 + 4 * GMU_CB, (1u << 31) | GMU_SID); /* SMR: SID 5, mask 0 */
+	IOLog("VGPU: SMMU CB%u for SID %u: TTBR0 %08x%08x TCR %08x SCTLR %08x SMR %08x S2CR %08x sCR0 %08x\n", GMU_CB,
+	    GMU_SID, rd(cb, 0x24), rd(cb, 0x20), rd(cb, 0x30), rd(cb, 0), rd(smmu, 0x800 + 4 * GMU_CB),
+	    rd(smmu, 0xc00 + 4 * GMU_CB), rd(smmu, 0));
+	return true;
+}
+
+static bool
+fw_block_mem(struct gbuf *b, const struct blk *k)
+{
+	if (k->addr < b->iova || k->addr + k->size > b->iova + b->size) {
+		return false;
+	}
+	memcpy(b->va + (k->addr - b->iova), k->data, k->size);
+	return true;
+}
+
+static void
+gmu_load(void)
+{
+	const uint8_t *p = volcano_fw_gmu, *end = volcano_fw_gmu + volcano_fw_gmu_size;
+	uint32_t tcm = 0, mem = 0;
+	while (p + sizeof(struct blk) <= end) {
+		const struct blk *b = (const struct blk *)p;
+		if (b->size != 0) {
+			if (b->addr < 0x4000) {
+				for (uint32_t i = 0; i < b->size / 4; i++) {
+					gmu_wr(GMU_CM3_ITCM_START + b->addr / 4 + i, b->data[i]);
+				}
+				tcm++;
+			} else if (b->addr >= 0x10004000 && b->addr < 0x10008000) {
+				for (uint32_t i = 0; i < b->size / 4; i++) {
+					gmu_wr(GMU_CM3_DTCM_START + (b->addr - 0x10004000) / 4 + i, b->data[i]);
+				}
+				tcm++;
+			} else if (fw_block_mem(&icache, b) || fw_block_mem(&dummy, b) || fw_block_mem(&debugb, b)) {
+				mem++;
+			} else {
+				IOLog("VGPU: fw block %08x size %#x type %u: no home\n", b->addr, b->size, b->type);
+			}
+		}
+		p += sizeof(struct blk) + b->size;
+	}
+	struct gbuf *all[] = { &icache, &dummy, &debugb, &logb, &hfib };
+	for (unsigned i = 0; i < 5; i++) {
+		sweet_dcache_clean((vm_offset_t)all[i]->va, (unsigned)all[i]->size);
+	}
+	IOLog("VGPU: GMU fw loaded: %u TCM blocks, %u memory blocks; fw_version %08x DTCM[0xff8] %08x\n", tcm, mem,
+	    gmu_rd(GMU_CORE_FW_VERSION), gmu_rd(GMU_CM3_DTCM_START + 0xff8));
+}
+
+static void hfi_init(void);
+static bool hfi_start(void);
+static void cp_start(void);
+static uint32_t vgpu_mode;
+
+static void
+gmu_boot(void)
+{
+	extern uint64_t vgpu_scm_init_regs(uint32_t req, uint32_t *before, uint32_t *after);
+	if (!smmu_gmu_setup()) {
+		IOLog("VGPU: SMMU setup failed\n");
+		return;
+	}
+	gmu_wr(GMU_FALNEXT_INTF, 1);
+	gmu_wr(GMU_FAL_INTF, 1);
+
+	/* rpmh_start */
+	gmu_wr(GMU_RSCC_CONTROL_REQ, 1u << 1);
+	bool ack = poll(base, 4 * GMU_RSCC_CONTROL_ACK, 1u << 1, 1u << 1, 10000);
+	bool idle = poll(base, 0x50000 + 4 * RSCC_SEQ_BUSY_DRV0, 0xffffffff, 0, 10000);
+	gmu_wr(GMU_RSCC_CONTROL_REQ, 0);
+	IOLog("VGPU: RSCC wake: ack %s, seq %s (busy %08x)\n", ack ? "ok" : "TIMEOUT", idle ? "idle" : "BUSY",
+	    rd(base, 0x50000 + 4 * RSCC_SEQ_BUSY_DRV0));
+
+	gmu_load();
+	{
+		/* kgsl gen8_scm_gpu_init_cx_regs: TZ programs CX regs (always-on, BCL, tsense, SW fuse); Android does it every cold GMU boot */
+		uint32_t fb = 0, fa = 0;
+		uint64_t r = vgpu_scm_init_regs(0xb, &fb, &fa);
+		for (int k = 0; k < 2; k++) {
+			IOLog("VGPU: SUMMARY scm gpu_init_regs ret %llx fuse %08x -> %08x\n",(unsigned long long)r, fb, fa);
+		}
+	}
+	hfi_init();
+	uint32_t v = gmu_rd(GMU_CM3_DTCM_START + 0xff8);
+	uint32_t mask = v <= 0x20010004 ? 0xffffffff : 0x1ff, want = v <= 0x20010004 ? 0xbabeface : 0x100;
+
+	gmu_wr(GMU_CM3_FW_INIT_RESULT, 0);
+	gmu_wr(GMU_CM3_BOOT_CONFIG, 2);
+	gmu_wr(GMU_HFI_QTBL_ADDR, (uint32_t)hfib.iova);
+	gmu_wr(GMU_HFI_QTBL_INFO, 1);
+	gmu_wr(GMU_AHB_FENCE_RANGE_0, (1u << 31) | (0x32u << 18) | 0x8c0);
+	gmu_wr(GMU_CM3_CFG, 0x4052);
+	gmu_wr(GMU_GENERAL_10, GMU_CHIPID);
+	gmu_wr(GMU_GENERAL_8, ((uint32_t)logb.iova & 0xfffff000) | ((uint32_t)(logb.size / 4096 - 1) & 0xff));
+	for (uint32_t i = 0; i < 4; i++) {
+		gmu_wr(GBIF_QSB_SIDE0 + i, 0x00071e20);
+	}
+	gmu_wr(GBIF_CX_CONFIG, 0x20023000);
+	gmu_wr(GMU_MRC_GBIF_QOS_CTRL, 0x33);
+	gmu_wr(GMU_SYS_BUS_CONFIG, 1);
+	gmu_wr(GMU_ICACHE_CONFIG, 1);
+	gmu_wr(GMU_DCACHE_CONFIG, 1);
+	cb_fault("before start");
+
+	gmu_wr(GMU_CM3_SYSRESET, 1);
+	gmu_wr(GMU_GENERAL_9, 0);
+	gmu_wr(GMU_CM3_SYSRESET, 0);
+	bool ok = poll(base, 4 * GMU_CM3_FW_INIT_RESULT, mask, want, 200000);
+	IOLog("VGPU: GMU START %s: init_result %08x (want %08x/%08x) fw_version %08x hfi_ctrl %08x sysreset %08x\n",
+	    ok ? "OK" : "TIMEOUT", gmu_rd(GMU_CM3_FW_INIT_RESULT), want, mask, gmu_rd(GMU_CORE_FW_VERSION),
+	    gmu_rd(GMU_HFI_CTRL_STATUS), gmu_rd(GMU_CM3_SYSRESET));
+	cb_fault("after start");
+	sweet_dcache_flush((vm_offset_t)logb.va, (unsigned)logb.size);
+	sweet_dcache_flush((vm_offset_t)dummy.va, (unsigned)dummy.size);
+	sweet_dcache_flush((vm_offset_t)debugb.va, (unsigned)debugb.size);
+	const uint32_t *lg = (const uint32_t *)logb.va;
+	IOLog("VGPU: GMU log %08x %08x %08x %08x %08x %08x %08x %08x; dummy %08x debug %08x\n", lg[0], lg[1], lg[2],
+	    lg[3], lg[4], lg[5], lg[6], lg[7], *(const uint32_t *)dummy.va, *(const uint32_t *)debugb.va);
+	if (ok) {
+		if (hfi_start() && vgpu_mode >= 4) {
+			cp_start();
+		}
+	}
+}
+
+/* ---------------------------------------------------------------- HFI (upstream a6xx_hfi.c) */
+
+#define GMU_HFI_CTRL_INIT       0x1f986
+#define GMU_GMU2HOST_INTR_CLR   0x1f991
+#define GMU_GMU2HOST_INTR_INFO  0x1f992
+#define GMU_HOST2GMU_INTR_SET   0x1f994
+
+struct hfi_qhdr {
+	uint32_t status, iova, type, size, msg_size, dropped, rx_wm, tx_wm, rx_req, tx_req, rd, wr;
+};
+static struct hfi_qhdr *hq[3];
+static uint32_t *hqdata[3];
+static uint32_t hfi_seq;
+
+static void
+hfi_init(void)
+{
+	uint32_t *t = (uint32_t *)hfib.va;
+	t[0] = 0;                                       /* version */
+	t[1] = 6 * 4 + 3 * sizeof(struct hfi_qhdr);     /* size */
+	t[2] = 6;                                       /* qhdr0_offset (dwords) */
+	t[3] = sizeof(struct hfi_qhdr) / 4;
+	t[4] = 3;
+	t[5] = 3;
+	for (uint32_t i = 0; i < 3; i++) {
+		struct hfi_qhdr *h = (struct hfi_qhdr *)(hfib.va + 24) + i;
+		bzero(h, sizeof(*h));
+		h->iova = (uint32_t)hfib.iova + 0x1000 * (i + 1);
+		h->type = (10u << 8) | i;
+		h->status = 1;
+		h->size = 0x1000 / 4;
+		h->rx_wm = h->tx_wm = h->rx_req = 1;
+		hq[i] = h;
+		hqdata[i] = (uint32_t *)(hfib.va + 0x1000 * (i + 1));
+	}
+	sweet_dcache_clean((vm_offset_t)hfib.va, (unsigned)hfib.size);
+}
+
+/* one message from queue q into buf (max dwords): dwords read, 0 if empty */
+static uint32_t
+hfi_read(uint32_t q, uint32_t *buf, uint32_t max)
+{
+	sweet_dcache_flush((vm_offset_t)hfib.va, (unsigned)hfib.size);
+	struct hfi_qhdr *h = hq[q];
+	uint32_t idx = h->rd;
+	if (idx == h->wr) {
+		return 0;
+	}
+	uint32_t n = (hqdata[q][idx] >> 8) & 0xff;
+	if (n == 0 || n > max) {
+		IOLog("VGPU: HFI q%u bad header %08x at %u\n", q, hqdata[q][idx], idx);
+		h->rd = h->wr;
+		sweet_dcache_clean((vm_offset_t)h, sizeof(*h));
+		return 0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		buf[i] = hqdata[q][idx];
+		idx = (idx + 1) % h->size;
+	}
+	idx = ((idx + 3) & ~3u) % h->size;
+	h->rd = idx;
+	sweet_dcache_clean((vm_offset_t)h, sizeof(*h));
+	return n;
+}
+
+static void
+hfi_drain_debug(void)
+{
+	uint32_t m[32];
+	for (int k = 0; k < 8; k++) {
+		uint32_t n = hfi_read(2, m, 32);
+		if (n == 0) {
+			break;
+		}
+		IOLog("VGPU: HFI dbg %08x %08x %08x %08x %08x %08x\n", m[0], n > 1 ? m[1] : 0, n > 2 ? m[2] : 0,
+		    n > 3 ? m[3] : 0, n > 4 ? m[4] : 0, n > 5 ? m[5] : 0);
+	}
+}
+
+/* write a complete message (header filled) to the command queue and ring the GMU */
+static void
+hfi_post(const uint32_t *msg, uint32_t dwords)
+{
+	struct hfi_qhdr *h = hq[0];
+	sweet_dcache_flush((vm_offset_t)h, sizeof(*h));
+	uint32_t idx = h->wr;
+	for (uint32_t i = 0; i < dwords; i++) {
+		hqdata[0][idx] = msg[i];
+		idx = (idx + 1) % h->size;
+	}
+	for (; idx % 4; idx = (idx + 1) % h->size) {
+		hqdata[0][idx] = 0xfafafafa;
+	}
+	sweet_dcache_clean((vm_offset_t)hqdata[0], 0x1000);
+	h->wr = idx;
+	sweet_dcache_clean((vm_offset_t)h, sizeof(*h));
+	gmu_wr(GMU_HOST2GMU_INTR_SET, 1);
+}
+
+/* hwsched: F2H_MSG_MEM_ALLOC (20) replies; GFX-visible buffers at 0x21000000+ (shared GMU/GPU tables), GMU-only at 0x61000000+ */
+static struct gbuf mab[32];
+static uint32_t mab_n;
+static uint64_t mab_gpu_va = 0x21000000ull, mab_gmu_va = 0x61000000ull;
+
+static void
+hfi_mem_alloc_reply(const uint32_t *r, uint32_t n)
+{
+	/* {hdr, version, desc{u64 gpu, flags, kind, host_h, gmu_h, gmu_addr, size, align}}; version 0: no align */
+	uint32_t d[9] = {};
+	for (uint32_t i = 0; i < 9 && 2 + i < n; i++) {
+		d[i] = r[2 + i];
+	}
+	if (r[1] == 0) {
+		d[8] = 0;
+	}
+	uint32_t flags = d[2], kind = d[3], gmh = d[5], size = d[7], al = d[8] & 0xff;
+	uint64_t a = al > 14 ? (1ull << al) : 0x4000ull;
+	uint64_t gpu = 0, gmu = 0;
+	bool gfx = (flags & 1) != 0;
+	uint32_t vcd = 0;
+	PE_parse_boot_argn("vhwscd", &vcd, sizeof(vcd));
+	bool refuse = vcd != 0 && kind == 10;  /* HFI_MEMKIND_CRASH_DUMP: GMU-run crash dumper (cold reset in log381) */
+	if (!refuse && mab_n < 32 && size != 0 && size <= 0x2000000u) {
+		struct gbuf *b = &mab[mab_n];
+		uint64_t *va = gfx ? &mab_gpu_va : &mab_gmu_va;
+		uint64_t iova = (*va + a - 1) & ~(a - 1);
+		uint32_t vap = 0;
+		PE_parse_boot_argn("vhwsap", &vap, sizeof(vap));
+		if (vap && gfx) {
+			bool pr = (flags & 2) != 0, wrt = (flags & 4) != 0;
+			map_ap = pr ? (wrt ? 0 : 2) : (wrt ? 1 : 3);
+		}
+		bool okm = gbuf_alloc(b, size, iova, "hfimem") && gbuf_map(b);
+		map_ap = -1;
+		if (okm) {
+			*va = iova + b->size;
+			mab_n++;
+			sweet_dcache_clean((vm_offset_t)b->va, (unsigned)b->size);
+			sweet_dcache_clean((vm_offset_t)tables.va, (unsigned)tables.size);
+			wr(gmu_cb(), 0x618, 0);
+			wr(gmu_cb(), 0x7f0, 0);
+			poll(gmu_cb(), 0x7f4, 1, 0, 1000);
+			if (gfx) {
+				gpu = iova;
+			}
+			if (!gfx || (flags & 8)) {
+				gmu = iova;
+			}
+		}
+	}
+	uint32_t m[11];
+	uint32_t seq = ++hfi_seq % 0xfff;
+	m[0] = (seq << 20) | (1u << 16) | (11u << 8) | 20;
+	m[1] = r[0];
+	m[2] = (uint32_t)gpu;
+	m[3] = (uint32_t)(gpu >> 32);
+	m[4] = flags;
+	m[5] = kind;
+	m[6] = refuse ? 0 : gmh;        /* host_mem_handle = gmu_mem_handle: success */
+	m[7] = gmh;
+	m[8] = (uint32_t)gmu;
+	m[9] = size;
+	m[10] = d[8];
+	hfi_post(m, 11);
+	for (int k = 0; k < 3; k++) {
+		IOLog("VGPU: SUMMARY memalloc v%u kind %u flags %#x size %#x align %#x h %#x -> gpu %#llx gmu %#llx%s\n", r[1],
+		    kind, flags, d[7], d[8], gmh, gpu, gmu, refuse ? " REFUSED" : "");
+	}
+}
+
+static void
+hfi_cntr_reply(const uint32_t *r)
+{
+	uint32_t m[6];
+	uint32_t seq = ++hfi_seq % 0xfff;
+	m[0] = (seq << 20) | (1u << 16) | (6u << 8) | 110;
+	m[1] = r[0];
+	m[2] = r[1];
+	m[3] = r[2];
+	m[4] = 0;
+	m[5] = 0;
+	hfi_post(m, 6);
+	IOLog("VGPU: SUMMARY cntr_register group %u countable %u -> none\n", r[1], r[2]);
+}
+
+/* send msg (dwords incl. header slot); wait for the ack; 0 ok, else -1 timeout, error code otherwise */
+static int
+hfi_send(uint32_t id, uint32_t *msg, uint32_t dwords, uint32_t *payload, uint32_t plen, const char *name)
+{
+	struct hfi_qhdr *h = hq[0];
+	uint32_t seq = ++hfi_seq % 0xfff;
+	msg[0] = (seq << 20) | (0u << 16) | (dwords << 8) | id;
+	sweet_dcache_flush((vm_offset_t)h, sizeof(*h));
+	uint32_t idx = h->wr;
+	for (uint32_t i = 0; i < dwords; i++) {
+		hqdata[0][idx] = msg[i];
+		idx = (idx + 1) % h->size;
+	}
+	for (; idx % 4; idx = (idx + 1) % h->size) {
+		hqdata[0][idx] = 0xfafafafa;
+	}
+	sweet_dcache_clean((vm_offset_t)hqdata[0], 0x1000);
+	h->wr = idx;
+	sweet_dcache_clean((vm_offset_t)h, sizeof(*h));
+	gmu_wr(GMU_HOST2GMU_INTR_SET, 1);
+
+	for (int tries = 0; tries < 64; tries++) {
+		if (!poll(base, 4 * GMU_GMU2HOST_INTR_INFO, 1, 1, 200000)) {
+			IOLog("VGPU: HFI %s (seq %u): no response (intr %08x, cmdq rd %u wr %u)\n", name, seq,
+			    gmu_rd(GMU_GMU2HOST_INTR_INFO), h->rd, h->wr);
+			hfi_drain_debug();
+			return -1;
+		}
+		gmu_wr(GMU_GMU2HOST_INTR_CLR, 1);
+		uint32_t r[24];
+		uint32_t n;
+		while ((n = hfi_read(1, r, 24)) != 0) {
+			if ((r[0] & 0xff) == 100) {
+				IOLog("VGPU: HFI %s: GMU error %u (%08x %08x)\n", name, r[1], r[2], r[3]);
+				IOLog("VGPU: SUMMARY HFI %s GMU error %u (%08x %08x %08x)\n", name, r[1], r[2], r[3], n > 4 ? r[4] : 0);
+				continue;
+			}
+			if (((r[0] >> 16) & 0xf) == 0 && (r[0] & 0xff) == 20) {
+				hfi_mem_alloc_reply(r, n);
+				continue;
+			}
+			if (((r[0] >> 16) & 0xf) == 0 && (r[0] & 0xff) == 110) {
+				hfi_cntr_reply(r);
+				continue;
+			}
+			if (((r[1] >> 20) & 0xfff) != seq) {
+				IOLog("VGPU: HFI %s: other message %08x %08x\n", name, r[0], r[1]);
+				continue;
+			}
+			IOLog("VGPU: HFI %s ack: error %u payload %08x %08x\n", name, r[2], n > 3 ? r[3] : 0, n > 4 ? r[4] : 0);
+			for (uint32_t i = 0; payload != NULL && i < plen && 3 + i < n; i++) {
+				payload[i] = r[3 + i];
+			}
+			hfi_drain_debug();
+			return (int)r[2];
+		}
+	}
+	return -1;
+}
