+static uint8_t *
+w_channel(uint8_t *p, uint32_t freq)
+{
+	uint8_t *c = wmi_put_tlv(p, TAG_CHANNEL, 24);
+	uint32_t info = freq < 4000 ? 1 : 0;
+	if (w_arg("wifivch", 1) != 0) {
+		uint32_t mode = w_arg("wifivmode", freq < 4000 ? 21 : 16);
+		info = (mode & 0x3f) | (1u << 11) | (freq < 4000 ? 0 : (1u << 12)) | (1u << 16);
+	}
+	info |= w_arg("wifivflags", 0);
+	c = w_p32(c, freq);
+	c = w_p32(c, freq);
+	c = w_p32(c, 0);
+	c = w_p32(c, info);
+	c = w_p32(c, (40u << 8) | (40u << 16));
+	return w_p32(c, 40u << 8);
