+extern "C" void
+sweet_fb_snapshot(uint32_t scale)
+{
+	static char line[3 * 512 + 1];
+	static const char hx[] = "0123456789abcdef";
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (fb == NULL || fb->fPixels == 0) {
+		IOLog("SHOT none\n");
+		return;
+	}
+	if (scale < 2) {
+		scale = 8;
+	}
+	uint32_t ow = fb->fWidth / scale, oh = fb->fHeight / scale;
+	if (ow > 512) {
+		ow = 512;
+	}
+	IOLog("SHOT begin %u %u scale %u src %ux%u\n", ow, oh, scale, fb->fWidth, fb->fHeight);
