+/* fix128: the auth never leaves the fw TX queue (TQM takes no link desc, 1862 after ~1.5 s). Ask the fw why:
+ * WMI_REQUEST_STATS (0x16001, tag 0x8f, PDEV_STAT) -> UPDATE_STATS 0x1d004 (chan_nf, tx/rx/rx_clear/cycle counts,
+ * tx: local_enqued/freed, hw_queued/reaped, underrun, hw_paused, tx_abort...) and PDEV_BSS_CHAN_INFO_REQUEST
+ * (0x402d, tag 0x296, READ) -> 0x4019 (noise floor, rx_clear/cycle/tx/rx cycle counts). Channel always busy
+ * (bad CCA/noise floor) vs frame never queued to HW. Payload words kept for the @@P@@ crash beacon.
+ * Boot-arg wifistat=0 turns it off, wifistatpd=N sets the pdev id (default 0, like every other pdev cmd). */
+static uint32_t g_p128[3][48];
+static uint32_t g_p128id[3], g_p128t[3], g_p128n[3], g_p128req, g_p128next;
+
+static void
+p128_req(const char *why)
+{
+	if (w_arg("wifistat", 1) == 0) {
+		return;
+	}
+	uint32_t pd = w_arg("wifistatpd", 0);
+	uint8_t m[4 + 20] = {}, *c = wmi_put_tlv(m, 0x8f, 20);
+	c = put32(c, 1u << 2);                      /* WMI_REQUEST_PDEV_STAT */
+	c = put32(c, 0);                            /* vdev */
+	c += 8;                                     /* peer mac */
+	put32(c, pd);
+	bool a = wmi_send(0x16001, m, sizeof(m));
+	uint8_t b[4 + 8] = {};
+	c = wmi_put_tlv(b, 0x296, 8);
+	c = put32(c, 1);                            /* WMI_BSS_SURVEY_REQ_TYPE_READ */
+	put32(c, pd);
+	bool bb = wmi_send(0x402d, b, sizeof(b));
+	g_p128req++;
+	for (int k = 0; k < 2; k++) {
+		LOG("t=%u ms: fix128 stats req %u (%s): pdev %s chan %s", g_ms, g_p128req, why, a ? "sent" : "FAIL", bb ? "sent" : "FAIL");
+	}
+}
+
+static void
+p128_log(const char *tag, uint32_t i)
+{
+	const uint32_t *u = g_p128[i];
+	LOG("%s ev %x t=%u n%u a: %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x@@E@@", tag, g_p128id[i], g_p128t[i],
+	    g_p128n[i], u[0], u[1], u[2], u[3], u[4], u[5], u[6], u[7], u[8], u[9], u[10], u[11], u[12], u[13], u[14], u[15], u[16],
+	    u[17], u[18], u[19], u[20], u[21], u[22], u[23]);
+	LOG("%s ev %x t=%u n%u b: %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x@@E@@", tag, g_p128id[i], g_p128t[i],
+	    g_p128n[i], u[24], u[25], u[26], u[27], u[28], u[29], u[30], u[31], u[32], u[33], u[34], u[35], u[36], u[37], u[38], u[39],
+	    u[40], u[41], u[42], u[43], u[44], u[45], u[46], u[47]);
+}
+
+static void
+p128_event(uint32_t id, const uint8_t *t, uint32_t len)
+{
+	uint32_t i = id == 0x1d004 ? 0 : (id == 0x4019 ? 1 : 2);
+	bzero(g_p128[i], sizeof(g_p128[i]));
+	memcpy(g_p128[i], t, MIN(len, (uint32_t)sizeof(g_p128[i])));
+	g_p128id[i] = id;
+	g_p128t[i] = g_ms;
+	g_p128n[i]++;
+	if (g_p128n[i] <= 40) {
+		for (int k = 0; k < 2; k++) {
+			p128_log("fix128", i);
+		}
+	}
+}
