+extern thread_t volcano_watched;
+thread_t volcano_watched;
+static int volcano_watch_ev;
+static uint32_t volcano_watch_secs = 60;
+/* vdbg=0: no per-call traces of PID 1 (namei, vn_open, console open) */
+extern int volcano_dbg;
+int volcano_dbg = 1;
+
+static void
+volcano_watch_bt(thread_t t)
+{
+	vm_offset_t lo = t->kernel_stack, hi = lo + kernel_stack_size;
+	if (lo == 0) {
+		printf("VOLCANO watch:   no kernel stack, continuation 0x%lx\n",
+		    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)t->continuation));
+		return;
+	}
+	if (t == current_thread()) {
+		return;
+	}
+	arm_kernel_context_t *kc = (arm_kernel_context_t *)t->machine.kstackptr;
+	uint64_t fp = kc->ss.fp, lr = kc->ss.lr;
+	printf("VOLCANO watch:   saved lr 0x%lx fp 0x%llx sp 0x%llx\n",
+	    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)lr), fp, kc->ss.sp);
+	for (int i = 0; i < 24 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; i++) {
+		uint64_t *frame = (uint64_t *)fp;
+		printf("VOLCANO watch:   #%d 0x%lx\n", i, (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)frame[1]));
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
+
+static void
+volcano_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("VOLCANO watch: started, slide 0x%lx\n", (unsigned long)vm_kernel_slide);
+	for (unsigned int i = 1; i <= volcano_watch_secs / 10; i++) {
+		assert_wait_timeout((event_t)&volcano_watch_ev, THREAD_UNINT, 10, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		thread_t t = volcano_watched;
+		if (t == THREAD_NULL) {
+			printf("VOLCANO watch %us: PID 1 made no syscall yet\n", i * 10);
+			continue;
+		}
+		printf("VOLCANO watch %us: thread %p state 0x%x wait_event 0x%llx (unslid 0x%lx) hint %d wresult %d pri %d\n",
+		    i * 10, t, t->state, (unsigned long long)t->wait_event,
+		    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)t->wait_event), (int)t->block_hint,
+		    t->wait_result, t->sched_pri);
+		volcano_watch_bt(t);
+	}
+	printf("VOLCANO watch: %u s up, PSCI reset to Android\n", volcano_watch_secs);
+	volcano_psci_reset(2);
+}
+
+void volcano_watch_start(void);
+void
+volcano_watch_start(void)
+{
+	thread_t w;
+	PE_parse_boot_argn("vdbg", &volcano_dbg, sizeof(volcano_dbg));
+	PE_parse_boot_argn("vwatch", &volcano_watch_secs, sizeof(volcano_watch_secs));
+	if (volcano_watch_secs == 0) {
+		printf("VOLCANO watch: off (vwatch=0)\n");
+		return;
+	}
+	if (kernel_thread_start_priority(volcano_watch, NULL, MAXPRI_KERNEL, &w) == KERN_SUCCESS) {
+		thread_deallocate(w);
+	} else {
+		printf("VOLCANO watch: failed to start\n");
+	}
+}
