+/* ---------------------------------------------------------------- TrustZone: the zap shader (PAS 13) */
+
+#define ZAP_FW_PATH     "/private/var/tmp/volcano-gen80300_zap.mbn"
+#define ZAP_REGION      0x9ea9a000ull   /* DT gpu_microcode_region, 2 MB, not XNU RAM */
+#define ZAP_REGION_SIZE 0x200000u
+#define ZAP_META_OFF    0x100000u       /* metadata staged in the unused upper half */
+#define GPU_PAS_ID      13
+#define SCM_FN(svc, cmd)    (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+#define SCM_SVC_PIL         0x02
+#define PIL_INIT_IMAGE      0x01
+#define PIL_MEM_SETUP       0x02
+#define PIL_AUTH_RESET      0x05
+#define PIL_SHUTDOWN        0x06
+#define SCM_ARG_RW          2
+
+static uint64_t
+smc(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+	return x0;
+}
+
+static uint64_t
+scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t args[8] = { fn, arginfo, a, b, c, 0, 0, 0 };
+	smc(args);
+	for (int n = 0; args[0] == 1 && n < 100000; n++) {     /* interrupted: resume with the session in x6 */
+		uint64_t session = args[6];
+		uint64_t again[8] = { 1, arginfo, a, b, c, 0, session, 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	if (res1 != NULL) {
+		*res1 = args[1];
+	}
+	return args[0];
+}
+
+uint64_t
+vgpu_scm_init_regs(uint32_t req, uint32_t *before, uint32_t *after)
+{
+	*before = rd(base, 0x9e000 + 4 * 0x400);       /* CX_MISC_SW_FUSE_VALUE */
+	uint64_t r = scm(SCM_FN(0x28, 0x01), 1, req, 0, 0, NULL);
+	*after = rd(base, 0x9e000 + 4 * 0x400);
+	return r;
+}
+
+/* one-file .mbn: metadata = ELF header + program headers, then the hash segment; load segments relocated to the region */
+static bool
+zap_load(void)
+{
+	void *data = NULL;
+	size_t size = 0;
+	if (topaz_fw_read(ZAP_FW_PATH, &data, &size) != 0 || data == NULL || size < 0x100) {
+		IOLog("VGPU: zap %s not readable\n", ZAP_FW_PATH);
+		return false;
+	}
+	const uint8_t *m = (const uint8_t *)data;
+	uint32_t phoff = *(const uint32_t *)(m + 28), phnum = *(const uint16_t *)(m + 44);
+	uint32_t hdr = phoff + 32 * phnum, hash_off = 0, hash_sz = 0, min_a = 0xffffffff, max_a = 0;
+	if (*(const uint32_t *)m != 0x464c457f || m[4] != 1 || hdr > size) {
+		IOLog("VGPU: zap not ELF32\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		const uint8_t *ph = m + phoff + 32 * i;
+		uint32_t type = *(const uint32_t *)ph, off = *(const uint32_t *)(ph + 4), paddr = *(const uint32_t *)(ph + 12);
+		uint32_t filesz = *(const uint32_t *)(ph + 16), memsz = *(const uint32_t *)(ph + 20);
+		uint32_t flags = *(const uint32_t *)(ph + 24);
+		if (((flags >> 24) & 7) == 2) {
+			hash_off = off;
+			hash_sz = filesz;
+		} else if (type == 1 && memsz != 0) {
+			min_a = paddr < min_a ? paddr : min_a;
+			uint32_t end = (paddr + memsz + 0xfff) & ~0xfffu;
+			max_a = end > max_a ? end : max_a;
+		}
+	}
+	if (hash_sz == 0 || hash_off + hash_sz > size || max_a <= min_a || max_a - min_a > ZAP_META_OFF ||
+	    hdr + hash_sz > 0x10000) {
+		IOLog("VGPU: zap layout unexpected (hash %#x+%#x, load %#x-%#x)\n", hash_off, hash_sz, min_a, max_a);
+		return false;
+	}
+	volatile uint8_t *reg = (volatile uint8_t *)ml_io_map(ZAP_REGION, ZAP_REGION_SIZE);
+	if (reg == NULL) {
+		return false;
+	}
+	volatile uint8_t *meta = reg + ZAP_META_OFF;
+	for (uint32_t i = 0; i < hdr; i++) {
+		meta[i] = m[i];
+	}
+	for (uint32_t i = 0; i < hash_sz; i++) {
+		meta[hdr + i] = m[hash_off + i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t res = 0, st;
+	scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, GPU_PAS_ID, 0, 0, &res);
+	st = scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE), 2 | (SCM_ARG_RW << 6), GPU_PAS_ID, ZAP_REGION + ZAP_META_OFF, 0, &res);
+	if (st != 0 || res != 0) {
+		IOLog("VGPU: SUMMARY zap init_image: %llx/%llx (meta %#x bytes)\n", st, res, hdr + hash_sz);
+		return false;
+	}
+	st = scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, GPU_PAS_ID, ZAP_REGION, max_a - min_a, &res);
+	if (st != 0 || res != 0) {
+		IOLog("VGPU: SUMMARY zap mem_setup: %llx/%llx\n", st, res);
+		return false;
+	}
+	for (uint32_t i = 0; i < max_a - min_a; i += 4) {
+		*(volatile uint32_t *)(reg + i) = 0;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		const uint8_t *ph = m + phoff + 32 * i;
+		uint32_t type = *(const uint32_t *)ph, off = *(const uint32_t *)(ph + 4), paddr = *(const uint32_t *)(ph + 12);
+		uint32_t filesz = *(const uint32_t *)(ph + 16), flags = *(const uint32_t *)(ph + 24);
+		if (type != 1 || ((flags >> 24) & 7) == 2 || off + filesz > size) {
+			continue;
+		}
+		for (uint32_t j = 0; j < filesz; j++) {
+			reg[paddr - min_a + j] = m[off + j];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	st = scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, GPU_PAS_ID, 0, 0, &res);
+	IOLog("VGPU: SUMMARY zap auth_and_reset: %llx/%llx (meta %#x, load %#x bytes)\n", st, res, hdr + hash_sz, max_a - min_a);
+	return st == 0 && res == 0;
+}
