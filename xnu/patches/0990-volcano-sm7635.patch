+/*
+ * volcano: Adreno 810 (gen8_3_0, chip id 0x44010000) bring-up, step 1: a probe.
+ *
+ * Boot-arg vgpu=1: a thread 15 s after start powers the GPU's CX side the way
+ * downstream gpucc-volcano.c / kgsl gen8 and upstream drm/msm a8xx (Milos = SM7635) do:
+ *   GCC: GPLL0 (+div) to the GPU CC (0x52000 bits 15/16), gpu_memnoc_gfx 0x71010,
+ *        gpu_snoc_dvm_gfx 0x71018, ddrss_gpu_axi 0x7115c
+ *   GPU CC (0x3d90000): CX GDSC 0x9080, cxo 0x90e4, ahb 0x90bc, gmu rcg 0x9318
+ *        (GPLL0/3 = 200 MHz), cx_gmu 0x90d4, hub rcg 0x93ec (200 MHz), hub_cx_int 0x90e8,
+ *        hub_aon 0x93e8, hlos1_vote_gpu_smmu 0x7000, memnoc_gfx 0x90f4
+ * then reads GMU registers (CX domain: GPU base 0x3d00000 + 4 * reg, upstream a6xx_gmu.xml),
+ * writes the GMU firmware's TCM blocks (GMU_FW_PATH) (ITCM 0x1b400, DTCM 0x1c400) and reads them back,
+ * and logs the GPU SMMU (0x3da0000) ID registers. GX-domain registers are never touched:
+ * with the GX GDSC collapsed they fault on the bus. Lines "VGPU:".
+ * vgpu=2: also lists the firmware blocks that need GMU memory (through the SMMU, SID 5).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <kern/thread.h>
+
+#if defined(VOLCANO)
+
+extern "C" {
+vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+void volcano_adreno_init(void);
+int topaz_fw_read(const char *path, void **data, size_t *size);
+void topaz_fw_free(void *data, size_t size);
+int topaz_root_mounted(void);
+vm_offset_t ml_vtophys(vm_offset_t vaddr);
+void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+void sweet_dcache_flush(vm_offset_t addr, unsigned length);
+}
+
+/* not in the (public) source tree: the boot payload blob writes it at every boot (Qualcomm firmware) */
+#define GMU_FW_PATH     "/private/var/tmp/volcano-gen80300_gmu.bin"
+static const uint8_t *volcano_fw_gmu;
+static size_t volcano_fw_gmu_size;
+
+#define GPU_PHYS        0x03d00000ull           /* kgsl_3d0_reg_memory, GMU regs follow */
+#define GPU_MAP         0x000a0000ull           /* through gpucc (0x3d90000) + cx_misc (0x3d9e000) */
+#define GPUCC           0x90000u                /* offset of the GPU CC in that map */
+#define SMMU_PHYS       0x03da0000ull
+#define GCC_A_PHYS      0x00152000ull           /* GCC page with the GPLL0 GPU votes */
+#define GCC_B_PHYS      0x00171000ull           /* GCC page with the GPU branches */
+
+/* GMU registers (dword index from GPU base) */
+#define GMU_CM3_ITCM_START      0x1b400
+#define GMU_CM3_DTCM_START      0x1c400
+#define GMU_CORE_FW_VERSION     0x1d3f8
+#define GMU_CM3_SYSRESET        0x1f800
+#define GMU_CM3_BOOT_CONFIG     0x1f801
+#define GMU_CM3_FW_INIT_RESULT  0x1f81c
+#define GMU_CM3_CFG             0x1f82d
+#define GMU_AO_COUNTER_L        0x1f840
+#define GMU_HFI_CTRL_STATUS     0x1f980
+#define GMU_AO_SPARE_CNTL       0x23b16
+#define GMU_AHB_FENCE_RANGE_0   0x23b11
+
+#define CBCR_EN         (1u << 0)
+#define CBCR_OFF        (1u << 31)
+#define GDSC_COLLAPSE   (1u << 0)
+#define GDSC_PWR_ON     (1u << 31)
+
+static volatile uint8_t *base, *smmu, *gcca, *gccb;
+
+static inline uint32_t rd(volatile uint8_t *b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+static inline void rmw(volatile uint8_t *b, uint32_t o, uint32_t clr, uint32_t set) { wr(b, o, (rd(b, o) & ~clr) | set); }
+static inline uint32_t cc_rd(uint32_t o) { return rd(base, GPUCC + o); }
+static inline void cc_rmw(uint32_t o, uint32_t clr, uint32_t set) { rmw(base, GPUCC + o, clr, set); }
+static inline uint32_t gmu_rd(uint32_t reg) { return rd(base, 4 * reg); }
+static inline void gmu_wr(uint32_t reg, uint32_t v) { wr(base, 4 * reg, v); }
+
+static bool
+poll(volatile uint8_t *b, uint32_t o, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t i = 0; i < us; i++) {
+		if ((rd(b, o) & mask) == want) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return (rd(b, o) & mask) == want;
+}
+
+static bool
+branch(volatile uint8_t *b, uint32_t o, const char *name)
+{
+	uint32_t was = rd(b, o);
+	rmw(b, o, 0, CBCR_EN);
+	bool ok = poll(b, o, CBCR_OFF, 0, 500);
+	IOLog("VGPU: %-22s %08x -> %08x %s\n", name, was, rd(b, o), ok ? "on" : "STAYS OFF");
+	return ok;
+}
+
+static bool
+rcg(uint32_t cmd, uint32_t src, uint32_t div2x, const char *name)
+{
+	uint32_t was = cc_rd(cmd + 4);
+	cc_rmw(cmd + 4, 0x71f, (src << 8) | (div2x - 1));
+	cc_rmw(cmd, 0, 1);
+	bool ok = poll(base, GPUCC + cmd, 1, 0, 1000);
+	IOLog("VGPU: rcg %-18s cfg %08x -> %08x cmd %08x %s\n", name, was, cc_rd(cmd + 4), cc_rd(cmd),
+	    ok ? "ok" : "UPDATE STUCK");
+	return ok;
+}
+
+static void
+state(const char *when)
+{
+	IOLog("VGPU: [%s] CX GDSC %08x GX GDSC(cc) %08x gmu_clk %08x ahb %08x cxo %08x smmu_vote %08x\n", when,
+	    cc_rd(0x9080), cc_rd(0x905c), cc_rd(0x90d4), cc_rd(0x90bc), cc_rd(0x90e4), cc_rd(0x7000));
+}
+
+static bool
+power_cx(void)
+{
+	IOLog("VGPU: gcc 0x52000 %08x, memnoc %08x snoc_dvm %08x ddrss_axi %08x\n",
+	    rd(gcca, 0), rd(gccb, 0x10), rd(gccb, 0x18), rd(gccb, 0x15c));
+	rmw(gcca, 0, 0, (1u << 15) | (1u << 16));
+	branch(gccb, 0x10, "gcc_gpu_memnoc_gfx");
+	branch(gccb, 0x18, "gcc_gpu_snoc_dvm_gfx");
+	branch(gccb, 0x15c, "gcc_ddrss_gpu_axi");
+
+	uint32_t g = cc_rd(0x9080);
+	if (!(g & GDSC_PWR_ON)) {
+		cc_rmw(0x9080, GDSC_COLLAPSE, 0);
+		bool ok = poll(base, GPUCC + 0x9080, GDSC_PWR_ON, GDSC_PWR_ON, 1000);
+		IOLog("VGPU: CX GDSC %08x -> %08x %s\n", g, cc_rd(0x9080), ok ? "ON" : "NO PWR_ON");
+		if (!ok) {
+			return false;
+		}
+	} else {
+		IOLog("VGPU: CX GDSC already on (%08x)\n", g);
+	}
+	bool ok = branch(base, GPUCC + 0x90e4, "gpu_cc_cxo");
+	ok &= branch(base, GPUCC + 0x90bc, "gpu_cc_ahb");
+	rcg(0x9318, 5, 6, "gmu (GPLL0/3)");
+	ok &= branch(base, GPUCC + 0x90d4, "gpu_cc_cx_gmu");
+	rcg(0x93ec, 5, 6, "hub (GPLL0/3)");
+	branch(base, GPUCC + 0x90e8, "gpu_cc_hub_cx_int");
+	branch(base, GPUCC + 0x93e8, "gpu_cc_hub_aon");
+	branch(base, GPUCC + 0x7000, "gpu_cc_hlos1_vote_smmu");
+	branch(base, GPUCC + 0x90f4, "gpu_cc_memnoc_gfx");
+	return ok;
+}
+
+
+/* GPU SMMU (MMU-500 style): what the bootloader / hypervisor left: stream match, context banks */
+static void
+smmu_dump(void)
+{
+	uint32_t idr0 = rd(smmu, 0x20), idr1 = rd(smmu, 0x24);
+	uint32_t nsmr = idr0 & 0xff, ncb = idr1 & 0xff, pshift = (idr1 & (1u << 31)) ? 16 : 12;
+	uint32_t npage = 1u << (((idr1 >> 28) & 7) + 1);
+	uint32_t cbbase = npage << pshift;
+	IOLog("VGPU: SMMU IDR0 %08x IDR1 %08x: %u SMRs, %u CBs, page %u, CB space at %#x\n", idr0, idr1, nsmr, ncb,
+	    1u << pshift, cbbase);
+	for (uint32_t i = 0; i < nsmr && i < 64; i++) {
+		uint32_t smr = rd(smmu, 0x800 + 4 * i), s2cr = rd(smmu, 0xc00 + 4 * i);
+		if (smr & (1u << 31)) {
+			IOLog("VGPU: SMR%u %08x (sid %#x mask %#x) S2CR %08x\n", i, smr, smr & 0xffff, (smr >> 16) & 0x7fff, s2cr);
+		}
+	}
+	if (cbbase + ncb * (1u << pshift) > 0x40000) {
+		return;
+	}
+	for (uint32_t i = 0; i < ncb && i < 32; i++) {
+		volatile uint8_t *cb = smmu + cbbase + i * (1u << pshift);
+		uint32_t sctlr = rd(cb, 0);
+		IOLog("VGPU: CB%u CBAR %08x SCTLR %08x TTBR0 %08x%08x TCR %08x FSR %08x\n", i, rd(smmu, 0x1000 + 4 * i),
+		    sctlr, rd(cb, 0x24), rd(cb, 0x20), rd(cb, 0x30), rd(cb, 0x58));
+	}
+}
+
+struct blk {
+	uint32_t addr, size, type, value;
+	uint32_t data[];
+};
+
+static void
+tcm_test(int list)
+{
+	const uint8_t *p = volcano_fw_gmu, *end = volcano_fw_gmu + volcano_fw_gmu_size;
+	uint32_t n = 0, bad = 0, words = 0;
+	while (p + sizeof(struct blk) <= end) {
+		const struct blk *b = (const struct blk *)p;
+		if (b->size != 0) {
+			uint32_t reg = 0;
+			if (b->addr < 0x4000) {
+				reg = GMU_CM3_ITCM_START + b->addr / 4;
+			} else if (b->addr >= 0x10004000 && b->addr < 0x10008000) {
+				reg = GMU_CM3_DTCM_START + (b->addr - 0x10004000) / 4;
+			} else if (list) {
+				IOLog("VGPU: fw block %08x size %#x needs GMU memory\n", b->addr, b->size);
+			}
+			if (reg != 0) {
+				for (uint32_t i = 0; i < b->size / 4; i++) {
+					gmu_wr(reg + i, b->data[i]);
+				}
+				for (uint32_t i = 0; i < b->size / 4; i++) {
+					bad += gmu_rd(reg + i) != b->data[i];
+				}
+				words += b->size / 4;
+				n++;
+			}
+		}
+		p += sizeof(struct blk) + b->size;
+	}
+	IOLog("VGPU: TCM: %u blocks, %u words written, %u differ on read back; ITCM[0] %08x DTCM[0xff8] %08x\n",
+	    n, words, bad, gmu_rd(GMU_CM3_ITCM_START), gmu_rd(GMU_CM3_DTCM_START + 0xff8));
+}
